// Live URTI: reflections stabilised over time (like the denoisers of RT games). At
// render resolution: colour of the reflected point read from the presented image, capped (no isolated
// white points), then blended with the history reprojected by the game's motion vectors;
// the history is clamped by the current image's neighbourhood (no trails) and rejected if the
// depth no longer matches (newly uncovered point).
// Anchored history (takes precedence): the exact previous position of the reflection, found through the captured
// geometry (live_reflect); kept only if, at that place, the previous frame reflected the same object
// in the same mirror. Reliable even in motion: a lot of history is kept there.

ByteAddressBuffer image : register(t0);       // presented image (aligned rows)
ByteAddressBuffer reflection : register(t1);  // float4 per render pixel: u, v, weight, smoothness
ByteAddressBuffer history : register(t2);     // float4 per render pixel: linear colour, weight (previous frame)
ByteAddressBuffer motion : register(t3);      // the game's motion vectors (R16G16 floats)
ByteAddressBuffer depth : register(t4);       // render depth (this frame)
ByteAddressBuffer depthPrev : register(t5);   // render depth (previous frame)
ByteAddressBuffer sunBuf : register(t6);      // depth law (36 to 47), camera rotation (576 to 627)
ByteAddressBuffer anchorCur : register(t7);   // uint4 per render pixel: previous position of the reflection, identities
ByteAddressBuffer anchorPrev : register(t8);  // the same, from the previous frame
ByteAddressBuffer mixIn : register(t9);       // flags 16 (world radiance cache): reflection colour already known (rgb), share to read from the image at (u, v) (a)
RWByteAddressBuffer resolved : register(u0);  // float4 per render pixel: linear colour, weight
// float4 per render pixel: motion of the surface, motion of the reflection (uv toward the previous frame). Frames generated by DLSS-G
// (between two computations) slide the last computation's shadow and reflection by this fraction of motion (live_composite): without it,
// URTI's layer stayed frozen one present in two, then caught up with the image at once (stuttering, shifting reflection)
RWByteAddressBuffer motionOut : register(u1);

cbuffer Constants : register(b0)
{
    uint width;          // presented image
    uint height;
    uint pitch;
    uint format;         // 0 RGBA8, 1 BGRA8, 2 HDR10 PQ, 3 RGBA16F
    uint renderWidth;
    uint renderHeight;
    uint motionPitch;
    uint motionConvention; // 255: no history
    uint depthPitch;
    uint depth24;
    float alpha;         // share of the current frame at rest
    float maxLuminance;  // cap of the reflected colour (linear light, 1 = reference white)
    uint flags;          // 1: history valid; 2: generated frame (no update); 4: diagnostic, confidence;
                         // 8: anchorings of this frame and of the previous one available; 16: mixIn
    float p00;           // assumed projection (the add-on's camera space)
    float p11;
    float alphaMax;      // share of the current frame in fast motion
    float gamma;         // clamp: mean ± gamma standard deviations of the neighbourhood
    float depthTol;      // history kept if the depth differs by less than depthTol × depth
    float anchorAlpha;   // anchored history: share of the current frame (0: anchoring off)
    float anchorGamma;   // anchored history: wider clamp (mean ± anchorGamma σ)
    float softPx;        // radius (presented-image pixels) of the area where the reflected colour is read (0: a point)
    float spatialMix;    // share of the neighbours' average in a pixel's current value (0: the pixel alone)
};

float3 SrgbToLinear(float3 c) { return select(c <= 0.04045, c / 12.92, pow((c + 0.055) / 1.055, 2.4)); }
float3 PqToNits(float3 e)
{
    const float3 p = pow(saturate(e), 1.0 / 78.84375);
    return 10000.0 * pow(max(p - 0.8359375, 0.0) / (18.8515625 - 18.6875 * p), 1.0 / 0.1593017578125);
}

float3 LoadLinear(int2 px)
{
    px = clamp(px, int2(0, 0), int2(width - 1, height - 1));
    const uint a = uint(px.y) * pitch + uint(px.x) * (format == 3 ? 8 : 4);
    if (format == 3)
    {
        const uint2 raw = image.Load2(a);
        return float3(f16tof32(raw.x & 0xFFFF), f16tof32(raw.x >> 16), f16tof32(raw.y & 0xFFFF));
    }
    const uint raw = image.Load(a);
    if (format == 2)
        return PqToNits(float3(raw & 1023, (raw >> 10) & 1023, (raw >> 20) & 1023) / 1023.0) / 203.0;
    const float3 c = float3(raw & 255, (raw >> 8) & 255, (raw >> 16) & 255) / 255.0;
    return SrgbToLinear(format == 1 ? c.bgr : c);
}

float3 SampleLinear(float2 uv);

// reflected colour read over a small area (rotated grid of four reads): a perfect mirror read at a single point fell, with each frame's
// sub-pixel jitter, sometimes on a thin branch and sometimes next to it (the reflection of thin objects flickered); real water is never a
// mirror to the pixel
// distance of the reflected point and blur radius of a glossy reflection (live_reflect: w = distance + 20,000 × radius in render pixels)
float HitDist(float w) { return w >= 2e4 ? w - 2e4 * floor(w / 2e4) : w; }
float GlossPx(float w) { return w >= 2e4 ? floor(w / 2e4) : 0.0; }

// blurred read of a glossy reflection: eight reads on a disk (Vogel spiral), rotated per pixel (temporal smoothing and the neighbours'
// average erase the pattern); radius in presented-image pixels
float3 SampleDisk(float2 uv, float radius, int2 at)
{
    const float2 px = radius / float2(width, height);
    const float rot = 6.2831853 * frac(52.9829189 * frac(dot(float2(at), float2(0.06711056, 0.00583715))));
    float3 sum = 0;
    for (uint k = 0; k < 8; k++)
    {
        const float r = sqrt((float(k) + 0.5) / 8.0), a = float(k) * 2.3999632 + rot;
        sum += SampleLinear(uv + float2(cos(a), sin(a)) * r * px);
    }
    return sum / 8.0;
}

float3 SampleSoft(float2 uv)
{
    if (softPx <= 0)
        return SampleLinear(uv);
    const float2 px = softPx / float2(width, height);
    return 0.25 * (SampleLinear(uv + float2(0.5, 1.0) * px) + SampleLinear(uv + float2(-1.0, 0.5) * px) +
                   SampleLinear(uv + float2(-0.5, -1.0) * px) + SampleLinear(uv + float2(1.0, -0.5) * px));
}

float3 SampleLinear(float2 uv)
{
    const float2 q = uv * float2(width, height) - 0.5;
    const int2 b = int2(floor(q));
    const float2 f = q - b;
    return lerp(lerp(LoadLinear(b), LoadLinear(b + int2(1, 0)), f.x), lerp(LoadLinear(b + int2(0, 1)), LoadLinear(b + int2(1, 1)), f.x), f.y);
}

// the game's sub-pixel jitter (DLSS / TAA), measured by live_sunvote in URTI's camera space
// (shear x' = x + a w, y' = y + b w): in render pixels, a pixel's content is that of the point
// at "pixel - jitter"; frame-to-frame difference (previous - current) at 628, absolute at 1184
float2 JitterPixels(float2 ab, float p00_, float p11_, float2 size) { return float2(ab.x * p00_, -ab.y * p11_) * 0.5 * size; }
static float2 gJitterUv; // this frame's absolute jitter, in uv (the reflected point projected into the jittered space)

// current reflection of a render pixel: capped colour × weight, weight; known = false if the surface
// reflects but the reflected point is hidden or off screen (missing data, not a zero)
static const float kSkipped = -0.25; // live_reflect: reflecting pixel without a ray this frame (time budget)
static bool gCenterSkipped = false;  // this pixel received no ray this frame: mostly its (clamped) history, the neighbours' average only corrects it
static float gSkippedHitT = -1.0;   // reflection distance of a skipped pixel, from its neighbours

// u < -0.5: surface-cache colour (reflected point hidden or off screen); otherwise read from the image (the presented image is not jittered: TAA)
float3 RayColor(float4 rf, int2 at)
{
    if (flags & 16)
    {
        const float4 m = asfloat(mixIn.Load4((uint(at.y) * renderWidth + uint(at.x)) * 16));
        if (m.a <= 0)
            return m.rgb;
        const float g = GlossPx(rf.w) * float(width) / float(renderWidth);
        return m.rgb + m.a * (g > softPx * 1.5 ? SampleDisk(rf.xy - gJitterUv, g, at) : SampleSoft(rf.xy - gJitterUv));
    }
    if (rf.x < -0.5)
        return float3(-rf.x - 1.0, rf.y, rf.w);
    const float g = GlossPx(rf.w) * float(width) / float(renderWidth);
    return g > softPx * 1.5 ? SampleDisk(rf.xy - gJitterUv, g, at) : SampleSoft(rf.xy - gJitterUv);
}

float4 Current(int2 t, out bool known, bool center)
{
    t = clamp(t, int2(0, 0), int2(renderWidth - 1, renderHeight - 1));
    const float4 rf = asfloat(reflection.Load4((uint(t.y) * renderWidth + uint(t.x)) * 16));
    known = rf.z >= 0;
    if (rf.z <= 0)
        return float4(0, 0, 0, 0);
    float3 c;
    if (rf.x == kSkipped)
    {
        // no ray here this frame: as a neighbour for the statistics, ignored; for the pixel itself, the average of the neighbours that got one
        if (!center)
        {
            known = false;
            return float4(0, 0, 0, 0);
        }
        float3 sum = 0;
        float n = 0, hit = 0, hn = 0;
        for (int dy = -1; dy <= 1; dy++)
            for (int dx = -1; dx <= 1; dx++)
            {
                const int2 q = clamp(t + int2(dx, dy), int2(0, 0), int2(renderWidth - 1, renderHeight - 1));
                const float4 rn = asfloat(reflection.Load4((uint(q.y) * renderWidth + uint(q.x)) * 16));
                if (rn.z > 0 && rn.x != kSkipped)
                {
                    sum += RayColor(rn, q), n += 1;
                    if (rn.x >= -0.5)
                        hit += HitDist(rn.w), hn += 1;
                }
            }
        if (n == 0)
        {
            known = false;
            return float4(0, 0, 0, 0);
        }
        c = sum / n;
        gCenterSkipped = true;
        gSkippedHitT = hn > 0 ? hit / hn : 20.0;
    }
    else
        c = RayColor(rf, t);
    const float lum = dot(c, float3(0.2126, 0.7152, 0.0722));
    if (lum > maxLuminance)
        c *= maxLuminance / lum;
    return float4(c * rf.z, rf.z);
}

// hidden reflection: share of the history kept every frame (0.9: half after 7 frames)
static const float holdDecay = 0.9;

// the game's motion vector in uv (toward the previous frame), 0 if it cannot be read
float2 GameMotionUv(uint2 id)
{
    if (motionConvention >= 16)
        return 0;
    const uint raw = motion.Load(id.y * motionPitch + id.x * 4);
    float2 mv = float2(f16tof32(raw & 0xFFFF), f16tof32(raw >> 16));
    const uint k = motionConvention;
    mv = (k & 3) == 0 ? mv : (k & 3) == 1 ? mv * 0.5 : (k & 3) == 2 ? mv / float2(renderWidth, renderHeight) : mv * 2.0;
    if (k & 4)
        mv = -mv;
    if (k & 8)
        mv.y = -mv.y;
    return all(isfinite(mv)) && all(abs(mv) < 0.25) ? mv : 0;
}

float ViewDepth(ByteAddressBuffer b, int2 t, float A, float B)
{
    t = clamp(t, int2(0, 0), int2(renderWidth - 1, renderHeight - 1));
    const uint raw = b.Load(t.y * depthPitch + t.x * 4);
    const float d = depth24 != 0 ? float(raw & 0xFFFFFF) / 16777215.0 : asfloat(raw);
    return B / (d - A);
}

[numthreads(8, 8, 1)]
void main(uint2 id : SV_DispatchThreadID)
{
    if (id.x >= renderWidth || id.y >= renderHeight)
        return;
    const int2 t = int2(id);
    const uint dst = (id.y * renderWidth + id.x) * 16;
    gJitterUv = JitterPixels(asfloat(sunBuf.Load2(1184)), p00, p11, float2(renderWidth, renderHeight)) / float2(renderWidth, renderHeight);
    if (flags & 2)
        return; // generated frame: the result of the last real frame stays
    const float2 mvSurface = GameMotionUv(id);
    motionOut.Store4(dst, asuint(float4(mvSurface, mvSurface))); // reflection: replaced below by the motion of its virtual point

    // current (colour premultiplied by the weight) and statistics of the 3×3 neighbourhood (mean ± γ σ), over the
    // pixels whose reflection is known. Reflection expected but reflected point hidden (glass, foliage, screen
    // edge): the history is kept and fades gently instead of dropping to zero from one frame to
    // the next (that was the "popping": visible, hidden, visible…)
    bool known;
    float4 cur = Current(t, known, true);
    // no reflection here (not water): nothing, never any history. Read off-target in motion, it laid a neighbouring water pixel's reflection on the grass and
    // the objects' edges, and let it fade there slowly (sparkles that stay on screen)
    if (known && cur.a <= 0 && (flags & 4) == 0)
    {
        resolved.Store4(dst, asuint(float4(0, 0, 0, 0)));
        return;
    }
    float4 m1 = 0, m2 = 0;
    float count = 0;
    for (int dy = -1; dy <= 1; dy++)
        for (int dx = -1; dx <= 1; dx++)
        {
            bool nk = known;
            const float4 n = (dx == 0 && dy == 0) ? cur : Current(t + int2(dx, dy), nk, false);
            if (nk && n.a > 0) // (only pixels that have a reflection: a water's edge is not pulled toward black)
                m1 += n, m2 += n * n, count += 1;
        }
    const float4 mean = count > 0 ? m1 / count : 0, sigma = count > 0 ? sqrt(max(m2 / count - mean * mean, 0.0)) : 0;
    const float4 lo = count > 0 ? mean - gamma * sigma : -1e9, hi = count > 0 ? mean + gamma * sigma : 1e9;
    // spatial pre-filter (like NVIDIA's reflection denoisers before their accumulation): the current value blends the pixel and the average of its
    // reflecting neighbours; an isolated pixel no longer lights up at every computation
    if (known && count >= 4 && cur.a > 0)
        cur = lerp(cur, mean, spatialMix);

    float4 result = cur;
    bool done = false;
    if ((flags & 8) && anchorAlpha > 0)
    {
        const uint4 a = anchorCur.Load4(dst);
        const float2 pu = asfloat(a.xy);
        if (a.z != 0 && a.w != 0 && all(isfinite(pu)) && all(pu > 0) && all(pu < 1))
        {
            // bilinear over the four neighbouring pixels, each kept only if it reflected the same object
            // in the same mirror
            const float2 q = pu * float2(renderWidth, renderHeight) - 0.5;
            const int2 b = int2(floor(q));
            const float2 f = q - b;
            float4 hist = 0;
            float hw = 0;
            for (int j = 0; j < 4; j++)
            {
                const int2 s = clamp(b + int2(j & 1, j >> 1), int2(0, 0), int2(renderWidth - 1, renderHeight - 1));
                const uint o = (uint(s.y) * renderWidth + uint(s.x)) * 16;
                const uint4 pa = anchorPrev.Load4(o);
                const float bw = ((j & 1) ? f.x : 1 - f.x) * ((j >> 1) ? f.y : 1 - f.y);
                if (pa.z == a.z && pa.w == a.w)
                    hist += asfloat(history.Load4(o)) * bw, hw += bw;
            }
            if (hw > 0.25)
            {
                hist /= hw;
                const float4 alo = count > 0 ? mean - anchorGamma * sigma : -1e9, ahi = count > 0 ? mean + anchorGamma * sigma : 1e9;
                result = known ? lerp(clamp(hist, alo, ahi), cur, anchorAlpha) : clamp(hist, alo, ahi) * holdDecay;
                done = true;
                if (flags & 4)
                {
                    resolved.Store4(dst, asuint(float4(0, 1, 0, 1))); // diagnostic: green = anchored history
                    return;
                }
            }
        }
    }
    if (!done && (flags & 1) && motionConvention < 16)
    {
        const float3 law = asfloat(sunBuf.Load3(36));
        const uint raw = motion.Load(id.y * motionPitch + id.x * 4);
        float2 mv = float2(f16tof32(raw & 0xFFFF), f16tof32(raw >> 16));
        const uint k = motionConvention;
        mv = (k & 3) == 0 ? mv : (k & 3) == 1 ? mv * 0.5 : (k & 3) == 2 ? mv / float2(renderWidth, renderHeight) : mv * 2.0;
        if (k & 4)
            mv = -mv;
        if (k & 8)
            mv.y = -mv.y;
        const float2 uv = (float2(id) + 0.5) / float2(renderWidth, renderHeight);
        const float w = ViewDepth(depth, t, law.x, law.y);
        // the reflection does not move like the surface carrying it: its virtual point (behind the mirror, at the
        // ray's distance) moves like a still point at that depth. Motion = the part due to the
        // camera's rotation (measured through the cascades, the same at every depth) + the part due to the
        // translation, which decreases as 1 / depth.
        float2 mvRot = mv;
        if (asfloat(sunBuf.Load(624)) > 0 && w > 0)
        {
            const float2 ndc = float2(uv.x * 2 - 1, 1 - uv.y * 2);
            const float3 pc = float3(ndc.x * w / p00, ndc.y * w / p11, w);
            const float3 pr = float3(dot(asfloat(sunBuf.Load3(576)), pc), dot(asfloat(sunBuf.Load3(592)), pc), dot(asfloat(sunBuf.Load3(608)), pc));
            if (pr.z > 1e-3)
                mvRot = float2(pr.x * p00 / pr.z * 0.5 + 0.5, 0.5 - pr.y * p11 / pr.z * 0.5) - uv;
        }
        const float hitT = gSkippedHitT >= 0 ? gSkippedHitT : HitDist(asfloat(reflection.Load((id.y * renderWidth + id.x) * 16 + 12)));
        const float2 ndc0 = float2(uv.x * 2 - 1, 1 - uv.y * 2);
        const float dist = w > 0 ? length(float3(ndc0.x * w / p00, ndc0.y * w / p11, w)) : 1;
        const float ratio = hitT >= 1e4 ? 0.0 : dist / (dist + max(hitT, 0.0));
        const float2 mvVirtual = mvRot + (mv - mvRot) * ratio;
        if (all(isfinite(mvVirtual)) && all(abs(mvVirtual) < 0.25))
            motionOut.Store2(dst + 8, asuint(mvVirtual));
        const float2 prevUv = uv + mvVirtual + JitterPixels(asfloat(sunBuf.Load2(628)), p00, p11, float2(renderWidth, renderHeight)) / float2(renderWidth, renderHeight);
        if (law.z > 0 && all(isfinite(mvVirtual)) && all(prevUv > 0) && all(prevUv < 1) && w > 0)
        {
            const int2 p = int2(prevUv * float2(renderWidth, renderHeight));
            const float wp = ViewDepth(depthPrev, p, law.x, law.y);
            if (wp > 0 && abs(wp - w) < depthTol * w + 0.2)
            {
                const float4 hist = asfloat(history.Load4((uint(p.y) * renderWidth + uint(p.x)) * 16));
                // history clamped by the current neighbourhood (a reflection that moved leaves no trace);
                // adaptive blend: a lot of history at rest, little in fast motion
                const float motionPx = length(mvVirtual * float2(renderWidth, renderHeight));
                // pixel without a ray this frame (one in two, in turn): its history alone, it got a real ray the frame before. The average
                // of its neighbours, blended every other frame, made thin objects in the reflection flicker
                const float a = gCenterSkipped ? 0.0 : lerp(alpha, alphaMax, saturate(motionPx / 8.0));
                const float4 kept = clamp(hist, lo, hi);
                // weight by brightness (like temporal anti-aliasing): a very bright point (particle, firefly read from the image) does not mark
                // the history; and a newly uncovered surface (history without a reflection): the reflection at once, not a fade
                const float3 kLum = float3(0.2126, 0.7152, 0.0722);
                const float wc = 1.0 / (1.0 + 10.0 * dot(cur.rgb, kLum) / max(cur.a, 1e-3)), wh = 1.0 / (1.0 + 10.0 * dot(kept.rgb, kLum) / max(kept.a, 1e-3));
                const float ak = a * wc / max(a * wc + (1.0 - a) * wh, 1e-5);
                result = !known ? kept * holdDecay : (hist.a < 0.25 * cur.a ? cur : lerp(kept, cur, ak));
                if (flags & 4)
                {
                    // confidence: share of the history kept after clamping (white: stable, black: rejected)
                    const float kept = 1.0 - saturate(length(clamp(hist, lo, hi) - hist) / max(length(hist), 1e-3));
                    resolved.Store4(dst, asuint(float4(kept.xxx, 1)));
                    return;
                }
            }
        }
    }
    if (flags & 4)
        result = float4(0, 0, 0, 1); // no history reused
    resolved.Store4(dst, asuint(result));
}
