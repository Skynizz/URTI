// Live URTI: RT shadows and reflections applied to the presented image, on every present
// (the game's frames and frames generated by DLSS / FSR, which do not go through ReShade's effects).
// The displayed image is copied into a buffer, decoded to linear light (sRGB, HDR10 PQ or scRGB);
// reflections: colour read from the image at the reflected point's position, blended according to the weight (Fresnel ×
// smoothness); shadows: darkening where the mask (render resolution, filtered) asks for it.

ByteAddressBuffer image : register(t0);      // copy of the presented image (aligned rows)
ByteAddressBuffer mask : register(t1);       // 1 lit, 0 added shadow (float, render resolution)
ByteAddressBuffer reflection : register(t2); // float4 per render pixel: u, v, weight, smoothness
ByteAddressBuffer prevMask : register(t3);   // mask of the previous real frame (generated frames, blend)
ByteAddressBuffer resolvedRefl : register(t4); // stabilised reflections (live_reflresolve): colour × weight, weight
ByteAddressBuffer preUi : register(t5);      // screen snapshot before the game's UI (bit 10 of debugReflect)
ByteAddressBuffer sunBuf : register(t6);     // the game's measured sub-pixel jitter (bytes 1184 to 1191)
ByteAddressBuffer uiCounts : register(t7);   // live_uiselect: snapshot choice + 1 (bytes 64, 68 depending on parity; 0: none)
ByteAddressBuffer bounceBuf : register(t8);  // denoised light bounce: planes R, G, B (float, pitch maskPitch, render resolution)
ByteAddressBuffer albedo : register(t9);     // the surfaces' own colour (the game's G-buffer, RGBA8 sRGB, render resolution)
ByteAddressBuffer gNormal : register(t10);   // G-buffer normal (RGBA8); alpha: character marker (RDR2)
ByteAddressBuffer motionIn : register(t11);  // live_reflresolve: motion of the surface and of the reflection (uv toward the previous frame), float4 per render pixel
ByteAddressBuffer waterBase : register(t12); // live_waterbase: smoothed colour of the water, float4 per block of 8 render pixels (colour, share of water)
ByteAddressBuffer hudState : register(t13);  // live_hudgain: lead of the last computation over this present's image (bit 12 of debugReflect)
ByteAddressBuffer ring : register(t14);      // live_delay: layers of the last three computed frames (bit 13 of debugReflect)
RWByteAddressBuffer output : register(u0);   // same layout as image
RWByteAddressBuffer uiMask : register(u1);   // 1 per UI pixel, kept from the last safe snapshot

cbuffer Constants : register(b0)
{
    uint width;
    uint height;
    uint pitch;
    uint format;        // 0 RGBA8, 1 BGRA8, 2 RGB10A2 en HDR10 (PQ), 3 RGBA16F (scRGB)
    uint maskWidth;
    uint maskHeight;
    uint maskPitch;
    float strength;     // darkening in shadow (0: nothing, 1: black)
    uint split;         // 1: left half without RT, line in the middle
    uint showMask;      // 1: shadow mask only
    float reflStrength; // 0: no RT reflections
    uint debugReflect;  // 1 material smoothness, 2 reflection weight, 3 reflected colour only; bit 8: blend with prevMask;
                        // bit 9: stabilised reflections available (resolvedRefl); bit 10: snapshot before the UI (preUi)
    float p00;          // assumed projection (sub-pixel jitter in render pixels)
    float p11;
    float tintR;        // sun / sky ratio of each channel over the luminance's (live_sunlight): 1 without a measurement
    float tintG;        // (three numbers: a float3 here would be moved to the next 16-byte boundary)
    float tintB;
    uint uiParity;      // frame parity (live_uiselect's choice cell)
    // fixed UI zone (fractions of the screen; empty if x1 <= x0), never touched. Four numbers: a float4
    // here would be moved to the next 16-byte boundary, further than what the add-on writes
    float uiX0;
    float uiY0;
    float uiX1;
    float uiY1;
    float giStrength;   // light bounce added (0: off)
    uint albedoPitch;
    uint normalPitch;   // 0: G-buffer normal absent
    float fgShift;      // frame generated by DLSS-G: share of one frame's motion by which the last computation's shadow and reflection slide (0: none)
    uint waterBaseSize; // size in blocks of waterBase (width | height << 16), 0: none
    float waterBaseOn;  // how much the smoothed water colour replaces the game's where the reflection matters
    float waterGain;    // weight of URTI's reflection on the water, relative to Fresnel alone (the game's own reflection is much stronger than Fresnel)
};

// the game's sub-pixel jitter (DLSS / TAA), measured by live_sunvote in URTI's camera space
// (shear x' = x + a w, y' = y + b w): in render pixels, a pixel's content is that of the point
// at "pixel - jitter"; frame-to-frame difference (previous - current) at 628, absolute at 1184
float2 JitterPixels(float2 ab, float p00_, float p11_, float2 size) { return float2(ab.x * p00_, -ab.y * p11_) * 0.5 * size; }


float3 SrgbToLinear(float3 c) { return select(c <= 0.04045, c / 12.92, pow((c + 0.055) / 1.055, 2.4)); }
float3 LinearToSrgb(float3 c) { return select(c <= 0.0031308, c * 12.92, 1.055 * pow(c, 1.0 / 2.4) - 0.055); }
float3 PqToNits(float3 e)
{
    const float3 p = pow(saturate(e), 1.0 / 78.84375);
    return 10000.0 * pow(max(p - 0.8359375, 0.0) / (18.8515625 - 18.6875 * p), 1.0 / 0.1593017578125);
}
float3 NitsToPq(float3 l)
{
    const float3 y = pow(saturate(l / 10000.0), 0.1593017578125);
    return pow((0.8359375 + 18.8515625 * y) / (1.0 + 18.6875 * y), 78.84375);
}

uint Address(int2 px) { return uint(px.y) * pitch + uint(px.x) * (format == 3 ? 8 : 4); }

// UI pixel: clearly different from the snapshot before the UI. In RDR2, the game retouches the whole
// image after the snapshot (grain or dithering, by a level or two): an exact comparison took 10 to
// 30 % of the scene's pixels for UI (URTI put nothing there: points without effect, frozen on screen)
bool IsUi(uint a)
{
    if (format == 3)
    {
        const uint2 x = image.Load2(a), y = preUi.Load2(a);
        const float3 cx = float3(f16tof32(x.x & 0xFFFF), f16tof32(x.x >> 16), f16tof32(x.y & 0xFFFF));
        const float3 cy = float3(f16tof32(y.x & 0xFFFF), f16tof32(y.x >> 16), f16tof32(y.y & 0xFFFF));
        return any(abs(cx - cy) > 0.03 * max(abs(cx), abs(cy)) + 0.002);
    }
    const uint x = image.Load(a), y = preUi.Load(a);
    if (format == 2)
        return any(abs(int3(x & 1023, (x >> 10) & 1023, (x >> 20) & 1023) - int3(y & 1023, (y >> 10) & 1023, (y >> 20) & 1023)) > 12);
    return any(abs(int3(x & 255, (x >> 8) & 255, (x >> 16) & 255) - int3(y & 255, (y >> 8) & 255, (y >> 16) & 255)) > 3);
}

// colours read from the snapshot before the UI when it exists (reflections do not pick up menus there)
static bool gPre = false;

// linear light (HDR10: nits / 203, reference white at 1)
float3 LoadLinear(int2 px)
{
    px = clamp(px, int2(0, 0), int2(width - 1, height - 1));
    const uint a = Address(px);
    if (format == 3)
    {
        const uint2 raw = gPre ? preUi.Load2(a) : image.Load2(a);
        return float3(f16tof32(raw.x & 0xFFFF), f16tof32(raw.x >> 16), f16tof32(raw.y & 0xFFFF));
    }
    const uint raw = gPre ? preUi.Load(a) : image.Load(a);
    if (format == 2)
        return PqToNits(float3(raw & 1023, (raw >> 10) & 1023, (raw >> 20) & 1023) / 1023.0) / 203.0;
    const float3 c = float3(raw & 255, (raw >> 8) & 255, (raw >> 16) & 255) / 255.0;
    return SrgbToLinear(format == 1 ? c.bgr : c);
}

void StoreLinear(int2 px, float3 c)
{
    const uint a = Address(px);
    if (format == 3)
    {
        const uint keep = image.Load2(a).y & 0xFFFF0000;
        output.Store2(a, uint2(f32tof16(c.r) | (f32tof16(c.g) << 16), f32tof16(c.b) | keep));
        return;
    }
    const uint keep = image.Load(a);
    if (format == 2)
    {
        const uint3 q = uint3(round(saturate(NitsToPq(max(c, 0.0) * 203.0)) * 1023.0));
        output.Store(a, q.x | (q.y << 10) | (q.z << 20) | (keep & 0xC0000000));
        return;
    }
    float3 e = LinearToSrgb(saturate(c));
    if (format == 1)
        e = e.bgr;
    const uint3 q = uint3(round(e * 255.0));
    output.Store(a, q.x | (q.y << 8) | (q.z << 16) | (keep & 0xFF000000));
}

// layer queue: slice chosen for this present (the one of the game frame it shows)
static bool gRing = false;
static uint gRingBase = 0;

float4 RingUnpack(uint2 v) { return float4(f16tof32(v.x & 0xFFFF), f16tof32(v.x >> 16), f16tof32(v.y & 0xFFFF), f16tof32(v.y >> 16)); }
uint RingAt(int2 t) { return gRingBase + (uint(t.y) * maskWidth + uint(t.x)) * 20; }
float4 MotionAt(int2 t) { return gRing ? RingUnpack(ring.Load2(RingAt(t) + 12)) : asfloat(motionIn.Load4((uint(t.y) * maskWidth + uint(t.x)) * 16)); }
float4 ResolvedAt(int2 t) { return gRing ? RingUnpack(ring.Load2(RingAt(t) + 4)) : asfloat(resolvedRefl.Load4((uint(t.y) * maskWidth + uint(t.x)) * 16)); }

float MaskAt(int2 t)
{
    t = clamp(t, int2(0, 0), int2(maskWidth - 1, maskHeight - 1));
    if (gRing)
        return f16tof32(ring.Load(RingAt(t)) & 0xFFFF);
    const float m = asfloat(mask.Load(t.y * maskPitch + t.x * 4));
    // generated frame (halfway between two real frames): average of the last two masks
    return (debugReflect & 0x100) ? 0.5 * (m + asfloat(prevMask.Load(t.y * maskPitch + t.x * 4))) : m;
}

// view 11 (alignment): distance of the computation's depth, bound in place of the normal
float AlignW(int2 t, float2 law)
{
    t = clamp(t, int2(0, 0), int2(maskWidth - 1, maskHeight - 1));
    const float d = float(gNormal.Load(t.y * normalPitch + t.x * 4) & 0xFFFFFF) / 16777215.0;
    return law.y / (d - law.x);
}

// bilinear colour of the image at a position (0..1)
float3 SampleLinear(float2 uv)
{
    const float2 q = uv * float2(width, height) - 0.5;
    const int2 b = int2(floor(q));
    const float2 f = q - b;
    return lerp(lerp(LoadLinear(b), LoadLinear(b + int2(1, 0)), f.x), lerp(LoadLinear(b + int2(0, 1)), LoadLinear(b + int2(1, 1)), f.x), f.y);
}

[numthreads(8, 8, 1)]
void main(uint2 id : SV_DispatchThreadID)
{
    if (id.x >= width || id.y >= height)
        return;
    const int2 px = int2(id);
    float uiSoft = 0; // UI share of the pixel (edge of a HUD element, translucent element): the effect applies that much less there
    // fixed UI zone (urti.ini ui_zone=, e.g. RDR2's minimap, whose screen never receives an image
    // without UI): left as it is
    if (uiX1 > uiX0 && all(float2(id) >= float2(uiX0, uiY0) * float2(width, height)) && all(float2(id) < float2(uiX1, uiY1) * float2(width, height)))
    {
        const uint a = Address(px);
        if (format == 3)
            output.Store2(a, image.Load2(a));
        else
            output.Store(a, image.Load(a));
        return;
    }
    // the game's UI (pixel different from the snapshot before the UI): left as it is, with no shadow
    // or reflection on top
    if (debugReflect & 0x400)
    {
        const uint a = Address(px);
        // snapshot of this frame safe: the UI is what differs from it (kept); stale snapshot (taken before
        // the game writes its image): the UI kept from the last safe snapshot (it moves little), and the image
        // itself, not the snapshot (which is from before)
        const bool photoOk = uiCounts.Load(64 + uiParity * 4) != 0;
        const uint m = (id.y * width + id.x) * 4;
        bool isUi;
        if (photoOk)
        {
            isUi = IsUi(a);
            uiMask.Store(m, isUi ? 1u : 0u);
        }
        else
        {
            // (live_hudless: UI share in bits 8 to 15; otherwise bit 0 alone)
            const uint mv = uiMask.Load(m);
            const uint a8 = (mv >> 8) & 255;
            uiSoft = a8 != 0 ? float(a8) / 255.0 : float(mv & 1);
            isUi = uiSoft >= 0.98;
        }
        if ((debugReflect & 0xFF) == 8)
        {
            // diagnostic: the UI-free image as it is put back into the screen's layout (to compare with the final image)
            gPre = true;
            StoreLinear(px, LoadLinear(px));
            return;
        }
        if ((debugReflect & 0xFF) == 7)
        {
            // diagnostic: UI share in red, alpha of the UI-free image in green
            StoreLinear(px, float3(isUi ? 1.0 : uiSoft, float((uiMask.Load(m) >> 16) & 255) / 255.0, 0));
            return;
        }
        if (isUi)
        {
            if (format == 3)
                output.Store2(a, image.Load2(a));
            else
                output.Store(a, image.Load(a));
            return;
        }
        gPre = photoOk;
    }
    if (split != 0 && id.x == width / 2)
    {
        StoreLinear(px, float3(1, 1, 1));
        return;
    }
    float3 c = LoadLinear(px);
    const float3 cGame = c;
    if (split != 0 && id.x < width / 2)
    {
        StoreLinear(px, c);
        return;
    }

    // shadow mask: bilinear at render resolution, softened by a tent (less hard edges)
    // mask and reflections computed on the game's jittered depth; the presented image is not (TAA):
    // the point seen at (id) is in the mask at (id) + jitter
    float2 jitterAb = asfloat(sunBuf.Load2(1184));
    float shiftPart = (debugReflect & 0x1000) ? -asfloat(hudState.Load(16 + 256 * 4 + 44)) : fgShift;
    if (debugReflect & 0x2000)
    {
        // the layer of the game frame this present shows: target number = the last computation's - its lead; the closest slice,
        // and only the remainder (half a frame at most, frames made by DLSS-G) caught up along the motion
        const float lead = asfloat(hudState.Load(16 + 256 * 4 + 44));
        const uint layer = hudState.Load(16 + 256 * 4 + 48);
        float best = 1e9;
        for (uint s = 0; s < 3; s++)
        {
            const uint4 h = ring.Load4(s * 16);
            const float d = float(int(h.x - layer)) + lead;
            if (h.w != 0 && abs(d) < abs(best))
                best = d, gRingBase = 64 + s * (maskWidth * maskHeight * 20), jitterAb = asfloat(h.yz);
        }
        if (abs(best) < 5.0) // (up to four frames apart: catch-up layers discarded after a hitch)
            gRing = true, shiftPart = -best;
        else
            jitterAb = asfloat(sunBuf.Load2(1184));
    }
    const float2 jitter = JitterPixels(jitterAb, p00, p11, float2(maskWidth, maskHeight));
    // generated frame: the image has moved on since the last computation; the point seen here was, at the computation, at "here + share × motion" (toward
    // the previous frame): the surface for the shadow, the virtual point behind the mirror for the reflection
    // Image lagging behind the computation (DLSS-G: the game is one to two frames ahead of the screen, measured by live_hudless): the point seen here is, in
    // the layer, at "here - lead × motion"
    float2 shiftS = 0, shiftV = 0;
    if (shiftPart != 0)
    {
        const float2 mq = (float2(id) + 0.5) / float2(width, height) * float2(maskWidth, maskHeight);
        const int2 mp = clamp(int2(mq), int2(0, 0), int2(maskWidth - 1, maskHeight - 1));
        float4 mo = MotionAt(mp);
        if (all(isfinite(mo)) && all(abs(mo) < 0.25))
        {
            // (the motion is the layer's: read again where the point is in it)
            const int2 m2 = clamp(int2(mq + mo.xy * shiftPart * float2(maskWidth, maskHeight)), int2(0, 0), int2(maskWidth - 1, maskHeight - 1));
            const float4 mo2 = MotionAt(m2);
            if (all(isfinite(mo2)) && all(abs(mo2) < 0.25))
                mo = mo2;
            shiftS = mo.xy * shiftPart * float2(maskWidth, maskHeight), shiftV = mo.zw * shiftPart * float2(maskWidth, maskHeight);
            // the point was not on screen at the time of the computation (edge, moving forward or turning): layer laid as it is, not stretched from the edge
            const float2 lim = float2(maskWidth, maskHeight) - 1.0;
            if (any(mq + shiftS < 0.0) || any(mq + shiftS > lim))
                shiftS = 0;
            if (any(mq + shiftV < 0.0) || any(mq + shiftV > lim))
                shiftV = 0;
        }
    }
    const float2 m = (float2(id) + 0.5) / float2(width, height) * float2(maskWidth, maskHeight) - 0.5 + jitter + shiftS;
    const int2 b = int2(floor(m));
    const float2 f = m - b;
    float lit = 0, wsum = 0;
    if (debugReflect & 0x800)
    {
        // occlusion only (soft): bilinear, four reads instead of sixteen
        lit = lerp(lerp(MaskAt(b), MaskAt(b + int2(1, 0)), f.x), lerp(MaskAt(b + int2(0, 1)), MaskAt(b + int2(1, 1)), f.x), f.y);
    }
    else
    {
        for (int dy = -1; dy <= 2; dy++)
            for (int dx = -1; dx <= 2; dx++)
            {
                const float wx = max(0.0, 1.5 - abs(dx - f.x)), wy = max(0.0, 1.5 - abs(dy - f.y));
                lit += MaskAt(b + int2(dx, dy)) * wx * wy;
                wsum += wx * wy;
            }
        lit /= wsum;
    }

    // reflection: matching render pixel
    // (read only if reflections are on: otherwise the bound buffer does not have that size, and a read
    // outside a root buffer brings the GPU down)
    float4 rf = float4(0, 0, 0, 0);
    if (reflStrength > 0 || (debugReflect & 0xFF) != 0)
    {
        const int2 rp = clamp(int2((float2(id) + 0.5) / float2(width, height) * float2(maskWidth, maskHeight) + jitter + shiftV), int2(0, 0), int2(maskWidth - 1, maskHeight - 1));
        rf = asfloat(reflection.Load4((uint(rp.y) * maskWidth + uint(rp.x)) * 16));
    }
    if ((debugReflect & 0xFF) == 1)
    {
        StoreLinear(px, rf.www);
        return;
    }
    if ((debugReflect & 0xFF) == 2)
    {
        // grey: reflection weight; red: mirror surface whose reflected point is hidden or off screen
        StoreLinear(px, rf.z >= 0 ? rf.zzz : float3(-rf.z, 0, 0));
        return;
    }
    if ((debugReflect & 0xFF) == 6)
    {
        // alignment: in red the edges of the computation's depth, read like the mask; in green and blue the game's image.
        // On a real-pace capture, the gap between the two tells how far the effect is shifted from the image
        const float2 law = asfloat(sunBuf.Load2(36));
        const int2 mp = int2(round(m));
        const float wc = AlignW(mp, law);
        const float edge = abs(AlignW(mp + int2(1, 0), law) - wc) > 0.25 * abs(wc) + 0.3 ? 1.0 : 0.0; // (sharp silhouettes only: vertical edges)
        const float l = saturate(sqrt(max(dot(c, float3(0.33, 0.34, 0.33)), 0.0)) * 0.8);
        StoreLinear(px, float3(edge, l, l));
        return;
    }
    if (showMask != 0)
    {
        StoreLinear(px, lit.xxx);
        return;
    }
    // the shadow removes only the direct light that lights the surface: it is applied before the reflection, which
    // partly replaces it (a puddle in shadow still reflects the sky and lit objects). The mask
    // gives the share a of the luminance that comes from the sun (a = x / (1 + x), x = sun / sky × N·L); per
    // channel, x is multiplied by the measured tint: the sun is warmer than the sky, the shadow turns blue
    const float sunPart = min(strength * (1.0 - lit), 0.98);
    const float3 x = sunPart / (1.0 - sunPart) * float3(tintR, tintG, tintB);
    c *= 1.0 - x / (1.0 + x);
    // light bounce: the light that nearby surfaces send back (live_shadow, denoised), received by this point
    // according to its own colour (diffuse: albedo × mean light received)
    if (giStrength > 0)
    {
        const uint plane = maskPitch * maskHeight;
        float3 gi = 0;
        for (int j = 0; j < 4; j++)
        {
            const int2 t = clamp(b + int2(j & 1, j >> 1), int2(0, 0), int2(maskWidth - 1, maskHeight - 1));
            const uint a = t.y * maskPitch + t.x * 4;
            gi += float3(asfloat(bounceBuf.Load(a)), asfloat(bounceBuf.Load(plane + a)), asfloat(bounceBuf.Load(2 * plane + a))) *
                  (((j & 1) ? f.x : 1 - f.x) * ((j >> 1) ? f.y : 1 - f.y));
        }
        const int2 ta = clamp(int2(round(m)), int2(0, 0), int2(maskWidth - 1, maskHeight - 1));
        const uint ra = albedo.Load(ta.y * albedoPitch + ta.x * 4);
        const float3 alb = SrgbToLinear(float3(ra & 255, (ra >> 8) & 255, (ra >> 16) & 255) / 255.0);
        // characters (alpha of the G-buffer normal): no bounce, it shook on them (they move: history rejected)
        const float person = normalPitch ? float(gNormal.Load(ta.y * normalPitch + ta.x * 4) >> 24) / 255.0 : 0.0;
        const float3 added = alb * max(gi, 0.0) * giStrength * (1.0 - saturate(person * 4.0));
        if ((debugReflect & 0xFF) == 5)
        {
            StoreLinear(px, added * 4.0); // diagnostic: bounce alone, brightened
            return;
        }
        c += added;
    }
    if (reflStrength > 0 && (debugReflect & 0x200))
    {
        // stabilised reflection, bilinear at render resolution (colour premultiplied by its weight)
        const float2 q = (float2(id) + 0.5) / float2(width, height) * float2(maskWidth, maskHeight) - 0.5 + jitter + shiftV;
        const int2 b0 = int2(floor(q));
        const float2 f0 = q - b0;
        float4 r = 0;
        for (int j = 0; j < 4; j++)
        {
            const int2 t = clamp(b0 + int2(j & 1, j >> 1), int2(0, 0), int2(maskWidth - 1, maskHeight - 1));
            r += ResolvedAt(t) * (((j & 1) ? f0.x : 1 - f0.x) * ((j >> 1) ? f0.y : 1 - f0.y));
        }
        if ((debugReflect & 0xFF) == 3)
        {
            StoreLinear(px, r.rgb);
            return;
        }
        if ((debugReflect & 0xFF) == 4)
        {
            StoreLinear(px, saturate(r.a * reflStrength).xxx); // diagnostic: share of the RT reflection actually applied
            return;
        }
        const float a = saturate(r.a * reflStrength);
        float gain = 1.0;
        // the game's own low-resolution reflection is in c: where URTI's reflection matters, its blocks are replaced by the smoothed colour of the water
        if (waterBaseOn > 0 && waterBaseSize != 0 && r.a > 0)
        {
            const uint lw = waterBaseSize & 0xFFFF, lh = waterBaseSize >> 16;
            const float2 qw = (float2(id) + 0.5) / float2(width, height) * float2(maskWidth, maskHeight) / 8.0 - 0.5;
            const int2 bw = int2(floor(qw));
            const float2 fw = qw - bw;
            float3 wb = 0;
            float wn = 0;
            for (int j = 0; j < 4; j++)
            {
                const int2 t = clamp(bw + int2(j & 1, j >> 1), int2(0, 0), int2(lw - 1, lh - 1));
                const float4 v = asfloat(waterBase.Load4((uint(t.y) * lw + uint(t.x)) * 16));
                const float g = ((j & 1) ? fw.x : 1 - fw.x) * ((j >> 1) ? fw.y : 1 - fw.y) * v.a;
                wb += v.rgb * g, wn += g;
            }
            if (wn > 1e-4)
            {
                // (only where URTI's reflection dominates: seen from above, the game's water keeps its bottom and details)
                gain = a > 1e-4 ? min(waterGain, 0.92 / a) : 1.0;
                c = lerp(c, wb / wn, waterBaseOn * smoothstep(0.3, 0.65, a * gain));
            }
        }
        c = c * (1.0 - saturate(a * gain)) + r.rgb * saturate(reflStrength) * gain;
    }
    else if (reflStrength > 0 && rf.z > 0 && rf.x != -0.25)
    {
        const float3 reflected = rf.x < -0.5 ? float3(-rf.x - 1.0, rf.y, rf.w) : SampleLinear(rf.xy); // u < -0.5: surface cache
        if ((debugReflect & 0xFF) == 3)
        {
            StoreLinear(px, reflected * rf.z);
            return;
        }
        c = lerp(c, reflected, saturate(rf.z * reflStrength));
    }
    StoreLinear(px, uiSoft > 0 ? lerp(c, cGame, uiSoft) : c);
}
