diff --git a/Samples/Pathtracer/Shaders/KrcGuide.hlsli b/Samples/Pathtracer/Shaders/KrcGuide.hlsli
new file mode 100644
index 0000000..69e8bc7
--- /dev/null
+++ b/Samples/Pathtracer/Shaders/KrcGuide.hlsli
@@ -0,0 +1,89 @@
+/*
+ * Branche krc : premier rebond diffus guidé par les cellules du cache (KRC_GUIDE).
+ *
+ * Chaque cellule apprend la direction de la lumière qui arrive sur sa surface (moyenne pondérée par
+ * L·cos/p, de chemins déjà tirés), d'où un lobe de von Mises-Fisher : direction moyenne μ, et
+ * concentration κ tirée de la longueur r de la moyenne (approximation de Banerjee,
+ * κ ≈ r(3 − r²)/(1 − r²)). Bien plus pointu qu'une harmonique sphérique d'ordre 1, qui ne dépasse
+ * pas quatre fois la densité uniforme.
+ *
+ * Tirage : mélange défensif, α du tirage du BRDF de l'exemple, 1 − α du lobe ; poids f·cos/p_mélange
+ * (MIS à un échantillon) : sans biais, quel que soit le guide. Une source rare trouvée une fois
+ * devient une direction apprise, visée souvent avec un poids faible au lieu d'un poids énorme.
+ *
+ * Proche de Real-Time Markov Chain Path Guiding (Alber, Hanika, Dachsbacher, I3D 2025), qui garde
+ * des mélanges de vMF dans des tables de hachage ; ici un seul lobe par cellule du cache, appris
+ * par ses propres chemins.
+ */
+
+#ifndef KRC_GUIDE_HLSLI
+#define KRC_GUIDE_HLSLI
+
+#define KRC_GUIDE_BRDF_FRACTION 0.5f    // part du tirage du BRDF (défensive)
+#define KRC_GUIDE_SCALE         1024.0f // virgule fixe des sommes (atomiques entières 64 bits)
+
+struct KrcLobe
+{
+    bool valid;
+    float3 mu;
+    float kappa;
+};
+
+KrcLobe KrcGuideLobe(float4 guide)
+{
+    KrcLobe lobe;
+    lobe.valid = false;
+    lobe.mu = float3(0, 0, 1);
+    lobe.kappa = 0;
+    if (guide.w <= 1e-6f)
+        return lobe;
+    const float3 m = guide.xyz / guide.w;
+    const float r = length(m);
+    if (r < 0.05f)
+        return lobe; // lumière sans direction marquée : le BRDF suffit
+    const float rc = min(r, 0.995f);
+    lobe.valid = true;
+    lobe.mu = m / r;
+    lobe.kappa = min(rc * (3.0f - rc * rc) / (1.0f - rc * rc), 500.0f);
+    return lobe;
+}
+
+float KrcVmfPdf(KrcLobe lobe, float3 w)
+{
+    const float k = lobe.kappa;
+    return k / (2.0f * 3.14159265f * (1.0f - exp(-2.0f * k))) * exp(k * (dot(lobe.mu, w) - 1.0f));
+}
+
+float3 KrcVmfSample(KrcLobe lobe, float2 u)
+{
+    const float k = lobe.kappa;
+    const float c = 1.0f + log(u.x + (1.0f - u.x) * exp(-2.0f * k)) / k; // cos de l'angle à μ
+    const float s = sqrt(max(1.0f - c * c, 0.0f));
+    const float phi = 2.0f * 3.14159265f * u.y;
+    const float3 t = abs(lobe.mu.z) < 0.999f ? normalize(cross(lobe.mu, float3(0, 0, 1))) : float3(1, 0, 0);
+    const float3 b = cross(lobe.mu, t);
+    return normalize(c * lobe.mu + s * (cos(phi) * t + sin(phi) * b));
+}
+
+// le poids diffus de l'exemple (lambertien × (1 − Fresnel), déjà divisé par la densité du tirage en
+// cosinus) évalué dans une direction donnée ; pdfCos : cette densité
+float3 KrcDiffuseWeightAt(float3 direction, float3 shadingNormal, float3 V, MaterialSample material, float2 u, out float pdfCos)
+{
+    pdfCos = 0;
+    float4 qRotationToZ = getRotationToZAxis(shadingNormal);
+    const float3 Vlocal = rotatePoint(qRotationToZ, V);
+    const float3 Llocal = rotatePoint(qRotationToZ, direction);
+    if (Llocal.z <= 0.0f || Vlocal.z <= 0.0f)
+        return float3(0, 0, 0);
+    const BrdfData data = prepareBRDFData(float3(0, 0, 1), Llocal, Vlocal, material);
+    float3 weight = data.diffuseReflectance * diffuseTerm(data);
+#if COMBINE_BRDFS_WITH_FRESNEL
+    const float3 H = sampleSpecularHalfVector(Vlocal, float2(data.alpha, data.alpha), u);
+    const float VdotH = max(0.00001f, min(1.0f, dot(Vlocal, H)));
+    weight *= (float3(1, 1, 1) - evalFresnel(data.specularF0, shadowedF90(data.specularF0), VdotH));
+#endif
+    pdfCos = diffusePdf(data.NdotL);
+    return weight;
+}
+
+#endif // KRC_GUIDE_HLSLI
diff --git a/Samples/Pathtracer/Shaders/Pathtracer.hlsl b/Samples/Pathtracer/Shaders/Pathtracer.hlsl
index 064c91f..b554b53 100644
--- a/Samples/Pathtracer/Shaders/Pathtracer.hlsl
+++ b/Samples/Pathtracer/Shaders/Pathtracer.hlsl
@@ -93,8 +93,11 @@ RWStructuredBuffer<uint>                    u_SharcLockBuffer               : re
 RWStructuredBuffer<SharcAccumulationData>   u_SharcAccumulationBuffer       : register(u2, space3);
 RWStructuredBuffer<SharcPackedData>         u_SharcResolvedBuffer           : register(u3, space3);
 RWStructuredBuffer<float4>                  u_KrcMoments                    : register(u4, space3);
+RWStructuredBuffer<uint64_t>                u_KrcGuideAcc                   : register(u5, space3);
+RWStructuredBuffer<float4>                  u_KrcGuide                      : register(u6, space3);
 
 #include "KrcAdaptive.hlsli"
+#include "KrcGuide.hlsli"
 
 RayDesc GeneratePinholeCameraRay(float2 normalizedDeviceCoordinate, float4x4 viewToWorld, float4x4 viewToClip)
 {
@@ -451,6 +454,13 @@ void PathTraceRays()
 
         bool internalRay = false;
 
+        // branche krc : premier rebond guidé, et ce qu'il faut pour nourrir le guide en fin de chemin
+        uint krcGuideCell = 0xffffffffu;
+        float3 krcRadianceBefore = float3(0, 0, 0);
+        float3 krcThroughput1 = float3(0, 0, 0);
+        float3 krcDirection1 = float3(0, 0, 1);
+        float krcCosOverPdf1 = 0;
+
         int bounce;
         for (bounce = 0; true/* break from the middle */; bounce++)
         {
@@ -733,7 +743,50 @@ void PathTraceRays()
 
             // Generates a new ray direction
             float2 rand2 = float2(Rand(rngState), Rand(rngState));
-            if (!evalIndirectCombinedBRDF(rand2, shadingNormal, geometryNormal, viewVector, material, brdfType, refractiveIndex, ray.Direction, brdfWeight, brdfPdf))
+            bool sampledDirection;
+#if SHARC_QUERY
+            // branche krc : premier rebond diffus guidé par la cellule du point (mélange défensif, MIS)
+            if (g_Lighting.krcGuide != 0 && bounce == 0 && brdfType == DIFFUSE_TYPE)
+            {
+                KrcLobe lobe = KrcGuideLobe(float4(0, 0, 0, 0));
+                {
+                    const HashGridKey key = HashGridComputeSpatialHash(hitPosition, geometryNormal, sharcParameters.hashGridParameters);
+                    const uint baseSlot = HashGridGetBaseSlot(key, sharcParameters.hashGridData.capacity);
+                    HashGridIndex cell;
+                    uint bucketOffset;
+                    if (HashGridFind(sharcParameters.hashGridData, key, baseSlot, HASH_GRID_HASH_MAP_BUCKET_SIZE, cell, bucketOffset))
+                    {
+                        krcGuideCell = cell;
+                        lobe = KrcGuideLobe(u_KrcGuide[cell]);
+                    }
+                }
+                const float alpha = lobe.valid ? KRC_GUIDE_BRDF_FRACTION : 1.0f;
+                float pdfCos = 0;
+                if (Rand(rngState) < alpha)
+                {
+                    sampledDirection = evalIndirectCombinedBRDF(rand2, shadingNormal, geometryNormal, viewVector, material, brdfType, refractiveIndex, ray.Direction, brdfWeight, brdfPdf);
+                    pdfCos = brdfPdf;
+                }
+                else
+                {
+                    ray.Direction = KrcVmfSample(lobe, rand2);
+                    brdfWeight = KrcDiffuseWeightAt(ray.Direction, shadingNormal, viewVector, material, float2(Rand(rngState), Rand(rngState)), pdfCos);
+                    sampledDirection = pdfCos > 0 && dot(geometryNormal, ray.Direction) > 0 && luminance(brdfWeight) > 0;
+                }
+                if (sampledDirection && lobe.valid)
+                {
+                    const float pdfMix = alpha * pdfCos + (1.0f - alpha) * KrcVmfPdf(lobe, ray.Direction);
+                    brdfWeight *= pdfCos / max(pdfMix, 1e-8f);
+                    brdfPdf = pdfMix;
+                }
+                krcRadianceBefore = sampleRadiance;
+                krcDirection1 = ray.Direction;
+                krcCosOverPdf1 = max(dot(shadingNormal, ray.Direction), 0.0f) / max(brdfPdf, 1e-8f);
+            }
+            else
+#endif // SHARC_QUERY
+                sampledDirection = evalIndirectCombinedBRDF(rand2, shadingNormal, geometryNormal, viewVector, material, brdfType, refractiveIndex, ray.Direction, brdfWeight, brdfPdf);
+            if (!sampledDirection)
             {
                 NrcSetDebugPathTerminationReason(nrcPathState, NrcDebugPathTerminationReason::BRDFAbsorption);
                 break; // Ray was eaten by the surface :(
@@ -762,6 +815,8 @@ void PathTraceRays()
 
             // Account for surface properties using the BRDF "weight"
             throughput *= brdfWeight;
+            if (bounce == 0)
+                krcThroughput1 = throughput;
 
             SharcSetRadianceDirectionWeight(sharcState, (brdfType == SPECULAR_TYPE) ? saturate(1.0f - material.roughness * material.roughness) : 0.0f);
             SharcSetThroughput(sharcState, throughput);
@@ -772,6 +827,25 @@ void PathTraceRays()
 
         NrcWriteFinalPathInfo(nrcContext, nrcPathState, throughput, sampleRadiance);
 
+#if SHARC_QUERY
+        // branche krc : la lumière arrivée par le premier rebond nourrit le guide de la cellule
+        // (L·cos/p, un pixel sur quatre pour limiter les atomiques)
+        if (g_Lighting.krcGuide != 0 && krcGuideCell != 0xffffffffu &&
+            ((launchIndex.x + 3u * launchIndex.y + g_Global.frameIndex) & 3u) == 0u)
+        {
+            const float3 incoming = max(sampleRadiance - krcRadianceBefore, 0.0f) / max(krcThroughput1, float3(1e-6f, 1e-6f, 1e-6f));
+            const float w = min(luminance(incoming) * krcCosOverPdf1, 1e4f);
+            if (w > 0.0f)
+            {
+                const float4 v = float4(krcDirection1 * w, w) * KRC_GUIDE_SCALE;
+                InterlockedAdd(u_KrcGuideAcc[4u * krcGuideCell + 0u], uint64_t(int64_t(v.x)));
+                InterlockedAdd(u_KrcGuideAcc[4u * krcGuideCell + 1u], uint64_t(int64_t(v.y)));
+                InterlockedAdd(u_KrcGuideAcc[4u * krcGuideCell + 2u], uint64_t(int64_t(v.z)));
+                InterlockedAdd(u_KrcGuideAcc[4u * krcGuideCell + 3u], uint64_t(int64_t(v.w)));
+            }
+        }
+#endif // SHARC_QUERY
+
 #if !NRC_UPDATE && !SHARC_UPDATE
         UpdateSampleData(accumulatedSampleData, sampleRadiance, isDiffusePath, hitDistance);
 
diff --git a/Samples/Pathtracer/Shaders/SharcResolve.hlsl b/Samples/Pathtracer/Shaders/SharcResolve.hlsl
index c2837a8..f5fa021 100644
--- a/Samples/Pathtracer/Shaders/SharcResolve.hlsl
+++ b/Samples/Pathtracer/Shaders/SharcResolve.hlsl
@@ -22,6 +22,8 @@ RWStructuredBuffer<HashGridKey>             u_SharcHashEntriesBuffer    : regist
 RWStructuredBuffer<SharcAccumulationData>   u_SharcAccumulationBuffer   : register(u2, space3);
 RWStructuredBuffer<SharcPackedData>         u_SharcResolvedBuffer       : register(u3, space3);
 RWStructuredBuffer<float4>                  u_KrcMoments                : register(u4, space3);
+RWStructuredBuffer<uint64_t>                u_KrcGuideAcc               : register(u5, space3);
+RWStructuredBuffer<float4>                  u_KrcGuide                  : register(u6, space3);
 
 #include "KrcAdaptive.hlsli"
 
@@ -54,6 +56,19 @@ void sharcResolve(in uint2 did : SV_DispatchThreadID)
         KrcResolveWeight(did.x, sharcParameters, g_Lighting.krcTolerance, u_KrcMoments);
     }
 
+    // branche krc : guide du premier rebond, moyenne glissante des sommes de la frame
+    if (g_Lighting.krcGuide != 0 && did.x < sharcParameters.hashGridData.capacity)
+    {
+        const bool valid = BUFFER_AT_OFFSET(sharcParameters.hashGridData.hashEntriesBuffer, did.x) != HASH_GRID_INVALID_HASH_KEY;
+        float4 acc;
+        for (uint k = 0; k < 4; k++)
+        {
+            acc[k] = float(int64_t(u_KrcGuideAcc[4u * did.x + k])) / 1024.0f;
+            u_KrcGuideAcc[4u * did.x + k] = 0;
+        }
+        u_KrcGuide[did.x] = valid ? u_KrcGuide[did.x] * 0.95f + acc : float4(0, 0, 0, 0);
+    }
+
     SharcResolveEntry(did.x, sharcParameters, resolveParameters);
 }
 
