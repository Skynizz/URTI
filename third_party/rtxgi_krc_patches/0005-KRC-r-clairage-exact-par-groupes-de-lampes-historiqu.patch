diff --git a/Samples/Pathtracer/Shaders/KrcRelight.hlsli b/Samples/Pathtracer/Shaders/KrcRelight.hlsli
new file mode 100644
index 0000000..c0f9890
--- /dev/null
+++ b/Samples/Pathtracer/Shaders/KrcRelight.hlsli
@@ -0,0 +1,33 @@
+/*
+ * Branche krc : adaptation de la bibliothèque KRC (Libraries/Krc/include/KrcRelight.h, rééclairage
+ * exact par groupes de lampes) au path tracer d'exemple : tampons de l'espace de SHaRC (u7..u9) et
+ * réglages de LightingConstants.
+ */
+
+#ifndef KRC_RELIGHT_HLSLI
+#define KRC_RELIGHT_HLSLI
+
+#include "KrcRelight.h"
+
+#define KRC_RELIGHT_PARAMETERS(p)                       \
+    KrcRelightParameters p;                             \
+    p.groupAccumulationBuffer = u_KrcGroupAcc;          \
+    p.groupBuffer = u_KrcGroup;                         \
+    p.factorBuffer = u_KrcRelightFactor;                \
+    p.lightGroups = uint(g_Lighting.krcLightGroups);    \
+    p.ratio = g_Lighting.krcRelightRatio.xyz
+
+#if SHARC_QUERY
+// Confiance de l'historique de NRD (mode 1) : 1 l'historique reste bon, 0 à oublier, d'après le
+// facteur de la frame de la cellule du premier point touché. REBLUR ramène alors son historique à
+// une frame, pas à zéro : le mode 2 (normalisation par S, Denoiser.hlsl) lui est préféré.
+float KrcHistoryConfidence(in SharcParameters sharcParameters, KrcRelightParameters krcParameters, float3 position, float3 normal)
+{
+    if (g_Lighting.krcDebug == 3)
+        return 0.0f; // diagnostic : historique oublié partout
+    const float k = max(KrcGetRelightFactor(sharcParameters, krcParameters, position, normal).x, 1e-4f);
+    return exp(-8.0f * abs(log(k)));
+}
+#endif // SHARC_QUERY
+
+#endif // KRC_RELIGHT_HLSLI
