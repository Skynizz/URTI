+RWTexture2D<float>              u_KrcScale                      : register(u8, space1); // branche krc : S (KrcRelight.hlsli)
+RWTexture2D<float>              u_KrcScaleSmooth                : register(u9, space1); // branche krc : S lissé
+
+// branche krc : normalisation de l'entrée de NRD par le produit des rééclairages des cellules autour
+// du pixel (mode 2) ; la sortie est remultipliée, d'où un historique rééclairé
+float KrcNrdScale(uint2 pixel)
+{
+    return (g_Lighting.krcNrdConfidence == 2 && g_Lighting.krcRelightRatio.w != 0.0f) ? max(u_KrcScaleSmooth[pixel], 1e-4f) : 1.0f;
+}
+
+// S est constant par cellule : appliqué tel quel, il dessinerait les cellules dans l'image. Lissage
+// épars (9 × 9 prises espacées de 4 pixels), en logarithme, arrêté aux arêtes (normale, profondeur) ;
+// calculé une fois par frame pour que l'entrée et la sortie de NRD utilisent le même S.
+[numthreads(BLOCK_SIZE, BLOCK_SIZE, 1)]
+void krcScaleBlur(in uint2 did : SV_DispatchThreadID)
+{
+    uint2 size;
+    u_KrcScale.GetDimensions(size.x, size.y);
+    if (any(did >= size))
+        return;
+
+    const float z0 = u_OutputViewSpaceZ[did];
+    if (z0 == 0)
+    {
+        u_KrcScaleSmooth[did] = 1.0f;
+        return;
+    }
+    const float3 n0 = u_OutputNormalRoughness[did].xyz;
+
+    float sumW = 0.0f;
+    float sumLog = 0.0f;
+    for (int y = -4; y <= 4; y++)
+    {
+        for (int x = -4; x <= 4; x++)
+        {
+            const int2 p = int2(did) + 4 * int2(x, y);
+            if (any(p < 0) || any(p >= int2(size)))
+                continue;
+            const float z = u_OutputViewSpaceZ[p];
+            if (z == 0)
+                continue;
+            const float3 n = u_OutputNormalRoughness[p].xyz;
+            const float nd = saturate(dot(n0, n));
+            const float w = exp(-float(x * x + y * y) / 8.0f) * pow(nd, 8.0f) * exp(-abs(z - z0) / (0.03f * abs(z0)));
+            sumW += w;
+            sumLog += w * log(max(u_KrcScale[p], 1e-4f));
+        }
+    }
+    u_KrcScaleSmooth[did] = sumW > 0.0f ? exp(sumLog / sumW) : max(u_KrcScale[did], 1e-4f);
+}
 
