         KrcResolveMoments(did.x, sharcParameters, uint(g_Lighting.sharcAccumulationFrameNum), u_KrcMoments);
+        KrcResolveWeight(did.x, sharcParameters, g_Lighting.krcTolerance, u_KrcMoments);
+    }
 
     SharcResolveEntry(did.x, sharcParameters, resolveParameters);
 }
