diff --git a/Source/Shaders/RtCache.inl b/Source/Shaders/RtCache.inl
new file mode 100644
index 0000000..73c6d17
--- /dev/null
+++ b/Source/Shaders/RtCache.inl
@@ -0,0 +1,1030 @@
+// Copyright (c) 2026 Skynizz
+//
+// Passes des caches de radiance (branche krc), entre l'éclairage direct et l'indirect. Chaque
+// fichier RtCacheN.rgen définit CACHE_PASS puis inclut ce fichier :
+//   0 : SHaRC Update (un pixel par bloc NxN, chemin diffus depuis la surface primaire)
+//   1 : SHaRC Resolve (toutes les entrées)
+//   2 : KRC, compteurs de la frame          3 : KRC, cellules des pixels et tâches (Neyman)
+//                                               (mode 3 : chemin de référence par pixel)
+//   4 : KRC, liste libre                     5 : KRC, éviction
+//   6 : KRC, résolution (chemins corrélés)   7 : KRC, chemins des tâches
+// L'éclairage de chaque sommet est celui de RTGL1, en diffus comme ses rebonds ; KRC évalue en
+// plus chaque lampe avec son état de la frame précédente (même tirage) : chemins corrélés.
+
+layout (constant_id = 0) const uint maxAlbedoLayerCount = 0;
+#define MATERIAL_MAX_ALBEDO_LAYERS maxAlbedoLayerCount
+
+#define DESC_SET_TLAS 0
+#define DESC_SET_FRAMEBUFFERS 1
+#define DESC_SET_GLOBAL_UNIFORM 2
+#define DESC_SET_VERTEX_DATA 3
+#define DESC_SET_TEXTURES 4
+#define DESC_SET_RANDOM 5
+#define DESC_SET_LIGHT_SOURCES 6
+#define DESC_SET_CUBEMAPS 7
+#define DESC_SET_RENDER_CUBEMAP 8
+#define RAYGEN_SHADOW_PAYLOAD
+#define RAYGEN_COMMON_ONLY_DIFFUSE
+#define RAYGEN_ALLOW_FIREFLIES_CLAMP
+#include "RaygenCommon.h"
+
+#if CACHE_PASS == 0
+#define SHARC_UPDATE 1
+#endif
+#define SHARC_SEPARATE_EMISSIVE 1 // l'émission des surfaces (lampes de Doom) est ajoutée au point touché
+#include "RadianceCache.h"
+
+#define RC_FIRST_BOUNCE_MIP_BIAS 0
+#define RC_SECOND_BOUNCE_MIP_BIAS 32
+
+// ---------------------------------------------------------------- aléa
+uint rc_state;
+
+uint rc_hash(uint x)
+{
+    x ^= x >> 16; x *= 0x7feb352du;
+    x ^= x >> 15; x *= 0x846ca68bu;
+    x ^= x >> 16;
+    return x;
+}
+
+float rc_rand()
+{
+    rc_state = rc_state * 747796405u + 2891336453u;
+    uint w = ((rc_state >> ((rc_state >> 28u) + 4u)) ^ rc_state) * 277803737u;
+    return float((w >> 22u) ^ w) * (1.0 / 4294967296.0);
+}
+
+// graine du bruit bleu de RTGL1 tirée au hasard (chaque sommet a ses propres nombres)
+uint rc_seed()
+{
+    uint h = rc_hash(rc_state ^ 0x9e3779b9u);
+    rc_rand();
+    return packRandomSeed(h % BLUE_NOISE_TEXTURE_COUNT,
+                          uvec2(h >> 8, h >> 16) & uvec2(BLUE_NOISE_TEXTURE_SIZE - 1));
+}
+
+// ---------------------------------------------------------------- surfaces
+struct RcSurface
+{
+    vec3 position;
+    vec3 normal;
+    vec3 normalGeom;
+    vec3 albedo;
+    float emission;
+    float roughness;
+    float metallic;
+    uint instCustomIndex;
+    uint sector;
+};
+
+// surface primaire du pixel (G-buffer) ; false pour le ciel
+bool rc_primary_surface(ivec2 pix, out RcSurface s, out vec3 toViewer)
+{
+    const vec4 albedo4 = texelFetchAlbedo(pix);
+    toViewer = vec3(0, 0, 1);
+    if (isSky(albedo4))
+        return false;
+    const vec4 surfPosition = texelFetch(framebufSurfacePosition_Sampler, pix, 0);
+    const vec3 viewDirection = texelFetch(framebufViewDirection_Sampler, pix, 0).xyz;
+    const vec4 mr = texelFetch(framebufMetallicRoughness_Sampler, pix, 0);
+    s.position = surfPosition.xyz - viewDirection * RAY_ORIGIN_LEAK_BIAS;
+    s.normal = texelFetchNormal(pix);
+    s.normalGeom = texelFetchNormalGeometry(pix);
+    s.albedo = albedo4.rgb;
+    s.emission = 0.0; // l'émission vue par la caméra est déjà dans l'image
+    s.metallic = mr.r;
+    s.roughness = mr.g;
+    s.instCustomIndex = floatBitsToUint(surfPosition.a);
+    s.sector = texelFetch(framebufSectorIndex_Sampler, pix, 0).r;
+    toViewer = -viewDirection;
+    return true;
+}
+
+// rayon diffus depuis s (même tirage que les rebonds de RTGL1, autour de la normale géométrique) ;
+// oneOverPdf : pour le poids du premier rebond, que RTGL1 prend égal à oneOverPdf / pi
+ShPayload rc_bounce(RcSurface s, out vec3 dir, out float oneOverPdf)
+{
+    const vec2 u = vec2(rc_rand(), rc_rand());
+    dir = sampleLambertian(s.normalGeom, u.x, u.y, oneOverPdf);
+    return traceIndirectRay(s.instCustomIndex, s.position + s.normalGeom * 0.01, dir);
+}
+
+// surface touchée ; false si rien (ciel)
+bool rc_hit_surface(ShPayload p, RcSurface from, int bounce, out RcSurface s, out float hitDistance)
+{
+    hitDistance = 0;
+    if (!doesPayloadContainHitInfo(p))
+        return false;
+    const ShHitInfo h = getHitInfoBounce(p, from.position, from.roughness,
+                                         bounce <= 1 ? RC_FIRST_BOUNCE_MIP_BIAS : RC_SECOND_BOUNCE_MIP_BIAS, hitDistance);
+    s.position = h.hitPosition;
+    s.normal = h.normal;
+    s.normalGeom = h.normalGeom;
+    s.albedo = h.albedo;
+    s.emission = h.emission;
+    s.metallic = h.metallic;
+    s.roughness = h.roughness;
+    s.instCustomIndex = h.instCustomIndex;
+    s.sector = h.sectorArrayIndex;
+    hitDistance = length(h.hitPosition - from.position);
+    return true;
+}
+
+// lumière diffuse sortante d'un sommet (lumière directe de RTGL1 × albédo), sans son émission
+vec3 rc_vertex_light(RcSurface s, vec3 toViewer, int bounce)
+{
+    vec3 diffuse, specular;
+    processDirectIllumination(rc_seed(), s.instCustomIndex, s.position, s.normal, s.normalGeom, s.roughness,
+                              getSpecularColor(s.albedo, s.metallic), s.sector, toViewer, false, min(bounce, 2),
+                              diffuse, specular);
+    return s.albedo * diffuse;
+}
+
+// ---------------------------------------------------------------- KRC : lumière directe avant / après
+// Mêmes tirages que RTGL1 (processSphericalLight, processPolygonalLight…), mais chaque lampe tirée
+// est évaluée deux fois : avec son état de la frame et avec celui de la frame précédente (trouvé
+// par son identifiant). Même point, même rayon d'ombre : la différence est presque sans bruit.
+// lightId / lightLum : le groupe de la lampe la plus forte du tirage (rééclairage exact par groupe).
+struct KrcDirect
+{
+    vec3 dnew;
+    vec3 dold;
+    uint lightId;   // groupe de lampes + 1, 0 : aucun
+    float lightLum; // luminance (nouvelle) apportée par cette lampe
+};
+
+void krc_keep_light(inout KrcDirect r, uint id, vec3 c)
+{
+    float l = rc_lum(c);
+    if (l > r.lightLum)
+    {
+        r.lightLum = l;
+        r.lightId = id;
+    }
+}
+
+float krc_sph_irradiance(ShLightSpherical L, RcSurface s, out vec3 dirToCenter)
+{
+    float dist;
+    dirToCenter = getDirectionAndLength(s.position, L.position, dist);
+    const float I = pow(clamp((L.falloff - dist) / max(L.falloff - L.radius, 1), 0, 1), 2);
+    return min(I * max(dot(s.normal, dirToCenter), 0.0), globalUniform.firefliesClamp);
+}
+
+void krc_spherical(uint seed, RcSurface s, vec3 toViewer, int bounce, inout KrcDirect r)
+{
+    const uint count = globalUniform.lightCountSpherical;
+    const bool castShadowRay = bounce < globalUniform.maxBounceShadowsSphereLights;
+    if (count == 0 || (!castShadowRay && bounce != 0) || s.sector == SECTOR_INDEX_NONE)
+        return;
+
+    float rnd = getRandomSample(seed, RANDOM_SALT_SPHERICAL_LIGHT_CHOOSE).x * 0.99;
+    const uint lightListBegin = sectorToLightListRegion_StartEnd_Sph[s.sector * 2 + 0];
+    const uint lightListEnd   = sectorToLightListRegion_StartEnd_Sph[s.sector * 2 + 1];
+    const uint S = uint(ceil(float(lightListEnd - lightListBegin) / MAX_SUBSET_LEN));
+    const uint subsetOffset = uint(floor(rnd * S));
+    rnd = rnd * S - subsetOffset;
+
+    uint selected = UINT32_MAX;
+    float selectedMass = 0;
+    float weightsTotal = 0;
+    uint it = lightListBegin + subsetOffset;
+    for (int i = 0; i < MAX_SUBSET_LEN; ++i)
+    {
+        if (it >= lightListEnd)
+            break;
+        const float w = getSphericalLightWeight(s.position, s.normal, s.roughness, vec3(0), toViewer, it);
+        if (w > 0)
+        {
+            const float tau = weightsTotal / (weightsTotal + w);
+            weightsTotal += w;
+            if (rnd < tau)
+                rnd /= tau;
+            else
+            {
+                selected = it;
+                selectedMass = w;
+                rnd = (rnd - tau) / (1 - tau);
+            }
+            rnd = clamp(rnd, 0, 0.999);
+        }
+        it += S;
+    }
+    if (weightsTotal <= 0.0 || selectedMass <= 0.0 || selected == UINT32_MAX)
+        return;
+    const float pdf = selectedMass / (weightsTotal * S);
+
+    const uint idx = plainLightList_Sph[selected];
+    const ShLightSpherical L = lightSourcesSpherical[idx];
+    vec3 dirToCenter;
+    const float irr = krc_sph_irradiance(L, s, dirToCenter);
+    const vec3 cnew = evalBRDFLambertian(1.0) * L.color * M_PI * irr / pdf;
+
+    vec3 cold = vec3(0); // lampe nouvelle : elle n'éclairait rien avant
+    const uint packed = rc_cur_to_prev_sph().v[idx];
+    const uint prev = packed & 0xffffu;
+    if (prev != 0xffffu)
+    {
+        const ShLightSpherical P = lightSourcesSpherical_Prev[prev];
+        vec3 d;
+        cold = evalBRDFLambertian(1.0) * P.color * M_PI * krc_sph_irradiance(P, s, d) / pdf;
+    }
+
+    float vis = 1.0;
+    if (castShadowRay)
+    {
+        vec3 lightNormal;
+        const vec3 posOnSphere = getSphericalLightPosition(seed, dirToCenter, L.position, L.radius, lightNormal);
+        vis = float(!traceShadowRay(s.instCustomIndex, s.position + toViewer * RAY_ORIGIN_LEAK_BIAS, posOnSphere, false));
+    }
+    r.dnew += cnew * vis;
+    r.dold += cold * vis;
+    krc_keep_light(r, packed >> 16, cnew * vis);
+}
+
+float krc_poly_irradiance(ShLightPolygonal L, RcSurface s, vec2 u, out vec3 triPoint, out float nl)
+{
+    vec3 triNormal = cross(L.position_1.xyz - L.position_0.xyz, L.position_2.xyz - L.position_0.xyz);
+    const float triArea = length(triNormal) / 2.0;
+    nl = 0;
+    triPoint = s.position;
+    if (triArea < 0.0001)
+        return 0;
+    triNormal /= triArea * 2;
+    triPoint = sampleTriangle(L.position_0.xyz, L.position_1.xyz, L.position_2.xyz, u[0], u[1]);
+    float distToLightPoint;
+    const vec3 l = getDirectionAndLength(s.position, triPoint, distToLightPoint);
+    nl = dot(s.normal, l);
+    const float ngl = dot(s.normalGeom, l);
+    const float ll = -dot(triNormal, l);
+    if (nl <= 0 || ngl <= 0 || ll <= 0)
+        return 0;
+    // aire du triangle : la densité de tirage du point est 1 / aire
+    return triArea * min(pow(ll, globalUniform.polyLightSpotlightFactor) * getGeometryFactor(triNormal, l, distToLightPoint),
+                         globalUniform.firefliesClamp);
+}
+
+void krc_polygonal(uint seed, RcSurface s, vec3 toViewer, int bounce, inout KrcDirect r)
+{
+    const uint count = globalUniform.lightCountPolygonal;
+    const bool castShadowRay = bounce < globalUniform.maxBounceShadowsPolygonalLights;
+    if (count == 0 || (!castShadowRay && bounce != 0) || s.sector == SECTOR_INDEX_NONE)
+        return;
+
+    float rnd = getRandomSample(seed, RANDOM_SALT_POLYGONAL_LIGHT_CHOOSE).x * 0.99;
+    const uint lightListBegin = sectorToLightListRegion_StartEnd_Poly[s.sector * 2 + 0];
+    const uint lightListEnd   = sectorToLightListRegion_StartEnd_Poly[s.sector * 2 + 1];
+    const uint S = uint(ceil(float(lightListEnd - lightListBegin) / MAX_SUBSET_LEN));
+    const uint subsetOffset = uint(floor(rnd * S));
+    rnd = rnd * S - subsetOffset;
+
+    uint selected = UINT32_MAX;
+    float selectedMass = 0;
+    float weightsTotal = 0;
+    uint it = lightListBegin + subsetOffset;
+    for (int i = 0; i < MAX_SUBSET_LEN; ++i)
+    {
+        if (it >= lightListEnd)
+            break;
+        const float w = getPolygonalLightWeight(s.position, s.normalGeom, it);
+        if (w > 0)
+        {
+            const float tau = weightsTotal / (weightsTotal + w);
+            weightsTotal += w;
+            if (rnd < tau)
+                rnd /= tau;
+            else
+            {
+                selected = it;
+                selectedMass = w;
+                rnd = (rnd - tau) / (1 - tau);
+            }
+            rnd = clamp(rnd, 0, 0.999);
+        }
+        it += S;
+    }
+    if (weightsTotal <= 0.0 || selectedMass <= 0.0 || selected == UINT32_MAX)
+        return;
+    const float pdf = selectedMass / (weightsTotal * S);
+
+    const uint idx = plainLightList_Poly[selected];
+    const ShLightPolygonal L = lightSourcesPolygonal[idx];
+    const vec2 u = getRandomSample(seed, RANDOM_SALT_POLYGONAL_LIGHT_TRIANGLE_POINT).xy;
+    vec3 triPoint;
+    float nl;
+    const float irr = krc_poly_irradiance(L, s, u, triPoint, nl);
+    if (irr <= 0)
+        return;
+    const vec3 cnew = evalBRDFLambertian(1.0) * M_PI * L.color * nl * irr / pdf;
+
+    vec3 cold = vec3(0);
+    const uint packed = rc_cur_to_prev_poly().v[idx];
+    const uint prev = packed & 0xffffu;
+    if (prev != 0xffffu)
+    {
+        const ShLightPolygonal P = lightSourcesPolygonal_Prev[prev];
+        vec3 tp;
+        float pnl;
+        const float pirr = krc_poly_irradiance(P, s, u, tp, pnl);
+        cold = evalBRDFLambertian(1.0) * M_PI * P.color * max(pnl, 0.0) * pirr / pdf;
+    }
+
+    float vis = 1.0;
+    if (castShadowRay)
+        vis = float(!traceShadowRay(s.instCustomIndex, s.position + toViewer * RAY_ORIGIN_LEAK_BIAS, triPoint, false));
+    r.dnew += cnew * vis;
+    r.dold += cold * vis;
+    krc_keep_light(r, packed >> 16, cnew * vis);
+}
+
+// lumière directe diffuse d'un sommet, avant et après. Soleil et lampe torche : RTGL1 ne garde pas
+// leur état précédent, ils comptent pareil avant et après (un changement passe par la détection).
+KrcDirect krc_direct(RcSurface s, vec3 toViewer, int bounce)
+{
+    KrcDirect r;
+    r.dnew = vec3(0);
+    r.dold = vec3(0);
+    r.lightId = 0;
+    r.lightLum = 0;
+    bounce = min(bounce, 2);
+    const uint seed = rc_seed();
+
+    LightResult lr = newLightResult();
+    processDirectionalLight(seed, s.instCustomIndex, s.position, s.normal, s.normalGeom, s.roughness, vec3(0), s.sector,
+                            toViewer, false, bounce, lr);
+    if (lr.shadowRayEnable && traceShadowRay(s.instCustomIndex, lr.shadowRayStart, lr.shadowRayEnd, lr.shadowRayIgnoreFirstPersonViewer))
+        lr.diffuse = vec3(0);
+    r.dnew += lr.diffuse;
+    r.dold += lr.diffuse;
+
+    krc_spherical(seed, s, toViewer, bounce, r);
+    krc_polygonal(seed, s, toViewer, bounce, r);
+
+    lr = newLightResult();
+    processSpotLight(seed, s.instCustomIndex, s.position, s.normal, s.normalGeom, s.roughness, vec3(0), s.sector,
+                     toViewer, false, bounce, lr);
+    if (lr.shadowRayEnable && traceShadowRay(s.instCustomIndex, lr.shadowRayStart, lr.shadowRayEnd, lr.shadowRayIgnoreFirstPersonViewer))
+        lr.diffuse = vec3(0);
+    r.dnew += lr.diffuse;
+    r.dold += lr.diffuse;
+    return r;
+}
+
+// ---------------------------------------------------------------- SHaRC
+#if CACHE_PASS == 0
+void sharc_update(uvec2 block)
+{
+    const uint ds = uint(max(1.0, RC_SHARC_DOWNSCALE));
+    rc_state = rc_hash(block.x * 9781u + block.y * 6271u + rc_hash(RC_FRAME));
+    const ivec2 pix = ivec2(block * ds) + ivec2(min(uvec2(rc_rand() * ds, rc_rand() * ds), uvec2(ds - 1)));
+    if (pix.x >= int(RC_WIDTH) || pix.y >= int(RC_HEIGHT))
+        return;
+
+    RcSurface s;
+    vec3 toViewer;
+    if (!rc_primary_surface(pix, s, toViewer))
+        return;
+
+    SharcParameters params = sharc_parameters();
+    SharcState state;
+    SharcInit(state);
+
+    const int bounces = max(RC_BOUNCES, 1);
+    for (int b = 0; ; b++)
+    {
+        SharcHitData hit;
+        hit.positionWorld = s.position;
+        hit.normalWorld = s.normalGeom;
+        hit.materialDemodulation = rc_demodulation(s.albedo);
+        hit.emissive = s.emission * s.albedo;
+        const vec3 lighting = rc_vertex_light(s, toViewer, b);
+        if (!SharcUpdateHit(params, state, hit, lighting, rc_rand()))
+            break;
+        if (b >= bounces)
+            break;
+
+        vec3 dir;
+        float oneOverPdf;
+        const ShPayload p = rc_bounce(s, dir, oneOverPdf);
+        // rebond lambertien tiré selon le cosinus : poids = albédo
+        SharcSetThroughput(state, s.albedo);
+        RcSurface h;
+        float hitDistance;
+        if (!rc_hit_surface(p, s, b + 1, h, hitDistance))
+        {
+            SharcUpdateMiss(params, state, getSky(dir));
+            break;
+        }
+        s = h;
+        toViewer = -dir;
+    }
+}
+#endif
+
+void sharc_resolve(uint index)
+{
+    SharcResolveParameters rp;
+    rp.cameraPositionPrev = globalUniform.rcCamPosPrev.xyz;
+    rp.accumulationFrameNum = uint(RC_SHARC_ACCUM);
+    rp.responsiveFrameNum = 1;
+    rp.staleFrameNumMax = uint(RC_SHARC_STALE);
+    rp.frameIndex = RC_FRAME;
+    SharcResolveEntry(index, sharc_parameters(), rp);
+}
+
+// ---------------------------------------------------------------- KRC
+uint krc_alloc()
+{
+    KrcU64 ctr = krc_ctr();
+    const uint n = uint(ctr.v[KRC_C_FREE]);
+    const uint i = uint(atomicAdd(ctr.v[KRC_C_POP], uint64_t(1)));
+    if (i < n)
+        return krc_free().v[n - 1u - i];
+    const uint c = uint(atomicAdd(ctr.v[KRC_C_CELLS], uint64_t(1)));
+    if (c >= globalUniform.rcKrc.y)
+    {
+        atomicAdd(ctr.v[KRC_C_OVERFLOW], uint64_t(1));
+        return KRC_NONE;
+    }
+    return c;
+}
+
+uint krc_insert(uint key)
+{
+    const uint mask = globalUniform.rcKrc.x;
+    uint h = key & mask;
+    KrcU32 keys = krc_keys();
+    KrcU32 vals = krc_vals();
+    for (uint probe = 0u; probe < 64u; probe++)
+    {
+        const uint k = keys.v[h];
+        if (k == key)
+        {
+            const uint v = vals.v[h];
+            return v == 0u ? KRC_NONE : v - 1u;
+        }
+        if (k != 0u)
+        {
+            h = (h + 1u) & mask;
+            continue;
+        }
+        const uint old = atomicCompSwap(keys.v[h], 0u, key);
+        if (old == 0u)
+        {
+            const uint c = krc_alloc();
+            if (c == KRC_NONE)
+            {
+                keys.v[h] = KRC_TOMB;
+                return KRC_NONE;
+            }
+            KrcCell cell;
+            cell.mean = vec3(0);
+            cell.n = 0.0;
+            cell.lmean = 0.0;
+            cell.var = 0.0;
+            cell.seen = uint(krc_ctr().v[KRC_C_CLOCK]);
+            cell.key = key;
+            cell.slot = h + 1u;
+            cell.sigma = 0.0;
+            cell.born = cell.seen;
+            cell.change = 1.0;
+            cell.dir = vec3(0);
+            cell.relight = 1.0;
+            cell.lights = uvec2(0);
+            cell.share = vec2(0);
+            cell.dshare = vec2(0);
+            cell.relightInd = 1.0;
+            cell.pad = 0.0;
+            krc_cells().c[c] = cell;
+            atomicExchange(vals.v[h], c + 1u);
+            return c;
+        }
+        if (old == key)
+        {
+            const uint v = vals.v[h];
+            return v == 0u ? KRC_NONE : v - 1u;
+        }
+        h = (h + 1u) & mask;
+    }
+    return KRC_NONE;
+}
+
+float krc_sigma(uint c, float sigmaMean)
+{
+    const KrcCell cell = krc_cells().c[c];
+    if (cell.n < 8.0)
+        return max(sigmaMean, 1e-3) * 4.0;
+    return max(cell.sigma, 1e-4);
+}
+
+vec3 krc_first_dir;   // direction du premier rebond du dernier chemin
+uint krc_path_light;  // lampe principale du chemin (rééclairage exact)
+float krc_path_light_lum;
+
+void krc_track_light(KrcDirect d, vec3 beta, vec3 albedo)
+{
+    const float l = rc_lum(beta * albedo * d.dnew) * (d.lightLum / max(rc_lum(d.dnew), 1e-8));
+    if (d.lightId != 0 && l > krc_path_light_lum)
+    {
+        krc_path_light_lum = l;
+        krc_path_light = d.lightId;
+    }
+}
+
+// Un chemin d'indirect depuis la surface primaire du pixel : premier rebond tiré comme RTGL1,
+// puis jusqu'à KRC_BOUNCES rebonds diffus, avec arrêt sur une cellule mûre au 1er ou 2e sommet
+// (rééchantillonnage). value : estimation avec la lumière de la frame ; old : la même avec la
+// lumière de la frame précédente.
+void krc_path(RcSurface s, vec3 toViewer, bool reference, out vec3 value, out vec3 old)
+{
+    value = vec3(0);
+    old = vec3(0);
+    krc_path_light = 0;
+    krc_path_light_lum = 0;
+
+    vec3 dir;
+    float oneOverPdf;
+    ShPayload p = rc_bounce(s, dir, oneOverPdf);
+    krc_first_dir = dir;
+    // poids du premier rebond : la convention de RTGL1 (getDiffuseBounce), que son encodage de
+    // l'indirect et son débruiteur attendent ; ensuite, le poids exact d'un rebond lambertien
+    vec3 beta = vec3(evalBRDFLambertian(1.0) * oneOverPdf);
+
+    const int bounces = max(reference ? RC_REF_BOUNCES : RC_BOUNCES, 1);
+    const uint rsDepth = reference ? 0u : (rc_rand() < 0.5 ? 1u : 2u);
+    RcSurface from = s;
+    for (int b = 1; ; b++)
+    {
+        RcSurface h;
+        float segment;
+        if (!rc_hit_surface(p, from, b, h, segment))
+        {
+            const vec3 sky = getSky(dir);
+            value += beta * sky;
+            old += beta * sky;
+            return;
+        }
+        const vec3 emissive = h.emission * h.albedo;
+        const KrcDirect d = krc_direct(h, -dir, b);
+        krc_track_light(d, beta, h.albedo);
+
+        if (uint(b) == rsDepth)
+        {
+            float size;
+            const float dist = length(h.position - RC_CAM_POS);
+            const uint key = krc_key(h.position, h.normalGeom, dist, vec3(rc_rand(), rc_rand(), rc_rand()) - 0.5, size);
+            if (segment > size * 1.7320508)
+            {
+                const uint c = krc_find(key);
+                if (c != KRC_NONE && krc_cells().c[c].n >= 8.0)
+                {
+                    const vec3 cached = krc_cells().c[c].mean;
+                    value += beta * (h.albedo * (d.dnew + cached) + emissive);
+                    old += beta * (h.albedo * (d.dold + cached) + emissive);
+                    return;
+                }
+            }
+        }
+
+        value += beta * (h.albedo * d.dnew + emissive);
+        old += beta * (h.albedo * d.dold + emissive);
+        if (b >= bounces)
+            return;
+
+        beta *= h.albedo;
+        if (b >= 2)
+        {
+            const float q = clamp(max(beta.x, max(beta.y, beta.z)), 0.05, 0.95);
+            if (rc_rand() > q)
+                return;
+            beta /= q;
+        }
+        from = h;
+        p = rc_bounce(h, dir, oneOverPdf);
+    }
+}
+
+void krc_add(uint i, float v)
+{
+    atomicAdd(krc_acc().v[i], uint64_t(int64_t(v * KRC_FX)));
+}
+
+float krc_load(uint i)
+{
+    return float(int64_t(krc_acc().v[i])) / KRC_FX;
+}
+
+// passe 2
+void krc_prep()
+{
+    KrcU64 ctr = krc_ctr();
+    ctr.v[KRC_C_SIG_PREV] = ctr.v[KRC_C_SIG];
+    ctr.v[KRC_C_PIX_PREV] = ctr.v[KRC_C_PIX];
+    ctr.v[KRC_C_SIG] = 0;
+    ctr.v[KRC_C_PIX] = 0;
+    ctr.v[KRC_C_NVIS] = 0;
+    ctr.v[KRC_C_TASKS] = 0;
+    ctr.v[KRC_C_CLOCK] += 1;
+}
+
+// passe 3 : la cellule du pixel (créée si besoin), puis ses tâches : en moyenne
+// KRC_PPP × sigma / sigma moyen chemins (allocation de Neyman)
+void krc_pixel(ivec2 pix)
+{
+    if (pix.x >= int(RC_WIDTH) || pix.y >= int(RC_HEIGHT) || !rc_fits())
+        return;
+    const uint idx = rc_pixel_index(pix);
+    KrcU32 pixCells = krc_pix();
+
+    RcSurface s;
+    vec3 toViewer;
+    if (!rc_primary_surface(pix, s, toViewer))
+    {
+        pixCells.v[idx * KRC_K] = KRC_NONE;
+        return;
+    }
+    rc_state = rc_hash(idx * 0x9e3779b9u + rc_hash(RC_FRAME));
+    const float dist = length(s.position - RC_CAM_POS);
+    KrcU64 acc = krc_acc();
+    KrcU64 ctr = krc_ctr();
+
+    float size;
+    const uint key = krc_key(s.position, s.normalGeom, dist, vec3(rc_rand(), rc_rand(), rc_rand()) - 0.5, size);
+    const uint c = krc_insert(key);
+    pixCells.v[idx * KRC_K] = c;
+    if (c == KRC_NONE)
+        return;
+    const uint fa = c * KRC_ACC + KRC_A_FOOT;
+    if (acc.v[fa] == 0 && atomicCompSwap(acc.v[fa], uint64_t(0), uint64_t(1)) == 0)
+        krc_vis().v[uint(atomicAdd(ctr.v[KRC_C_NVIS], uint64_t(1)))] = c;
+
+    const float pixPrev = float(ctr.v[KRC_C_PIX_PREV]);
+    const float sigmaMean = pixPrev > 0 ? float(ctr.v[KRC_C_SIG_PREV]) / KRC_FX / pixPrev : 0.0;
+    const float sigma = krc_sigma(c, sigmaMean);
+    const uint sigSum = subgroupAdd(uint(min(sigma, 1000.0) * 1024.0));
+    const uint pixSum = subgroupAdd(1u);
+    if (subgroupElect())
+    {
+        atomicAdd(ctr.v[KRC_C_SIG], uint64_t(sigSum) * uint64_t(KRC_FX / 1024.0));
+        atomicAdd(ctr.v[KRC_C_PIX], uint64_t(pixSum));
+    }
+    const float p = RC_KRC_PPP * (sigmaMean > 0 ? sigma / sigmaMean : 1.0);
+    const uint paths = uint(floor(min(p, 4.0) + rc_rand()));
+
+    const uint offset = subgroupExclusiveAdd(paths);
+    const uint total = subgroupAdd(paths);
+    uint base = 0u;
+    if (subgroupElect())
+        base = uint(atomicAdd(ctr.v[KRC_C_TASKS], uint64_t(total)));
+    base = subgroupBroadcastFirst(base);
+    KrcU32 tasks = krc_tasks();
+    for (uint j = 0u; j < paths; j++)
+    {
+        const uint t = base + offset + j;
+        if (t >= globalUniform.rcKrc.z)
+            break;
+        tasks.v[2u * t] = idx;
+        tasks.v[2u * t + 1u] = c;
+    }
+}
+
+// Rééclairage exact : la cellule suit ses deux lampes principales. Pendant la frame, chaque
+// chemin dépose la part de sa lampe principale dans l'emplacement de cette lampe (pris s'il est
+// libre) ; à la résolution, ces parts deviennent des fractions de l'indirect de la cellule.
+void krc_add_light(uint b, uint light, float lumInd, float lumDir)
+{
+    if (light == 0 || !RC_KRC_RELIGHT)
+        return;
+    KrcU64 acc = krc_acc();
+    for (uint k = 0u; k < 2u; k++)
+    {
+        uint64_t cur = acc.v[b + KRC_A_LID + k];
+        if (cur == 0)
+            cur = atomicCompSwap(acc.v[b + KRC_A_LID + k], uint64_t(0), uint64_t(light));
+        if (cur == 0 || cur == uint64_t(light))
+        {
+            krc_add(b + KRC_A_LIND + k, lumInd);
+            krc_add(b + KRC_A_LDIR + k, lumDir);
+            return;
+        }
+    }
+}
+
+// passe 7 : un fil par tâche
+void krc_trace(uint id)
+{
+    KrcU64 ctr = krc_ctr();
+    if (id >= min(uint(ctr.v[KRC_C_TASKS]), globalUniform.rcKrc.z))
+        return;
+    KrcU32 tasks = krc_tasks();
+    const uint idx = tasks.v[2u * id];
+    const uint c = tasks.v[2u * id + 1u];
+    const ivec2 pix = ivec2(idx % RC_WIDTH, idx / RC_WIDTH);
+    RcSurface s;
+    vec3 toViewer;
+    if (!rc_primary_surface(pix, s, toViewer))
+        return;
+    rc_state = rc_hash(id * 0x9e3779b9u + rc_hash(RC_FRAME ^ 0x68e31da4u));
+    const KrcCell cell = krc_cells().c[c];
+
+    vec3 v, o;
+    krc_path(s, toViewer, false, v, o);
+    v = clamp(v, vec3(0), vec3(1e4));
+    o = clamp(o, vec3(0), vec3(1e4));
+    // écrêtage des lucioles : un échantillon plus de 50× la moyenne d'une cellule mûre
+    float l = rc_lum(v);
+    float clampK = 1.0;
+    if (cell.n >= 8.0 && l > 50.0 * max(cell.lmean, 1e-4))
+    {
+        clampK = 50.0 * max(cell.lmean, 1e-4) / l;
+        v *= clampK;
+        o *= clampK;
+        l *= clampK;
+    }
+    const uint b = c * KRC_ACC;
+    atomicAdd(krc_acc().v[b + KRC_A_FN], uint64_t(1));
+    krc_add(b + KRC_A_SUM + 0u, v.x);
+    krc_add(b + KRC_A_SUM + 1u, v.y);
+    krc_add(b + KRC_A_SUM + 2u, v.z);
+    krc_add(b + KRC_A_LUM, l);
+    krc_add(b + KRC_A_LUM2, l * l);
+    const vec3 d = v - o;
+    krc_add(b + KRC_A_DELTA + 0u, d.x);
+    krc_add(b + KRC_A_DELTA + 1u, d.y);
+    krc_add(b + KRC_A_DELTA + 2u, d.z);
+    krc_add(b + KRC_A_DIR + 0u, l * krc_first_dir.x);
+    krc_add(b + KRC_A_DIR + 1u, l * krc_first_dir.y);
+    krc_add(b + KRC_A_DIR + 2u, l * krc_first_dir.z);
+    const uint pathLight = krc_path_light;
+    const float pathLightLum = krc_path_light_lum * clampK;
+
+    // lumière directe au point de départ, avant et après : rapport pour le débruiteur, et part
+    // de la lampe principale
+    float d0Lum = 0;
+    uint d0Light = 0;
+    if (RC_KRC_DN_TALK)
+    {
+        const KrcDirect d0 = krc_direct(s, toViewer, 0);
+        d0Lum = d0.lightLum;
+        d0Light = d0.lightId;
+        krc_add(b + KRC_A_D0NEW, rc_lum(d0.dnew));
+        krc_add(b + KRC_A_D0OLD, rc_lum(d0.dold));
+    }
+    krc_add_light(b, pathLight, pathLightLum, (d0Light == pathLight) ? d0Lum : 0.0);
+    if (d0Light != 0 && d0Light != pathLight)
+        krc_add_light(b, d0Light, 0.0, d0Lum);
+}
+
+// passe 4
+void krc_mid()
+{
+    KrcU64 ctr = krc_ctr();
+    const uint64_t nf = ctr.v[KRC_C_FREE];
+    ctr.v[KRC_C_FREE] = nf - min(ctr.v[KRC_C_POP], nf);
+    ctr.v[KRC_C_POP] = 0;
+}
+
+// passe 5 : éviction des cellules inutilisées depuis 120 frames (1/32 des cellules par frame)
+void krc_evict(uint id)
+{
+    KrcU64 ctr = krc_ctr();
+    const uint clock = uint(ctr.v[KRC_C_CLOCK]);
+    const uint c = id * 32u + (clock & 31u);
+    if (c >= min(uint(ctr.v[KRC_C_CELLS]), globalUniform.rcKrc.y))
+        return;
+    KrcCells cells = krc_cells();
+    const uint slot = cells.c[c].slot;
+    if (slot == 0u || clock - cells.c[c].seen <= 120u)
+        return;
+    KrcU64 acc = krc_acc();
+    if (acc.v[c * KRC_ACC + KRC_A_FOOT] != 0)
+        return;
+    const uint h = slot - 1u;
+    krc_keys().v[h] = KRC_TOMB;
+    krc_vals().v[h] = 0u;
+    cells.c[c].slot = 0u;
+    cells.c[c].n = 0.0;
+    for (uint i = 0u; i < KRC_ACC; i++)
+        acc.v[c * KRC_ACC + i] = 0;
+    krc_free().v[uint(atomicAdd(ctr.v[KRC_C_FREE], uint64_t(1)))] = c;
+}
+
+// Rapport « après / avant » d'un groupe de lampes suivi, donné par le moteur (exact) ; false si
+// le moteur ne le connaît pas sûrement dans cette frame (lampes qui changent différemment, lampe
+// nouvelle) : ce changement-là passe alors par les chemins corrélés.
+bool krc_light_ratio(uint id, out float ratio)
+{
+    ratio = 1.0;
+    if (id == 0 || id > KRC_MAX_GROUPS)
+        return true;
+    ratio = rc_group_ratio().v[id - 1u];
+    if (ratio < 0.0)
+    {
+        ratio = 1.0;
+        return false;
+    }
+    return true;
+}
+
+// Passe 6 : résolution des cellules utilisées. 1) rééclairage exact : les lampes suivies dont
+// l'intensité a changé (connue du moteur, sans bruit) mettent à l'échelle leur part de
+// l'historique ; 2) chemins corrélés : la différence « après - avant » mesurée par les chemins,
+// moins ce que le rééclairage a déjà expliqué ; 3) moyenne glissante, détection de changement.
+void krc_resolve(uint id)
+{
+    KrcU64 ctr = krc_ctr();
+    if (id >= uint(ctr.v[KRC_C_NVIS]))
+        return;
+    const uint c = krc_vis().v[id];
+    KrcCells cells = krc_cells();
+    KrcCell cell = cells.c[c];
+    KrcU64 acc = krc_acc();
+    const uint b = c * KRC_ACC;
+    const float fn = float(acc.v[b + KRC_A_FN]);
+
+    // 1) rééclairage exact par lampe
+    vec3 explained = vec3(0);   // changement déjà expliqué (pour ne pas le compter deux fois)
+    float relightD0 = 1.0;
+    float scaleInd = 1.0;
+    float coveredD0 = 0.0;      // part de la lumière directe portée par les groupes suivis
+    float relightIndOut = 1.0;
+    const float lumBefore = rc_lum(cell.mean);
+    if (RC_KRC_RELIGHT && cell.n > 0.0)
+    {
+        coveredD0 = min(cell.dshare.x + cell.dshare.y, 1.0);
+        for (uint k = 0u; k < 2u; k++)
+        {
+            float r;
+            krc_light_ratio(cell.lights[k], r);
+            scaleInd += cell.share[k] * (r - 1.0);
+            relightD0 += cell.dshare[k] * (r - 1.0);
+            cell.share[k] *= r;
+            cell.dshare[k] *= r;
+        }
+        scaleInd = max(scaleInd, 0.0);
+        explained = cell.mean * (scaleInd - 1.0);
+        cell.mean *= scaleInd;
+        cell.lmean *= scaleInd;
+        const float sInd = max(scaleInd, 1e-6);
+        cell.share /= sInd;
+        cell.dshare /= max(relightD0, 1e-6);
+    }
+    relightIndOut = scaleInd;
+
+    if (fn > 0.0)
+    {
+        const vec3 fm = vec3(krc_load(b + KRC_A_SUM), krc_load(b + KRC_A_SUM + 1u), krc_load(b + KRC_A_SUM + 2u)) / fn;
+        const float fl = krc_load(b + KRC_A_LUM) / fn;
+        const float fl2 = krc_load(b + KRC_A_LUM2) / fn;
+        vec3 fd = vec3(krc_load(b + KRC_A_DELTA), krc_load(b + KRC_A_DELTA + 1u), krc_load(b + KRC_A_DELTA + 2u)) / fn;
+        const float varS = max(fl2 - fl * fl, 0.0);
+
+        const float rel = abs(rc_lum(fd)) / max(cell.lmean, 1e-4);
+        float change = (cell.n > 0.0) ? smoothstep(0.03, 0.2, rel) : 1.0;
+
+        // 2) chemins corrélés, sans ce que le rééclairage exact a déjà appliqué
+        if (cell.n > 0.0 && RC_KRC_DELTA)
+        {
+            fd -= explained;
+            cell.mean = max(cell.mean + fd, vec3(0));
+            cell.lmean = max(cell.lmean + rc_lum(fd), 0.0);
+        }
+        // rapport de l'indirect pour l'historique du débruiteur : rééclairage exact et chemins
+        // corrélés (nuls quand rien ne change : aucun bruit dans une scène fixe), sans la moyenne
+        // glissante, qui est bruitée et ferait dériver l'historique jusqu'au blanc
+        relightIndOut = (lumBefore > 1e-6) ? clamp(rc_lum(cell.mean) / lumBefore, 0.0, 50.0) : 1.0;
+        if (RC_KRC_DETECT && cell.n >= 8.0 && fn >= 4.0)
+        {
+            const float se = sqrt((varS + cell.var) / fn);
+            if (abs(fl - cell.lmean) > 4.0 * se + 0.05 * cell.lmean)
+            {
+                cell.n = min(cell.n, 4.0);
+                change = 1.0;
+            }
+        }
+        float a = max(fn / (cell.n + fn), fn / max(RC_KRC_HIST, 1.0));
+        a = min(a, 1.0);
+        cell.mean = mix(cell.mean, fm, a);
+        cell.lmean = mix(cell.lmean, fl, a);
+        cell.var = (cell.n > 0.0) ? mix(cell.var, varS + square(fl - cell.lmean), a) : varS;
+        cell.n = min(cell.n + fn, RC_KRC_HIST);
+        cell.sigma = sqrt(cell.var);
+        cell.change = max(change, cell.change * 0.5);
+
+        const vec3 fdir = vec3(krc_load(b + KRC_A_DIR), krc_load(b + KRC_A_DIR + 1u), krc_load(b + KRC_A_DIR + 2u)) / fn;
+        if (fl > 1e-6)
+        {
+            vec3 m = fdir / fl;
+            if (length(m) > 1.0) m = normalize(m);
+            cell.dir = (length(cell.dir) > 0.0) ? mix(cell.dir, m, a) : m;
+        }
+        const float d0n = krc_load(b + KRC_A_D0NEW);
+        const float d0o = krc_load(b + KRC_A_D0OLD);
+        // rapport pour le débruiteur : exact pour la part des groupes suivis, mesuré pour le reste
+        // (même échantillon et même ombre avant et après : vaut 1 exactement si rien ne change)
+        const float measured = (d0o > 1e-5) ? clamp(d0n / d0o, 0.0, 50.0) : 1.0;
+        cell.relight = RC_KRC_RELIGHT ? relightD0 + (1.0 - coveredD0) * (measured - 1.0) : measured;
+
+        // parts des lampes suivies (moyenne glissante des fractions mesurées dans la frame)
+        if (RC_KRC_RELIGHT)
+        {
+            const float sumInd = max(krc_load(b + KRC_A_LUM), 1e-6);
+            const float sumDir = max(d0n, 1e-6);
+            for (uint k = 0u; k < 2u; k++)
+            {
+                const uint lid = uint(acc.v[b + KRC_A_LID + k]);
+                if (lid == 0)
+                    continue;
+                const float fi = clamp(krc_load(b + KRC_A_LIND + k) / sumInd, 0.0, 1.0);
+                const float fdl = clamp(krc_load(b + KRC_A_LDIR + k) / sumDir, 0.0, 1.0);
+                // même lampe : on lisse ; sinon la lampe la plus forte prend la place
+                uint slotK = (cell.lights[0] == lid) ? 0u : ((cell.lights[1] == lid) ? 1u : 2u);
+                if (slotK == 2u)
+                {
+                    slotK = (cell.share[0] <= cell.share[1]) ? 0u : 1u;
+                    if (fi < cell.share[slotK] && fdl < cell.dshare[slotK])
+                        continue;
+                    cell.lights[slotK] = lid;
+                    cell.share[slotK] = fi;
+                    cell.dshare[slotK] = fdl;
+                }
+                else
+                {
+                    cell.share[slotK] = mix(cell.share[slotK], fi, a);
+                    cell.dshare[slotK] = mix(cell.dshare[slotK], fdl, a);
+                }
+            }
+            // les parts ne dépassent pas le tout
+            const float si = cell.share.x + cell.share.y;
+            if (si > 1.0) cell.share /= si;
+            const float sd = cell.dshare.x + cell.dshare.y;
+            if (sd > 1.0) cell.dshare /= sd;
+        }
+    }
+    else
+    {
+        cell.change *= 0.5;
+        cell.relight = relightD0;
+    }
+
+    cell.relightInd = relightIndOut;
+
+    cell.seen = uint(ctr.v[KRC_C_CLOCK]);
+    cells.c[c] = cell;
+    for (uint i = 0u; i < KRC_ACC; i++)
+        acc.v[b + i] = 0;
+}
+
+// ---------------------------------------------------------------- référence (mode 3)
+void ref_pixel(ivec2 pix)
+{
+    if (pix.x >= int(RC_WIDTH) || pix.y >= int(RC_HEIGHT) || !rc_fits())
+        return;
+    const uint idx = rc_pixel_index(pix);
+    RcSurface s;
+    vec3 toViewer;
+    vec3 v = vec3(0), o;
+    krc_first_dir = vec3(0, 1, 0);
+    if (rc_primary_surface(pix, s, toViewer))
+    {
+        rc_state = rc_hash(idx * 0x9e3779b9u + rc_hash(RC_FRAME ^ 0x3c6ef372u));
+        krc_path(s, toViewer, true, v, o);
+        v = clamp(v, vec3(0), vec3(1e4));
+    }
+    ref_indirect().v[2u * idx] = vec4(v, 1.0);
+    ref_indirect().v[2u * idx + 1u] = vec4(krc_first_dir, 0.0);
+}
+
+void main()
+{
+    const uvec2 id = uvec2(gl_LaunchIDEXT.xy);
+    const int mode = cache_mode();
+#if CACHE_PASS == 0
+    if (mode == CACHE_SHARC)
+        sharc_update(id);
+#elif CACHE_PASS == 1
+    if (mode == CACHE_SHARC)
+        sharc_resolve(id.y * 4096u + id.x);
+#elif CACHE_PASS == 2
+    if (mode == CACHE_KRC && id.x == 0 && id.y == 0)
+        krc_prep();
+#elif CACHE_PASS == 3
+    if (mode == CACHE_KRC)
+        krc_pixel(ivec2(id));
+    else if (mode == CACHE_REF)
+        ref_pixel(ivec2(id));
+#elif CACHE_PASS == 4
+    if (mode == CACHE_KRC && id.x == 0 && id.y == 0)
+        krc_mid();
+#elif CACHE_PASS == 5
+    if (mode == CACHE_KRC)
+        krc_evict(id.y * 4096u + id.x);
+#elif CACHE_PASS == 6
+    if (mode == CACHE_KRC)
+        krc_resolve(id.y * 4096u + id.x);
+#elif CACHE_PASS == 7
+    if (mode == CACHE_KRC)
+        krc_trace(id.y * RC_WIDTH + id.x);
+#endif
+}
