+
+void KrcLightGroups::BeginFrame()
+{
+    lumPrev.swap(lumCur);
+    lumCur.clear();
+    countPrev.assign(cur.size(), 0);
+    for (size_t i = 0; i < cur.size(); i++)
+    {
+        countPrev[i] = cur[i].count;
+    }
+    cur.assign(cur.size(), Stat{});
+}
+
+uint32_t KrcLightGroups::Add(uint32_t type, uint64_t uniqueID, uint32_t sectorID, float radius, float falloff,
+                             const float color[3])
+{
+    // forme quantifiée (rayon, portée) : sépare les lampes d'un secteur des objets lumineux
+    const auto q = [](float v) { return (uint64_t)std::max(0.0f, std::round(std::log2(1.0f + std::max(v, 0.0f)) * 4.0f)); };
+    const uint64_t key = ((uint64_t)type << 62) ^ ((uint64_t)sectorID << 16) ^ (q(radius) << 8) ^ q(falloff);
+
+    auto found = slots.find(key);
+    uint32_t slot;
+    if (found != slots.end())
+    {
+        slot = found->second;
+    }
+    else
+    {
+        if (slots.size() >= MAX_GROUPS)
+        {
+            return 0;
+        }
+        slot = (uint32_t)slots.size();
+        slots[key] = slot;
+    }
+    if (slot >= cur.size())
+    {
+        cur.resize(slot + 1);
+        countPrev.resize(slot + 1, 0);
+    }
+
+    const float lum = 0.2126f * color[0] + 0.7152f * color[1] + 0.0722f * color[2];
+    const uint64_t id = ((uint64_t)type << 62) ^ uniqueID;
+    lumCur[id] = lum;
+
+    Stat &s = cur[slot];
+    s.count++;
+    auto prev = lumPrev.find(id);
+    if (prev == lumPrev.end() || prev->second <= 0.0f)
+    {
+        s.unknown = true; // lampe nouvelle (ou éteinte avant) : rien à mettre à l'échelle
+    }
+    else
+    {
+        const float r = lum / prev->second;
+        s.rmin = std::min(s.rmin, r);
+        s.rmax = std::max(s.rmax, r);
+    }
+    return slot + 1;
+}
+
+const std::vector<float> &KrcLightGroups::Ratios() const
+{
+    ratios.assign(cur.size(), 1.0f);
+    for (size_t i = 0; i < cur.size(); i++)
+    {
+        const Stat &s = cur[i];
+        const uint32_t before = i < countPrev.size() ? countPrev[i] : 0;
+        if (s.count == 0)
+        {
+            ratios[i] = before > 0 ? 0.0f : 1.0f; // le groupe a disparu : sa lumière est partie
+        }
+        else if (s.unknown || s.count != before || s.rmax - s.rmin > 0.01f * s.rmax + 1e-6f)
+        {
+            ratios[i] = -1.0f;
+        }
+        else
+        {
+            ratios[i] = 0.5f * (s.rmin + s.rmax);
+        }
+    }
+    return ratios;
+}
+
