+
+// Groupes de lampes pour le rééclairage exact de KRC. Un groupe : les lampes d'un même secteur et
+// de même forme (dans Doom, les lampes d'un secteur suivent ensemble son niveau de lumière). Le
+// moteur connaît la couleur de chaque lampe avant et après : le rapport du groupe est exact s'il
+// est le même pour toutes ses lampes, sinon il est déclaré inconnu (-1) et KRC le mesure.
+class KrcLightGroups
+{
+public:
+    static constexpr uint32_t MAX_GROUPS = 16384;
+
+    void BeginFrame();
+    // emplacement du groupe de la lampe + 1 (0 : aucun)
+    uint32_t Add(uint32_t type, uint64_t uniqueID, uint32_t sectorID, float radius, float falloff, const float color[3]);
+    // rapport « après / avant » de chaque groupe (indice : emplacement), -1 s'il n'est pas sûr
+    const std::vector<float> &Ratios() const;
+
+private:
+    struct Stat
