+
+    int Mode(int current) const { return mode >= 0 ? mode : current; }
+    bool ExposureFrozen() const { return exposureFrozen; }
+    uint32_t ShowFlags() const { return showFlags; }
+    float LightScale(uint64_t uniqueID) const;
+    // temps GPU d'une frame, en ms par étape (KrcGpuTimer::Mark)
+    void GpuSample(const double ms[KrcGpuTimer::MARK_COUNT]);
+
+private:
+    struct Command
+    {
+        uint32_t frame;
+        std::string key, value;
+    };
+    std::vector<Command> commands;
+    void *window = nullptr;
+    std::string dir = "krc_captures";
+
+    int mode = -1;
+    bool exposureFrozen = false;
+    uint32_t showFlags = 0;
+    float lightScale = 1.0f;
+    bool halfGroup = false;
+
+    uint32_t fpsFrames = 0, fpsLeft = 0;
+    long long fpsStart = 0;
+    double gpuSum[12] = {};
+    uint32_t gpuCount = 0;
 };
 
 }
