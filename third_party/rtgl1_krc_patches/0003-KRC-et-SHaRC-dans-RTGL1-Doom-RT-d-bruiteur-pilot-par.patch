+namespace RTGL1
+{
+
+KrcScript &KrcScript::Get()
+{
+    static KrcScript script;
+    return script;
+}
+
+void KrcScript::Init(void *hwnd)
+{
+    window = hwnd;
+    if (const char *s = std::getenv("KRC_CAPTURE_DIR"))
+    {
+        dir = s;
+    }
+    if (const char *s = std::getenv("KRC_SCRIPT"))
+    {
+        std::stringstream ss(s);
+        std::string item;
+        while (std::getline(ss, item, ';'))
+        {
+            size_t colon = item.find(':');
+            if (colon == std::string::npos)
+            {
+                continue;
+            }
+            Command c;
+            c.frame = (uint32_t)std::strtoul(item.substr(0, colon).c_str(), nullptr, 10);
+            std::string rest = item.substr(colon + 1);
+            size_t eq = rest.find('=');
+            c.key = rest.substr(0, eq);
+            c.value = eq == std::string::npos ? "" : rest.substr(eq + 1);
+            commands.push_back(c);
+        }
+    }
+}
+
+void KrcScript::Frame(uint32_t frameId)
+{
+#ifdef _WIN32
+    LARGE_INTEGER now, freq;
+    QueryPerformanceCounter(&now);
+    QueryPerformanceFrequency(&freq);
+    if (fpsLeft > 0 && --fpsLeft == 0)
+    {
+        double seconds = (double)(now.QuadPart - fpsStart) / (double)freq.QuadPart;
+        if (FILE *f = std::fopen((dir + "/fps.txt").c_str(), "a"))
+        {
+            // GPU : image entière ; primaires et reflets ; direct ; passes du cache ; indirect ; débruiteur
+            const double n = std::max(1u, gpuCount);
+            std::fprintf(f, "frame %u mode %d fps %.2f ms %.3f gpu %.3f prim %.3f direct %.3f cache %.3f indirect %.3f denoise %.3f krcpix %.3f krctrace %.3f krcrest %.3f\n",
+                         frameId, mode, fpsFrames / seconds, 1000.0 * seconds / fpsFrames, gpuSum[0] / n,
+                         gpuSum[1] / n, gpuSum[2] / n, gpuSum[3] / n, gpuSum[4] / n, gpuSum[5] / n,
+                         gpuSum[6] / n, gpuSum[7] / n, gpuSum[8] / n);
+            std::fclose(f);
+        }
+    }
+#endif
+
+    for (const Command &c : commands)
+    {
+        if (c.frame != frameId)
+        {
+            continue;
+        }
+        if (c.key == "pause")
+        {
+#ifdef _WIN32
+            // touche Pause (code de balayage 0x45), comme un appui au clavier
+            if (window)
+            {
+                PostMessageA((HWND)window, WM_KEYDOWN, VK_PAUSE, (0x45 << 16) | 1);
+                PostMessageA((HWND)window, WM_KEYUP, VK_PAUSE, (0x45 << 16) | 1 | (3u << 30));
+            }
+#endif
+        }
+        else if (c.key == "expo")
+        {
+            exposureFrozen = c.value != "0";
+        }
+        else if (c.key == "mode")
+        {
+            mode = std::atoi(c.value.c_str());
+        }
+        else if (c.key == "light")
+        {
+            lightScale = (float)std::atof(c.value.c_str());
+        }
+        else if (c.key == "show")
+        {
+            showFlags = (uint32_t)std::strtoul(c.value.c_str(), nullptr, 10);
+        }
+        else if (c.key == "group")
+        {
+            halfGroup = c.value == "half";
+        }
+        else if (c.key == "fps")
+        {
+#ifdef _WIN32
+            fpsFrames = fpsLeft = (uint32_t)std::max(1, std::atoi(c.value.c_str()));
+            fpsStart = now.QuadPart;
+            std::memset(gpuSum, 0, sizeof(gpuSum));
+            gpuCount = 0;
+#endif
+        }
+    }
+}
+
+float KrcScript::LightScale(uint64_t uniqueID) const
+{
+    if (lightScale == 1.0f)
+    {
+        return 1.0f;
+    }
+    if (halfGroup)
+    {
+        // une lampe sur deux, d'après un mélange de son identifiant (stable d'une frame à l'autre)
+        uint64_t h = uniqueID * 0x9E3779B97F4A7C15ull;
+        if (((h >> 32) & 1) == 0)
+        {
+            return 1.0f;
+        }
+    }
+    return lightScale;
+}
