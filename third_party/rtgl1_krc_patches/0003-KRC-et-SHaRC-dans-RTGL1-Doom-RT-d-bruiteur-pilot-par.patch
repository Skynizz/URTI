+void KrcScript::GpuSample(const double ms[KrcGpuTimer::MARK_COUNT])
+{
+    if (fpsLeft == 0)
+    {
+        return;
+    }
+    // [0] : frame entière ; [1..5] : étapes successives
+    gpuSum[0] += ms[KrcGpuTimer::FRAME_END] - ms[KrcGpuTimer::FRAME_BEGIN];
+    gpuSum[1] += ms[KrcGpuTimer::DIRECT_BEGIN] - ms[KrcGpuTimer::FRAME_BEGIN];
+    gpuSum[2] += ms[KrcGpuTimer::CACHE_BEGIN] - ms[KrcGpuTimer::DIRECT_BEGIN];
+    gpuSum[3] += ms[KrcGpuTimer::CACHE_END] - ms[KrcGpuTimer::CACHE_BEGIN];
+    gpuSum[4] += ms[KrcGpuTimer::INDIRECT_END] - ms[KrcGpuTimer::CACHE_END];
+    gpuSum[5] += ms[KrcGpuTimer::DENOISE_END] - ms[KrcGpuTimer::INDIRECT_END];
+    // passes de KRC : pixels ; chemins ; le reste (éviction, résolution)
+    if (ms[KrcGpuTimer::CACHE_PIXEL] > 0.0)
+    {
+        gpuSum[6] += ms[KrcGpuTimer::CACHE_PIXEL] - ms[KrcGpuTimer::CACHE_BEGIN];
+        gpuSum[7] += ms[KrcGpuTimer::CACHE_TRACE] - ms[KrcGpuTimer::CACHE_PIXEL];
+        gpuSum[8] += ms[KrcGpuTimer::CACHE_END] - ms[KrcGpuTimer::CACHE_TRACE];
+    }
+    gpuCount++;
+}
+
+void KrcGpuTimer::Init(VkDevice device, VkPhysicalDevice physDevice)
+{
+    VkPhysicalDeviceProperties props;
+    vkGetPhysicalDeviceProperties(physDevice, &props);
+    periodNs = props.limits.timestampPeriod;
+
+    VkQueryPoolCreateInfo info = { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+    info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    info.queryCount = MARK_COUNT * MAX_FRAMES_IN_FLIGHT;
+    vkCreateQueryPool(device, &info, nullptr, &pool);
+}
+
+void KrcGpuTimer::Destroy(VkDevice device)
+{
+    if (pool != VK_NULL_HANDLE)
+    {
+        vkDestroyQueryPool(device, pool, nullptr);
+        pool = VK_NULL_HANDLE;
+    }
+}
+
+void KrcGpuTimer::Collect(VkDevice device, VkCommandBuffer cmd, uint32_t frameIndex)
+{
+    if (pool == VK_NULL_HANDLE)
+    {
+        return;
+    }
+    if (written[frameIndex])
+    {
+        uint64_t t[MARK_COUNT];
+        if (vkGetQueryPoolResults(device, pool, frameIndex * MARK_COUNT, MARK_COUNT, sizeof(t), t, sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) == VK_SUCCESS)
+        {
+            double ms[MARK_COUNT];
+            for (uint32_t i = 0; i < MARK_COUNT; i++)
+            {
+                ms[i] = (double)(t[i] - t[0]) * periodNs * 1e-6;
+            }
+            KrcScript::Get().GpuSample(ms);
+        }
+    }
+    vkCmdResetQueryPool(cmd, pool, frameIndex * MARK_COUNT, MARK_COUNT);
+    written[frameIndex] = false;
+}
+
+void KrcGpuTimer::Write(VkCommandBuffer cmd, uint32_t frameIndex, Mark m)
+{
+    if (pool == VK_NULL_HANDLE)
+    {
+        return;
+    }
+    vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, pool, frameIndex * MARK_COUNT + m);
+    if (m == FRAME_END)
+    {
+        written[frameIndex] = true;
+    }
+}
+
+}
