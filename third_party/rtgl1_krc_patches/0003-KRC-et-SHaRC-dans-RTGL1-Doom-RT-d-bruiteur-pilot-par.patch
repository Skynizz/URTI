+// Copyright (c) 2026 Skynizz
+
+#include "RadianceCache.h"
+
+#include <cstdlib>
+#include <cstring>
+
+#include "CmdLabel.h"
+#include "KrcTools.h"
+#include "LightManager.h"
+#include "RayTracingPipeline.h"
+
+namespace
+{
+
+constexpr uint32_t SHARC_CAPACITY = 1u << 22;
+constexpr uint32_t KRC_TABLE = 1u << 22;
+constexpr uint32_t KRC_CELLS = 1u << 20;
+constexpr uint32_t KRC_CELL_SIZE = 96;   // octets, struct KrcCell (Shaders/RadianceCache.h)
+constexpr uint32_t KRC_ACC = 21;         // accumulateurs 64 bits par cellule
+constexpr uint32_t KRC_CTR = 64;
+constexpr uint32_t KRC_K = 4;
+constexpr uint32_t KRC_MAX_PIXELS = 2560u * 1600u;
+constexpr uint32_t MAX_LIGHTS_MAPPED = 4096;    // ≥ nombre max de lampes de LightManager.cpp
+
+float EnvFloat(const char *name, float def)
+{
+    const char *s = std::getenv(name);
+    return s ? (float)std::atof(s) : def;
+}
+
+void Split(VkDeviceAddress a, uint32_t *lo, uint32_t *hi)
+{
+    *lo = (uint32_t)(a & 0xffffffffu);
+    *hi = (uint32_t)(a >> 32);
+}
+
+}
+
+namespace RTGL1
+{
+
+RadianceCache::RadianceCache(VkDevice _device, const std::shared_ptr<MemoryAllocator> &allocator) : device(_device)
+{
+    mode = (int)EnvFloat("KRC_MODE", 0);
+
+    // méthode, débogage, échelle SHaRC (50 : exemple du SDK ; voxel ≈ distance / échelle), accumulation
+    float p[5][4] = {
+        { (float)mode, EnvFloat("KRC_DEBUG", 0), EnvFloat("SHARC_SCENE_SCALE", 50), EnvFloat("SHARC_ACCUM", 20) },
+        { EnvFloat("SHARC_STALE", 64), EnvFloat("SHARC_DOWNSCALE", 5), EnvFloat("SHARC_RADIANCE_SCALE", 1000), EnvFloat("KRC_BOUNCES", 4) },
+        { EnvFloat("KRC_PPP", 0.1f), EnvFloat("KRC_CELL_PX", 16), EnvFloat("KRC_HIST", 4096), EnvFloat("KRC_DELTA", 1) },
+        { EnvFloat("KRC_DETECT", 1), EnvFloat("KRC_DENOISE", 1), EnvFloat("KRC_DN_TALK", 1), EnvFloat("KRC_DN_ERR", 0.03f) },
+        { EnvFloat("KRC_REF_BOUNCES", 8), EnvFloat("KRC_RELIGHT", 1), EnvFloat("KRC_FIX_GRADIENT", 1), 0 },
+    };
+    std::memcpy(params, p, sizeof(params));
+
+    const VkBufferUsageFlags usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT |
+                                     VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    const VkMemoryPropertyFlags local = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+    auto make = [&](Buffer &b, VkDeviceSize size, const char *name) { b.Init(allocator, size, usage, local, name); };
+
+    make(sharcHash, (VkDeviceSize)SHARC_CAPACITY * 8, "SHaRC hash entries");
+    make(sharcAccum, (VkDeviceSize)SHARC_CAPACITY * 16, "SHaRC accumulation");
+    make(sharcResolved, (VkDeviceSize)SHARC_CAPACITY * 16, "SHaRC resolved");
+    make(krcKeys, (VkDeviceSize)KRC_TABLE * 4, "KRC keys");
+    make(krcVals, (VkDeviceSize)KRC_TABLE * 4, "KRC values");
+    make(krcCells, (VkDeviceSize)KRC_CELLS * KRC_CELL_SIZE, "KRC cells");
+    make(krcAcc, (VkDeviceSize)KRC_CELLS * KRC_ACC * 8, "KRC accumulators");
+    make(krcCtr, (VkDeviceSize)KRC_CTR * 8, "KRC counters");
+    make(krcVis, (VkDeviceSize)KRC_CELLS * 4, "KRC visible cells");
+    make(krcFree, (VkDeviceSize)KRC_CELLS * 4, "KRC free list");
+    make(krcPix, (VkDeviceSize)KRC_MAX_PIXELS * KRC_K * 4, "KRC pixel cells");
+    make(krcTasks, (VkDeviceSize)KRC_MAX_PIXELS * 8, "KRC tasks");
+    make(krcSignal, (VkDeviceSize)KRC_MAX_PIXELS * 16, "KRC denoiser signal");
+    make(refIndirect, (VkDeviceSize)KRC_MAX_PIXELS * 32, "Reference indirect");
+
+    for (uint32_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
+    {
+        const VkMemoryPropertyFlags host = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+        curToPrevSph[i].Init(allocator, (VkDeviceSize)MAX_LIGHTS_MAPPED * 4,
+                             VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT, host,
+                             "KRC lights cur to prev (spherical)");
+        curToPrevPoly[i].Init(allocator, (VkDeviceSize)MAX_LIGHTS_MAPPED * 4,
+                              VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT, host,
+                              "KRC lights cur to prev (polygonal)");
+        groupRatio[i].Init(allocator, (VkDeviceSize)KrcLightGroups::MAX_GROUPS * 4,
+                           VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT, host,
+                           "KRC light group ratios");
+    }
+}
+
+RadianceCache::~RadianceCache()
+{
+    for (Buffer *b : { &sharcHash, &sharcAccum, &sharcResolved, &krcKeys, &krcVals, &krcCells, &krcAcc, &krcCtr, &krcVis,
+                       &krcFree, &krcPix, &krcTasks, &krcSignal, &refIndirect })
+    {
+        b->Destroy();
+    }
+    for (uint32_t i = 0; i < MAX_FRAMES_IN_FLIGHT; i++)
+    {
+        curToPrevSph[i].Destroy();
+        curToPrevPoly[i].Destroy();
+        groupRatio[i].Destroy();
+    }
+}
+
+void RadianceCache::FillUniform(ShGlobalUniform *gu, uint32_t frameIndex, uint32_t frameId, const LightManager &lights)
+{
+    // changement de méthode en cours de session : les caches repartent de zéro
+    const int scripted = KrcScript::Get().Mode(mode);
+    if (scripted != mode)
+    {
+        mode = scripted;
+        params[0][0] = (float)mode;
+        needsClear = true;
+    }
+
+    Split(sharcHash.GetAddress(), &gu->rcAddrA[0], &gu->rcAddrA[1]);
+    Split(sharcAccum.GetAddress(), &gu->rcAddrA[2], &gu->rcAddrA[3]);
+    Split(sharcResolved.GetAddress(), &gu->rcAddrB[0], &gu->rcAddrB[1]);
+    gu->rcAddrB[2] = SHARC_CAPACITY;
+    gu->rcAddrB[3] = frameId;
+    Split(krcKeys.GetAddress(), &gu->rcAddrC[0], &gu->rcAddrC[1]);
+    Split(krcVals.GetAddress(), &gu->rcAddrC[2], &gu->rcAddrC[3]);
+    Split(krcCells.GetAddress(), &gu->rcAddrD[0], &gu->rcAddrD[1]);
+    Split(krcAcc.GetAddress(), &gu->rcAddrD[2], &gu->rcAddrD[3]);
+    Split(krcCtr.GetAddress(), &gu->rcAddrE[0], &gu->rcAddrE[1]);
+    Split(krcVis.GetAddress(), &gu->rcAddrE[2], &gu->rcAddrE[3]);
+    Split(krcFree.GetAddress(), &gu->rcAddrF[0], &gu->rcAddrF[1]);
+    Split(krcPix.GetAddress(), &gu->rcAddrF[2], &gu->rcAddrF[3]);
+    Split(krcTasks.GetAddress(), &gu->rcAddrG[0], &gu->rcAddrG[1]);
+    Split(krcSignal.GetAddress(), &gu->rcAddrG[2], &gu->rcAddrG[3]);
+    Split(refIndirect.GetAddress(), &gu->rcAddrH[0], &gu->rcAddrH[1]);
+    Split(curToPrevSph[frameIndex].GetAddress(), &gu->rcAddrH[2], &gu->rcAddrH[3]);
+    Split(curToPrevPoly[frameIndex].GetAddress(), &gu->rcAddrI[0], &gu->rcAddrI[1]);
+    Split(groupRatio[frameIndex].GetAddress(), &gu->rcAddrI[2], &gu->rcAddrI[3]);
+    gu->rcKrc[0] = KRC_TABLE - 1;
+    gu->rcKrc[1] = KRC_CELLS;
+    gu->rcKrc[2] = KRC_MAX_PIXELS;
+    gu->rcKrc[3] = 0;
+
+    for (int i = 0; i < 3; i++)
+    {
+        gu->rcCamPosPrev[i] = camPosPrev[i];
+        camPosPrev[i] = gu->cameraPosition[i];
+    }
+    gu->rcCamPosPrev[3] = 0;
+    std::memcpy(gu->rcParams0, params[0], sizeof(params[0]));
+    std::memcpy(gu->rcParams1, params[1], sizeof(params[1]));
+    std::memcpy(gu->rcParams2, params[2], sizeof(params[2]));
+    std::memcpy(gu->rcParams3, params[3], sizeof(params[3]));
+    std::memcpy(gu->rcParams4, params[4], sizeof(params[4]));
+
+    // groupes de lampes : rapport exact de la frame
+    const auto &ratios = lights.GetKrcGroups().Ratios();
+    if (!ratios.empty())
+    {
+        std::memcpy(groupRatio[frameIndex].Map(), ratios.data(),
+                    std::min<size_t>(ratios.size(), KrcLightGroups::MAX_GROUPS) * 4);
+        groupRatio[frameIndex].Unmap();
+    }
+
+    // lampes : indice dans la frame précédente
+    const auto &sph = lights.GetCurToPrevSpherical();
+    const auto &poly = lights.GetCurToPrevPolygonal();
+    if (!sph.empty())
+    {
+        std::memcpy(curToPrevSph[frameIndex].Map(), sph.data(), std::min<size_t>(sph.size(), MAX_LIGHTS_MAPPED) * 4);
+        curToPrevSph[frameIndex].Unmap();
+    }
+    if (!poly.empty())
+    {
+        std::memcpy(curToPrevPoly[frameIndex].Map(), poly.data(), std::min<size_t>(poly.size(), MAX_LIGHTS_MAPPED) * 4);
+        curToPrevPoly[frameIndex].Unmap();
+    }
+}
+
+void RadianceCache::Clear(VkCommandBuffer cmd)
+{
+    for (Buffer *b : { &sharcHash, &sharcAccum, &sharcResolved, &krcKeys, &krcVals, &krcCells, &krcAcc, &krcCtr,
+                       &krcSignal })
+    {
+        vkCmdFillBuffer(cmd, b->GetBuffer(), 0, VK_WHOLE_SIZE, 0);
+    }
+    VkMemoryBarrier barrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &barrier, 0,
+                         nullptr, 0, nullptr);
+}
+
+void RadianceCache::Dispatch(VkCommandBuffer cmd, const std::shared_ptr<RayTracingPipeline> &rtPipeline, uint32_t pass,
+                             uint32_t width, uint32_t height)
+{
+    VkStridedDeviceAddressRegionKHR raygen, miss, hit, callable;
+    rtPipeline->GetEntries(SBT_INDEX_RAYGEN_CACHE_0 + pass, raygen, miss, hit, callable);
+    svkCmdTraceRaysKHR(cmd, &raygen, &miss, &hit, &callable, width, height, 1);
+
+    VkMemoryBarrier barrier = { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+    barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_RAY_TRACING_SHADER_BIT_KHR, VK_PIPELINE_STAGE_RAY_TRACING_SHADER_BIT_KHR,
+                         0, 1, &barrier, 0, nullptr, 0, nullptr);
+}
+
+void RadianceCache::Trace(VkCommandBuffer cmd, uint32_t frameIndex, const std::shared_ptr<RayTracingPipeline> &rtPipeline,
+                          uint32_t width, uint32_t height, KrcGpuTimer &timer)
+{
+    if (mode != 2)
+    {
+        // repères des passes de KRC : toujours écrits, pour que la frame soit lisible
+        timer.Write(cmd, frameIndex, KrcGpuTimer::CACHE_PIXEL);
+        timer.Write(cmd, frameIndex, KrcGpuTimer::CACHE_TRACE);
+    }
+    if (mode <= 0)
+    {
+        return;
+    }
+    if (needsClear)
+    {
+        Clear(cmd);
+        needsClear = false;
+    }
+
+    CmdLabel label(cmd, "Radiance cache");
+
+    if (mode == 1)
+    {
+        // SHaRC : Update (un pixel par bloc NxN), Resolve (toutes les entrées)
+        uint32_t ds = (uint32_t)std::max(1.0f, params[1][1]);
+        Dispatch(cmd, rtPipeline, 0, (width + ds - 1) / ds, (height + ds - 1) / ds);
+        Dispatch(cmd, rtPipeline, 1, 4096, SHARC_CAPACITY / 4096);
+    }
+    else if (mode == 2)
+    {
+        // KRC : compteurs, cellules des pixels (Neyman), chemins (tâches), liste libre, éviction, résolution
+        Dispatch(cmd, rtPipeline, 2, 1, 1);
+        Dispatch(cmd, rtPipeline, 3, width, height);
+        timer.Write(cmd, frameIndex, KrcGpuTimer::CACHE_PIXEL);
+        Dispatch(cmd, rtPipeline, 7, width, height);
+        timer.Write(cmd, frameIndex, KrcGpuTimer::CACHE_TRACE);
+        Dispatch(cmd, rtPipeline, 4, 1, 1);
+        Dispatch(cmd, rtPipeline, 5, 4096, KRC_CELLS / 32 / 4096);
+        Dispatch(cmd, rtPipeline, 6, 4096, KRC_CELLS / 4096);
+    }
+    else if (mode == 3)
+    {
+        // référence : un chemin complet par pixel
+        Dispatch(cmd, rtPipeline, 3, width, height);
+    }
+}
+
+}
diff --git a/Source/RadianceCache.h b/Source/RadianceCache.h
new file mode 100644
index 0000000..b93c3a5
--- /dev/null
+++ b/Source/RadianceCache.h
@@ -0,0 +1,57 @@
+// Copyright (c) 2026 Skynizz
+//
+// Caches de radiance de l'indirect, à comparer dans le jeu (branche krc) :
+//   KRC_MODE=0  rendu d'origine de RTGL1 (rebonds tracés, sans cache)
+//   KRC_MODE=1  SHaRC, SDK officiel de NVIDIA v1.8.3 (Shaders/sharc/), réglages de son exemple
+//   KRC_MODE=2  KRC
+//   KRC_MODE=3  référence : chemins complets sans cache (à accumuler)
+// Les réglages se lisent dans des variables d'environnement au lancement (voir Init).
+// Les passes (raygens RtCache0..7) tournent entre l'éclairage direct et l'indirect.
+
+#pragma once
+
+#include <vector>
+
+#include "Buffer.h"
+#include "Common.h"
+#include "Generated/ShaderCommonC.h"
+#include "KrcTools.h"
+
+namespace RTGL1
+{
+
+class RayTracingPipeline;
+class LightManager;
+
+class RadianceCache
+{
+public:
+    RadianceCache(VkDevice device, const std::shared_ptr<MemoryAllocator> &allocator);
+    ~RadianceCache();
+
+    RadianceCache(const RadianceCache &) = delete;
+    RadianceCache &operator=(const RadianceCache &) = delete;
+
+    void FillUniform(ShGlobalUniform *gu, uint32_t frameIndex, uint32_t frameId, const LightManager &lights);
+    void Trace(VkCommandBuffer cmd, uint32_t frameIndex, const std::shared_ptr<RayTracingPipeline> &rtPipeline,
+               uint32_t width, uint32_t height, KrcGpuTimer &timer);
+    void Reset() { needsClear = true; }
+    int Mode() const { return mode; }
+
+private:
+    void Clear(VkCommandBuffer cmd);
+    void Dispatch(VkCommandBuffer cmd, const std::shared_ptr<RayTracingPipeline> &rtPipeline, uint32_t pass,
+                  uint32_t width, uint32_t height);
+
+    VkDevice device;
+    int mode = 0;
+    bool needsClear = true;
+    float camPosPrev[3] = {};
+    float params[5][4] = {};
+
+    Buffer sharcHash, sharcAccum, sharcResolved;
+    Buffer krcKeys, krcVals, krcCells, krcAcc, krcCtr, krcVis, krcFree, krcPix, krcTasks, krcSignal, refIndirect;
+    Buffer curToPrevSph[MAX_FRAMES_IN_FLIGHT], curToPrevPoly[MAX_FRAMES_IN_FLIGHT], groupRatio[MAX_FRAMES_IN_FLIGHT];
+};
+
+}
