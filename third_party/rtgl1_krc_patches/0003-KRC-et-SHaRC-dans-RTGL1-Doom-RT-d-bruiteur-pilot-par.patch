+        float rmin = 1e30f, rmax = -1e30f;
+        uint32_t count = 0;
+        bool unknown = false;
+    };
+    std::unordered_map<uint64_t, uint32_t> slots;
+    std::unordered_map<uint64_t, float> lumPrev, lumCur;
+    std::vector<Stat> cur;
+    std::vector<uint32_t> countPrev;
+    mutable std::vector<float> ratios;
+};
+
+// Temps GPU des étapes de la frame (horodatages Vulkan), relus quand la frame est terminée et
+// moyennés par la mesure « fps=N » du scénario.
+class KrcGpuTimer
+{
+public:
+    enum Mark : uint32_t
+    {
+        FRAME_BEGIN,   // avant les rayons primaires
+        DIRECT_BEGIN,  // avant la lumière directe
+        CACHE_BEGIN,   // avant les passes du cache
+        CACHE_PIXEL,   // KRC : après la passe des pixels (insertion, répartition des chemins)
+        CACHE_TRACE,   // KRC : après les chemins
+        CACHE_END,     // après les passes du cache, avant l'indirect
+        INDIRECT_END,  // après l'indirect
+        DENOISE_END,   // après le débruiteur
+        FRAME_END,     // image finale, avant l'interface
+        MARK_COUNT
+    };
+
+    void Init(VkDevice device, VkPhysicalDevice physDevice);
+    void Destroy(VkDevice device);
+    // au début de la frame (après l'attente de sa barrière) : lit la frame précédente de cet indice
+    void Collect(VkDevice device, VkCommandBuffer cmd, uint32_t frameIndex);
+    void Write(VkCommandBuffer cmd, uint32_t frameIndex, Mark m);
+
+private:
+    VkQueryPool pool = VK_NULL_HANDLE;
+    float periodNs = 1.0f;
+    bool written[MAX_FRAMES_IN_FLIGHT] = {};
+};
+
+// scénario de la session, lu dans KRC_SCRIPT ; état global consulté par le moteur
+class KrcScript
+{
+public:
+    static KrcScript &Get();
+
