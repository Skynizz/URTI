diff --git a/Source/Shaders/KrcDenoiser.h b/Source/Shaders/KrcDenoiser.h
new file mode 100644
index 0000000..18e3749
--- /dev/null
+++ b/Source/Shaders/KrcDenoiser.h
@@ -0,0 +1,35 @@
+// Copyright (c) 2026 Skynizz
+//
+// Ce que KRC dit au débruiteur (A-SVGF), par pixel ; écrit par RtRaygenIndirect dans la même
+// frame (voir krc_smooth_indirect, RadianceCache.h). Requiert RadianceCacheExt.h et globalUniform.
+//   x : rapport « après / avant » de la lumière directe, exact quand les lampes sont suivies
+//   y : confiance de l'indirect de KRC (0 à 1)
+//   z : rapport « après / avant » de l'indirect
+//   w : rapport « après / avant » du spéculaire (direct et reflet)
+
+#ifndef KRC_DENOISER_H_
+#define KRC_DENOISER_H_
+
+layout(buffer_reference, std430, buffer_reference_align = 16) buffer KrcDenoiserSignal { vec4 v[]; };
+
+// KRC est actif et parle au débruiteur
+bool krc_talks()
+{
+    return int(globalUniform.rcParams0.x) == 2 && globalUniform.rcParams3.z != 0 &&
+           uint(globalUniform.renderWidth) * uint(globalUniform.renderHeight) <= globalUniform.rcKrc.z;
+}
+
+// l'indirect de KRC, déjà filtré dans le temps par les cellules, remplace l'historique
+bool krc_owns_indirect()
+{
+    return krc_talks() && globalUniform.rcParams3.y != 0;
+}
+
+vec4 krc_denoiser_signal(ivec2 pix)
+{
+    const uint i = uint(pix.y) * uint(globalUniform.renderWidth) + uint(pix.x);
+    const vec4 s = KrcDenoiserSignal(packUint2x32(globalUniform.rcAddrG.zw)).v[i];
+    return vec4(clamp(s.x, 0.0, 50.0), clamp(s.y, 0.0, 1.0), clamp(s.z, 0.0, 50.0), clamp(s.w, 0.0, 50.0));
+}
+
+#endif // KRC_DENOISER_H_
diff --git a/Source/Shaders/RadianceCache.h b/Source/Shaders/RadianceCache.h
new file mode 100644
index 0000000..d7c2090
--- /dev/null
+++ b/Source/Shaders/RadianceCache.h
@@ -0,0 +1,331 @@
+// Copyright (c) 2026 Skynizz
+//
+// Caches de radiance de l'indirect (branche krc), partie commune aux passes (RtCache.inl) et à
+// leur lecture (RtRaygenIndirect.rgen). Méthode choisie par KRC_MODE (voir RadianceCache.h C++) :
+//   1 : SHaRC, SDK officiel de NVIDIA v1.8.3 (sharc/), non modifié, réglages de son exemple ;
+//   2 : KRC ;  3 : référence (chemins complets sans cache).
+// À inclure après RaygenCommon.h (les macros du SDK, lerp, saturate…, ne doivent pas toucher
+// le code de RTGL1 inclus avant). Il faut les extensions de RadianceCacheExt.h.
+
+#ifndef RADIANCE_CACHE_H_
+#define RADIANCE_CACHE_H_
+
+#define SHARC_ENABLE_GLSL 1
+#define SHARC_MATERIAL_DEMODULATION 1    // comme l'exemple Pathtracer du SDK
+#define SHARC_ENABLE_FADE_ACCELERATION 1 // option du SDK : convergence accélérée quand la lumière baisse
+#ifndef SHARC_UPDATE
+#define SHARC_UPDATE 0
+#endif
+#ifndef SHARC_QUERY
+#define SHARC_QUERY 0
+#endif
+
+#include "sharc/SharcGlslHelpers.h"
+#include "sharc/SharcCommon.h"
+
+#define CACHE_NONE  0
+#define CACHE_SHARC 1
+#define CACHE_KRC   2
+#define CACHE_REF   3
+
+// ---------------------------------------------------------------- accès au UBO de RTGL1
+#define RC_CAM_POS          (globalUniform.cameraPosition.xyz)
+#define RC_WIDTH            (uint(globalUniform.renderWidth))
+#define RC_HEIGHT           (uint(globalUniform.renderHeight))
+#define RC_FRAME            (globalUniform.rcAddrB.w)
+#define RC_DEBUG            (int(globalUniform.rcParams0.y))
+#define RC_SHARC_SCALE      (globalUniform.rcParams0.z)
+#define RC_SHARC_ACCUM      (globalUniform.rcParams0.w)
+#define RC_SHARC_STALE      (globalUniform.rcParams1.x)
+#define RC_SHARC_DOWNSCALE  (globalUniform.rcParams1.y)
+#define RC_SHARC_RAD_SCALE  (globalUniform.rcParams1.z)
+#define RC_BOUNCES          (int(globalUniform.rcParams1.w))
+#define RC_KRC_PPP          (globalUniform.rcParams2.x)
+#define RC_KRC_CELL_PX      (globalUniform.rcParams2.y)
+#define RC_KRC_HIST         (globalUniform.rcParams2.z)
+#define RC_KRC_DELTA        (globalUniform.rcParams2.w != 0)
+#define RC_KRC_DETECT       (globalUniform.rcParams3.x != 0)
+#define RC_KRC_DENOISE      (globalUniform.rcParams3.y != 0)
+#define RC_KRC_DN_TALK      (globalUniform.rcParams3.z != 0)
+#define RC_KRC_DN_ERR       (globalUniform.rcParams3.w)
+#define RC_REF_BOUNCES      (int(globalUniform.rcParams4.x))
+#define RC_KRC_RELIGHT      (globalUniform.rcParams4.y != 0)
+
+int cache_mode()
+{
+    return int(globalUniform.rcParams0.x);
+}
+
+uint64_t rc_address(uvec2 a)
+{
+    return packUint2x32(a);
+}
+
+float rc_lum(vec3 c)
+{
+    return getLuminance(c);
+}
+
+// référence (mode 3) : par pixel, v[2 i] = indirect (rgb), v[2 i + 1] = direction du premier rebond
+layout(buffer_reference, std430, buffer_reference_align = 16) buffer RefIndirect { vec4 v[]; };
+RefIndirect ref_indirect() { return RefIndirect(rc_address(globalUniform.rcAddrH.xy)); }
+
+// lampes de la frame : (groupe + 1) << 16 | indice dans la frame précédente (0xffff : nouvelle)
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer RcU32 { uint v[]; };
+RcU32 rc_cur_to_prev_sph() { return RcU32(rc_address(globalUniform.rcAddrH.zw)); }
+RcU32 rc_cur_to_prev_poly() { return RcU32(rc_address(globalUniform.rcAddrI.xy)); }
+// groupes de lampes : rapport « après / avant » exact de la frame, -1 s'il n'est pas sûr
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer RcF32 { float v[]; };
+RcF32 rc_group_ratio() { return RcF32(rc_address(globalUniform.rcAddrI.zw)); }
+#define KRC_MAX_GROUPS 16384u   // KrcLightGroups::MAX_GROUPS
+
+SharcParameters sharc_parameters()
+{
+    SharcParameters p;
+    p.hashGridParameters.cameraPosition = RC_CAM_POS;
+    p.hashGridParameters.logarithmBase = SHARC_GRID_LOGARITHM_BASE;
+    p.hashGridParameters.sceneScale = RC_SHARC_SCALE;
+    p.hashGridParameters.levelBias = SHARC_GRID_LEVEL_BIAS;
+    p.hashGridData.capacity = globalUniform.rcAddrB.z;
+    p.hashGridData.hashEntriesBuffer = RWStructuredBuffer_uint64_t(rc_address(globalUniform.rcAddrA.xy));
+    p.radianceScale = RC_SHARC_RAD_SCALE;
+    p.accumulationBuffer = RWStructuredBuffer_SharcAccumulationData(rc_address(globalUniform.rcAddrA.zw));
+    p.resolvedBuffer = RWStructuredBuffer_SharcPackedData(rc_address(globalUniform.rcAddrB.xy));
+    return p;
+}
+
+// démodulation par l'albédo (le cache stocke la lumière ÷ albédo ; la texture est remise à la
+// lecture)
+vec3 rc_demodulation(vec3 albedo)
+{
+    return max(albedo, vec3(0.05));
+}
+
+// ========================================================================== //
+// KRC (mode 2). Cellules en espace monde, de taille ≈ KRC_CELL_PX pixels à l'écran (niveaux en
+// puissances de 2 selon la distance) et par orientation. Une cellule stocke la même grandeur que
+// le canal d'indirect diffus de RTGL1 (contribution du rebond diffus, sans l'albédo du pixel).
+// ========================================================================== //
+
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer KrcU32 { uint v[]; };
+layout(buffer_reference, std430, buffer_reference_align = 8) buffer KrcU64 { uint64_t v[]; };
+
+struct KrcCell
+{
+    vec3 mean;      // indirect moyen
+    float n;        // échantillons dans l'historique (plafonné à KRC_HIST)
+    float lmean;    // luminance moyenne
+    float var;      // variance par échantillon de la luminance (moyenne glissante)
+    uint seen;      // dernière frame (horloge KRC) où la cellule a servi
+    uint key;
+    uint slot;      // case de la table + 1 (0 : libre)
+    float sigma;    // écart-type par échantillon (allocation de Neyman)
+    uint born;
+    float change;   // la lumière vient de changer ici (0 à 1)
+    vec3 dir;       // direction moyenne de la lumière arrivante, pondérée par son intensité
+    float relight;  // rapport « après / avant » de la lumière directe dans la frame
+    uvec2 lights;   // rééclairage exact : les deux lampes principales (type << 30 | indice de la frame)
+    vec2 share;     // ... leur part de l'indirect de la cellule
+    vec2 dshare;    // ... leur part de la lumière directe au point de départ
+    float relightInd; // rapport « après / avant » de l'indirect de la cellule dans la frame
+    float pad;
+};
+layout(buffer_reference, std430, buffer_reference_align = 16) buffer KrcCells { KrcCell c[]; };
+
+#define KRC_K        4
+#define KRC_NONE     0xffffffffu
+#define KRC_TOMB     0xffffffffu
+#define KRC_FX       65536.0
+// accumulateurs par cellule (64 bits, virgule fixe KRC_FX)
+#define KRC_ACC      21
+#define KRC_A_FOOT   0   // la cellule est lue dans la frame
+#define KRC_A_FN     1   // échantillons de la frame
+#define KRC_A_SUM    2   // 2..4 : somme rgb
+#define KRC_A_LUM    5
+#define KRC_A_LUM2   6
+#define KRC_A_DELTA  7   // 7..9 : somme rgb des différences « après - avant » (signée)
+#define KRC_A_DIR    10  // 10..12 : somme de luminance × direction du premier rebond (signée)
+#define KRC_A_D0NEW  13  // luminance de la lumière directe au point de départ (frame)
+#define KRC_A_D0OLD  14  // ... la même avec la lumière de la frame précédente
+#define KRC_A_LID    15  // 15..16 : lampes suivies (type << 30 | indice), 0 : libre
+#define KRC_A_LIND   17  // 17..18 : part de l'indirect due à ces lampes (luminance)
+#define KRC_A_LDIR   19  // 19..20 : part de la lumière directe au départ due à ces lampes
+// compteurs (64 bits)
+#define KRC_C_CELLS     0
+#define KRC_C_NVIS      1
+#define KRC_C_FREE      2
+#define KRC_C_POP       3
+#define KRC_C_SIG       4
+#define KRC_C_PIX       5
+#define KRC_C_SIG_PREV  6
+#define KRC_C_PIX_PREV  7
+#define KRC_C_CLOCK     8
+#define KRC_C_OVERFLOW  9
+#define KRC_C_TASKS     10
+
+KrcU32 krc_keys()    { return KrcU32(rc_address(globalUniform.rcAddrC.xy)); }
+KrcU32 krc_vals()    { return KrcU32(rc_address(globalUniform.rcAddrC.zw)); }
+KrcCells krc_cells() { return KrcCells(rc_address(globalUniform.rcAddrD.xy)); }
+KrcU64 krc_acc()     { return KrcU64(rc_address(globalUniform.rcAddrD.zw)); }
+KrcU64 krc_ctr()     { return KrcU64(rc_address(globalUniform.rcAddrE.xy)); }
+KrcU32 krc_vis()     { return KrcU32(rc_address(globalUniform.rcAddrE.zw)); }
+KrcU32 krc_free()    { return KrcU32(rc_address(globalUniform.rcAddrF.xy)); }
+KrcU32 krc_pix()     { return KrcU32(rc_address(globalUniform.rcAddrF.zw)); }
+KrcU32 krc_tasks()   { return KrcU32(rc_address(globalUniform.rcAddrG.xy)); }
+
+// signaux pour le débruiteur, par pixel : x = rapport « après / avant » de la lumière directe
+// (1 : rien n'a changé), y = confiance de l'estimation de KRC (0 à 1), z = rapport de l'indirect
+layout(buffer_reference, std430, buffer_reference_align = 16) buffer KrcSignal { vec4 v[]; };
+KrcSignal krc_signal() { return KrcSignal(rc_address(globalUniform.rcAddrG.zw)); }
+
+bool rc_fits()
+{
+    return RC_WIDTH * RC_HEIGHT <= globalUniform.rcKrc.z;
+}
+
+uint rc_pixel_index(ivec2 pix)
+{
+    return uint(pix.y) * RC_WIDTH + uint(pix.x);
+}
+
+uint krc_mix(uint h, uint v)
+{
+    h ^= v + 0x9e3779b9u + (h << 6) + (h >> 2);
+    h ^= h >> 16; h *= 0x7feb352du;
+    h ^= h >> 15; h *= 0x846ca68bu;
+    h ^= h >> 16;
+    return h;
+}
+
+// angle (en radians) couvert par un pixel
+float krc_pixel_angle()
+{
+    return 2.0 / (abs(globalUniform.projection[1][1]) * float(RC_HEIGHT));
+}
+
+int krc_level(float dist, out float size)
+{
+    float target = RC_KRC_CELL_PX * max(dist, 1e-3) * krc_pixel_angle();
+    int level = int(floor(log2(max(target, 1e-4)) + 0.5));
+    size = exp2(float(level));
+    return level;
+}
+
+uint krc_axis(vec3 n)
+{
+    vec3 an = abs(n);
+    return (an.x >= an.y && an.x >= an.z) ? 0u : ((an.y >= an.z) ? 1u : 2u);
+}
+
+// orientation de la cellule : axe dominant et signe (6 faces), puis l'inclinaison dans chacun
+// des deux autres axes en 3 classes (9)
+uint krc_face(vec3 n, uint axis)
+{
+    float na = (axis == 0u) ? n.x : ((axis == 1u) ? n.y : n.z);
+    uint a1 = (axis + 1u) % 3u;
+    uint a2 = (axis + 2u) % 3u;
+    float t1 = n[a1] / max(abs(na), 1e-3);
+    float t2 = n[a2] / max(abs(na), 1e-3);
+    uint b1 = t1 < -0.4 ? 0u : (t1 > 0.4 ? 2u : 1u);
+    uint b2 = t2 < -0.4 ? 0u : (t2 > 0.4 ? 2u : 1u);
+    return (axis * 2u + (na < 0.0 ? 1u : 0u)) * 9u + b1 * 3u + b2;
+}
+
+uint krc_key_q(ivec3 q, int level, uint face)
+{
+    uint h = krc_mix(0x12345u, uint(q.x));
+    h = krc_mix(h, uint(q.y));
+    h = krc_mix(h, uint(q.z));
+    h = krc_mix(h, uint(level + 128) * 64u + face);
+    if (h == 0u || h == KRC_TOMB)
+        h = 1u;
+    return h;
+}
+
+// clé de la cellule du point p ; décalage jitter (fractions de cellule) dans le plan de la face
+uint krc_key(vec3 p, vec3 n, float dist, vec3 jitter, out float size)
+{
+    int level = krc_level(dist, size);
+    uint axis = krc_axis(n);
+    jitter[axis] = 0.0;
+    ivec3 q = ivec3(floor(p / size + jitter));
+    return krc_key_q(q, level, krc_face(n, axis));
+}
+
+uint krc_find(uint key)
+{
+    uint mask = globalUniform.rcKrc.x;
+    uint h = key & mask;
+    KrcU32 keys = krc_keys();
+    for (uint probe = 0u; probe < 64u; probe++)
+    {
+        uint k = keys.v[h];
+        if (k == key)
+        {
+            uint v = krc_vals().v[h];
+            return v == 0u ? KRC_NONE : v - 1u;
+        }
+        if (k == 0u)
+            return KRC_NONE;
+        h = (h + 1u) & mask;
+    }
+    return KRC_NONE;
+}
+
+// Débruiteur intégré : indirect d'un point reconstruit à partir des 4 cellules voisines dans le
+// plan de sa face (interpolation bilinéaire), pondérées par leur confiance. Déterministe : rien à
+// accumuler ni à filtrer ensuite.
+bool krc_smooth_indirect(vec3 p, vec3 n, out vec3 value, out vec4 signal, out vec3 dir)
+{
+    value = vec3(0);
+    signal = vec4(0);
+    dir = vec3(0);
+    float dist = length(p - RC_CAM_POS);
+    float size;
+    int level = krc_level(dist, size);
+    uint axis = krc_axis(n);
+    uint face = krc_face(n, axis);
+    vec3 f = p / size - 0.5;
+    ivec3 base = ivec3(floor(f));
+    vec3 t = f - vec3(base);
+    base[axis] = int(floor(p[axis] / size));
+    uint a1 = (axis + 1u) % 3u;
+    uint a2 = (axis + 2u) % 3u;
+    KrcCells cells = krc_cells();
+    float wsum = 0.0;
+    float wbil = 0.0;
+    for (int j = 0; j < 2; j++)
+    {
+        for (int i = 0; i < 2; i++)
+        {
+            ivec3 q = base;
+            q[a1] += i;
+            q[a2] += j;
+            uint c = krc_find(krc_key_q(q, level, face));
+            if (c == KRC_NONE)
+                continue;
+            float cn = cells.c[c].n;
+            if (cn <= 0.0)
+                continue;
+            float w = (i == 1 ? t[a1] : 1.0 - t[a1]) * (j == 1 ? t[a2] : 1.0 - t[a2]);
+            wbil += w;
+            float rse = cells.c[c].sigma / sqrt(cn) / max(cells.c[c].lmean, 1e-4);
+            float conf = 1.0 / (1.0 + square(rse / max(RC_KRC_DN_ERR, 1e-4)));
+            signal.x += w * cells.c[c].relight;
+            signal.y += w * conf;
+            signal.z += w * cells.c[c].relightInd;
+            w = max(w, 1e-3) * min(cn / 16.0, 1.0);
+            value += w * cells.c[c].mean;
+            dir += w * cells.c[c].dir;
+            wsum += w;
+        }
+    }
+    if (wsum <= 0.0)
+        return false;
+    signal = (wbil > 0.0) ? signal / wbil : vec4(1.0, 0.0, 1.0, 0.0);
+    value /= wsum;
+    dir /= wsum;
+    return true;
+}
+
+#endif // RADIANCE_CACHE_H_
