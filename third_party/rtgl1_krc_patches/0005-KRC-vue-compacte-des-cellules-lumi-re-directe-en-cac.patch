@@ -328,7 +376,36 @@ bool krc_smooth_indirect(vec3 p, vec3 n, out vec3 value, out vec4 signal, out ve
     signal = (wbil > 0.0) ? signal / wbil : vec4(1.0, 0.0, 1.0, 0.0);
     value /= wsum;
     dir /= wsum;
