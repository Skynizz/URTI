+// Vue compacte d'une cellule (32 octets), écrite à sa résolution, seule lue par l'affichage :
+//  a : moyenne r g ; moyenne b, poids (n / 16 plafonné à 1, 0 : inutilisable) ; rapports direct,
+//      indirect ; confiance
+//  b : lumière directe r g ; b ; direction moyenne (snorm 8 bits) ; frame de la résolution
+// Les rapports ne valent que dans la frame de leur résolution (sinon 1 : rien à rééclairer).
+layout(buffer_reference, std430, buffer_reference_align = 16) buffer KrcViews { uvec4 v[]; };
+KrcViews krc_views() { return KrcViews(rc_address(globalUniform.rcAddrJ.xy)); }
+
+struct KrcView
+{
+    vec3 mean;
+    float weight;
+    float relight, relightInd, conf;
+    vec3 direct;
+    vec3 dir;
+};
+
+KrcView krc_view_unpack(uvec4 a, uvec4 b, uint clock)
+{
+    KrcView v;
+    const vec2 rg = unpackHalf2x16(a.x), bw = unpackHalf2x16(a.y), r = unpackHalf2x16(a.z);
+    v.mean = vec3(rg, bw.x);
+    v.weight = bw.y;
+    const bool fresh = b.w == clock;
+    v.relight = fresh ? r.x : 1.0;
+    v.relightInd = fresh ? r.y : 1.0;
+    v.conf = unpackHalf2x16(a.w).x;
+    const vec2 drg = unpackHalf2x16(b.x);
+    v.direct = vec3(drg, unpackHalf2x16(b.y).x);
+    v.dir = unpackSnorm4x8(b.z).xyz;
+    return v;
+}
+
+void krc_view_pack(KrcCell cell, uint clock, out uvec4 a, out uvec4 b)
+{
+    const vec3 m = min(cell.mean, vec3(60000.0));
+    const vec3 d = min(cell.direct, vec3(60000.0));
+    const float rse = cell.sigma / sqrt(max(cell.n, 1.0)) / max(cell.lmean, 1e-4);
+    const float conf = (cell.n > 0.0) ? 1.0 / (1.0 + square(rse / max(RC_KRC_DN_ERR, 1e-4))) : 0.0;
+    a = uvec4(packHalf2x16(m.xy), packHalf2x16(vec2(m.z, clamp(cell.n / 16.0, 0.0, 1.0))),
+              packHalf2x16(vec2(min(cell.relight, 60000.0), min(cell.relightInd, 60000.0))), packHalf2x16(vec2(conf, 0.0)));
+    b = uvec4(packHalf2x16(d.xy), packHalf2x16(vec2(d.z, 0.0)), packSnorm4x8(vec4(clamp(cell.dir, -1.0, 1.0), 0.0)), clock);
+}
+
 // Débruiteur intégré : indirect d'un point reconstruit à partir des 4 cellules voisines dans le
 // plan de sa face (interpolation bilinéaire), pondérées par leur confiance. Déterministe : rien à
 // accumuler ni à filtrer ensuite.
-bool krc_smooth_indirect(vec3 p, vec3 n, out vec3 value, out vec4 signal, out vec3 dir)
+bool krc_smooth_lookup(vec3 p, vec3 n, out vec3 value, out vec4 signal, out vec3 dir, out vec3 direct)
 {
     value = vec3(0);
     signal = vec4(0);
     dir = vec3(0);
+    direct = vec3(0);
     float dist = length(p - RC_CAM_POS);
     float size;
     int level = krc_level(dist, size);
@@ -294,7 +342,8 @@ bool krc_smooth_indirect(vec3 p, vec3 n, out vec3 value, out vec4 signal, out ve
     base[axis] = int(floor(p[axis] / size));
     uint a1 = (axis + 1u) % 3u;
     uint a2 = (axis + 2u) % 3u;
-    KrcCells cells = krc_cells();
+    KrcViews views = krc_views();
+    const uint clock = uint(krc_ctr().v[KRC_C_CLOCK]);
     float wsum = 0.0;
     float wbil = 0.0;
     for (int j = 0; j < 2; j++)
@@ -307,19 +356,18 @@ bool krc_smooth_indirect(vec3 p, vec3 n, out vec3 value, out vec4 signal, out ve
             uint c = krc_find(krc_key_q(q, level, face));
             if (c == KRC_NONE)
                 continue;
-            float cn = cells.c[c].n;
-            if (cn <= 0.0)
+            const KrcView cv = krc_view_unpack(views.v[2u * c], views.v[2u * c + 1u], clock);
+            if (cv.weight <= 0.0)
                 continue;
             float w = (i == 1 ? t[a1] : 1.0 - t[a1]) * (j == 1 ? t[a2] : 1.0 - t[a2]);
             wbil += w;
-            float rse = cells.c[c].sigma / sqrt(cn) / max(cells.c[c].lmean, 1e-4);
-            float conf = 1.0 / (1.0 + square(rse / max(RC_KRC_DN_ERR, 1e-4)));
-            signal.x += w * cells.c[c].relight;
-            signal.y += w * conf;
