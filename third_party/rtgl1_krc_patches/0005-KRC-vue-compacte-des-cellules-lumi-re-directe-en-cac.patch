 }
 
+// Une seule cellule, celle qui contient le point (pour un reflet : le lobe et le débruiteur du
+// spéculaire lissent déjà ; quatre fois moins de recherches que krc_smooth_lookup)
+bool krc_point_lookup(vec3 p, vec3 n, out vec3 value, out vec4 signal, out vec3 direct, out float size)
+{
+    value = vec3(0);
+    signal = vec4(1.0, 0.0, 1.0, 1.0);
+    direct = vec3(0);
+    const int level = krc_level(length(p - RC_CAM_POS), size);
+    const uint axis = krc_axis(n);
+    ivec3 q = ivec3(floor(p / size));
+    const uint c = krc_find(krc_key_q(q, level, krc_face(n, axis)));
+    if (c == KRC_NONE)
+        return false;
+    const KrcView cv = krc_view_unpack(krc_views().v[2u * c], krc_views().v[2u * c + 1u], uint(krc_ctr().v[KRC_C_CLOCK]));
