+// harmoniques sphériques d'ordre 1 avec une direction par canal (irradianceToSH, canal par canal).
+// Une direction courte est une mesure (lumière rasante ou venue de côtés opposés : composante
+// directionnelle presque nulle), pas une absence de mesure : la remplacer par 2/3 de la normale
+// doublait l'éclairage des surfaces éclairées de biais.
+SH krc_sh(vec3 value, vec3 dirR, vec3 dirG, vec3 dirB, vec3 n)
+{
+    SH sh;
+    sh.r = vec4(0.282095, 0.488603 * dirR.y, 0.488603 * dirR.z, 0.488603 * dirR.x) * value.r;
+    sh.g = vec4(0.282095, 0.488603 * dirG.y, 0.488603 * dirG.z, 0.488603 * dirG.x) * value.g;
+    sh.b = vec4(0.282095, 0.488603 * dirB.y, 0.488603 * dirB.z, 0.488603 * dirB.x) * value.b;
+    return sh;
+}
