Subject: [PATCH 8/9] =?UTF-8?q?KRC=20:=20premier=20rebond=20trac=C3=A9=20a?=
 =?UTF-8?q?u=20pixel=20(KRC=5FHYBRID),=20bruit=20bleu=20de=20RTGL1,=20unit?=
 =?UTF-8?q?=C3=A9=20des=20cellules=20r=C3=A9utilis=C3=A9es?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- KRC_HYBRID : 0 cellules au pixel ; 1 rebond tracé là où les cellules voisines se contredisent
  au-delà de leur incertitude ; 2 toujours (comme SHaRC), cache de KRC lu au point touché, second
  rebond tracé s'il n'y a pas de cellule (point hors champ).
- Tirages du premier rebond avec le bruit bleu de RTGL1 : un hasard blanc donnait 4 fois plus de
  bruit après le débruiteur.
- Une cellule réutilisée en un point (rééchantillonnage des chemins, rebond tracé, reflets) donne
  la lumière reçue par évaluation de ses harmoniques sphériques avec la normale : la valeur brute,
  pondérée par 1/cos, valait environ le double pour une lumière uniforme.

---
 Source/RadianceCache.cpp       |  8 +++-
 Source/RadianceCache.h         |  3 ++
 Source/Shaders/RadianceCache.h | 34 +++++++++++--
 Source/Shaders/RtCache.inl     | 88 +++++++++++++++++++++++++++++++++-
 4 files changed, 126 insertions(+), 7 deletions(-)

diff --git a/Source/RadianceCache.cpp b/Source/RadianceCache.cpp
index 0d00f3d..11c6841 100644
--- a/Source/RadianceCache.cpp
+++ b/Source/RadianceCache.cpp
@@ -45,6 +45,9 @@ RadianceCache::RadianceCache(VkDevice _device, const std::shared_ptr<MemoryAlloc
     mode = (int)EnvFloat("KRC_MODE", 0);
     fireflyFactor = EnvFloat("KRC_FIREFLY", 50);
     emitPhys = EnvFloat("KRC_EMIT_PHYS", 0) != 0;
+    hybrid = (uint32_t)EnvFloat("KRC_HYBRID", 1);
+    traceContrast = EnvFloat("KRC_TRACE_CONTRAST", 0.3f);
+    traceSigma = EnvFloat("KRC_TRACE_SIGMA", 1.0f);
 
     // méthode, débogage, échelle SHaRC (50 : exemple du SDK ; voxel ≈ distance / échelle), accumulation
     float p[5][4] = {
@@ -138,8 +141,9 @@ void RadianceCache::FillUniform(ShGlobalUniform *gu, uint32_t frameIndex, uint32
     Split(curToPrevPoly[frameIndex].GetAddress(), &gu->rcAddrI[0], &gu->rcAddrI[1]);
     Split(groupRatio[frameIndex].GetAddress(), &gu->rcAddrI[2], &gu->rcAddrI[3]);
     Split(krcViews.GetAddress(), &gu->rcAddrJ[0], &gu->rcAddrJ[1]);
-    gu->rcAddrJ[2] = 0;
-    gu->rcAddrJ[3] = 0;
+    gu->rcAddrJ[2] = hybrid;   // KRC_HYBRID : 0 jamais, 1 là où les cellules hésitent, 2 toujours
+    // KRC_TRACE_CONTRAST en millièmes, KRC_TRACE_SIGMA en centièmes
+    gu->rcAddrJ[3] = (uint32_t)(traceContrast * 1000.0f) | ((uint32_t)(traceSigma * 100.0f) << 16);
     gu->rcKrc[0] = KRC_TABLE - 1;
     gu->rcKrc[1] = KRC_CELLS;
     gu->rcKrc[2] = KRC_MAX_PIXELS;
