---
 src/refresh/vkpt/shader/global_ubo.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/refresh/vkpt/shader/global_ubo.h b/src/refresh/vkpt/shader/global_ubo.h
index 3d4923d6..f06463f1 100644
--- a/src/refresh/vkpt/shader/global_ubo.h
+++ b/src/refresh/vkpt/shader/global_ubo.h
@@ -43,7 +43,7 @@ with this program; if not, write to the Free Software Foundation, Inc.,
 	UBO_CVAR_DO(pt_sharc_downscale, 5) /* SHaRC : un pixel mis à jour par bloc NxN */ \
 	UBO_CVAR_DO(pt_sharc_radiance_scale, 1000) /* SHaRC : quantification de l'accumulation */ \
 	UBO_CVAR_DO(pt_cache_bounces, 4) /* rebonds des chemins de mise à jour du cache */ \
-	UBO_CVAR_DO(pt_krc_ppp, 0.25) /* KRC : chemins par pixel et par frame (moyenne, allocation de Neyman) */ \
+	UBO_CVAR_DO(pt_krc_ppp, 0.1) /* KRC : chemins par pixel et par frame (moyenne, allocation de Neyman) ; 0,1 : même coût que SHaRC */ \
 	UBO_CVAR_DO(pt_krc_cell_px, 16) /* KRC : taille d'une cellule à l'écran, en pixels */ \
 	UBO_CVAR_DO(pt_krc_hist, 256) /* KRC : historique maximal d'une cellule (échantillons) */ \
 	UBO_CVAR_DO(pt_krc_delta, 1) /* KRC : chemins corrélés (lumière d'avant / d'après des lampes animées) */ \
