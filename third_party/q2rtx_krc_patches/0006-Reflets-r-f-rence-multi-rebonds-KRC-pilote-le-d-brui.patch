+
+	float conf = krc_confidence(ipos_hires);
+	filtered_lf.shY = mix(filtered_lf.shY, color_center_lf.shY, conf);
+	filtered_lf.CoCg = mix(filtered_lf.CoCg, color_center_lf.CoCg, conf);
