 shared float s_depth[SHARED_SIZE][SHARED_SIZE];
@@ -246,6 +274,15 @@ main()
 			temporal_color_lf.CoCg        *= inv_w_diff;
 			temporal_color_hf             *= inv_w_diff;
 			temporal_moments_histlen_hf   *= inv_w_diff;
+			{
+				vec2 krc_r = krc_signal_at(ipos);
+				if (krc_r.x >= 0)
+				{
+					temporal_color_hf *= krc_r.x;
+					temporal_moments_histlen_hf.r *= krc_r.x;
+					temporal_moments_histlen_hf.g *= krc_r.x * krc_r.x;
+				}
+			}
 			temporal_sample_valid_diff    = true;
 		}
 
@@ -253,6 +290,11 @@ main()
 		{
