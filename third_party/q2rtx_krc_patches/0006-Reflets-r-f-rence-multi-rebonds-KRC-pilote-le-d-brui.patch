+// signaux de KRC (pt_cache 2, radiance_cache.h) : x = la lumière a changé, y = confiance
+layout(buffer_reference, std430, buffer_reference_align = 8) buffer KrcSignalT { vec2 v[]; };
+
+vec2 krc_signal_at(ivec2 ipos)
+{
+	if (global_ubo.pt_cache != 2 || global_ubo.pt_krc_dn_talk == 0
+		|| uint(global_ubo.width) * uint(global_ubo.height) > global_ubo.rc_krc.z)
+		return vec2(-1);
+	return KrcSignalT(global_ubo.rc_addr_g.zw).v[uint(ipos.y) * uint(global_ubo.width) + uint(ipos.x)];
+}
+
+// facteur anti-retard du débruiteur, corrigé par KRC : là où KRC est sûr et que la lumière n'a
+// pas changé, les fausses alertes (gradients mesurés sur des pixels bruités) sont réduites
+// (pt_krc_dn_trust < 1)
+float krc_antilag(float antilag, vec2 s)
+{
+	if (s.x < 0)
+		return antilag;
+	// (essayé : garder l'historique rééclairé contre les gradients du débruiteur ; avec des lampes
+	// qui clignotent sans cesse, le rapport mesuré par cellule est bruité et l'historique,
+	// multiplié par ce bruit à chaque frame, dérivait : pire)
+	if (abs(s.x - 1.0) < 0.01 && s.y > 0.5)
+		antilag *= global_ubo.pt_krc_dn_trust;
+	return antilag;
+}
+
 // Store some color data in shared memory for efficient access and for downsampling
