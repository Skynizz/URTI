+// confiance de KRC dans son indirect (pt_cache 2, radiance_cache.h) : là où elle est haute, le
+// filtre ne touche pas ; là où l'erreur de la cellule est trop grande, il lisse
+layout(buffer_reference, std430, buffer_reference_align = 8) buffer KrcSignalL { vec2 v[]; };
+
+float krc_confidence(ivec2 ipos)
+{
+	if (global_ubo.pt_cache != 2 || global_ubo.pt_krc_denoise == 0 || global_ubo.pt_krc_dn_talk == 0
+		|| uint(global_ubo.width) * uint(global_ubo.height) > global_ubo.rc_krc.z)
+		return 0.0;
+	ipos = clamp(ipos, ivec2(0), ivec2(global_ubo.width - 1, global_ubo.height - 1));
+	return clamp(KrcSignalL(global_ubo.rc_addr_g.zw).v[uint(ipos.y) * uint(global_ubo.width) + uint(ipos.x)].y, 0.0, 1.0);
+}
+
 // Filter kernel.
