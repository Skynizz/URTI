+/*
+==================
+Cmd_KrcView_f
+
+krc_view x y z pitch yaw : place l'œil du joueur (comparaisons des caches de radiance,
+vues fixes choisies dans les cartes). Mêmes règles que les autres triches.
+==================
+*/
+void Cmd_KrcView_f(edict_t *ent)
+{
+    vec3_t angles;
+    int i;
+
+    if (deathmatch->value && !sv_cheats->value) {
+        gi.cprintf(ent, PRINT_HIGH, "You must run the server with '+set cheats 1' to enable this command.\n");
+        return;
+    }
+    if (gi.argc() < 6) {
+        gi.cprintf(ent, PRINT_HIGH, "usage: krc_view x y z pitch yaw\n");
+        return;
+    }
+
+    gi.unlinkentity(ent);
+    for (i = 0; i < 3; i++)
+        ent->s.origin[i] = atof(gi.argv(1 + i));
+    ent->s.origin[2] -= ent->viewheight;
+    VectorCopy(ent->s.origin, ent->s.old_origin);
+    VectorClear(ent->velocity);
+    ent->client->ps.pmove.pm_time = 160 >> 3;
+    ent->client->ps.pmove.pm_flags |= PMF_TIME_TELEPORT;
+
+    angles[0] = atof(gi.argv(4));
+    angles[1] = atof(gi.argv(5));
+    angles[2] = 0;
+    for (i = 0; i < 3; i++)
+        ent->client->ps.pmove.delta_angles[i] = ANGLE2SHORT(angles[i] - ent->client->resp.cmd_angles[i]);
+    VectorCopy(angles, ent->s.angles);
+    VectorCopy(angles, ent->client->ps.viewangles);
+    VectorCopy(angles, ent->client->v_angle);
+    gi.linkentity(ent);
+}
+
 void Cmd_Noclip_f(edict_t *ent)
 {
     if ((deathmatch->value || coop->value) && !sv_cheats->value) {
@@ -899,6 +941,8 @@ void ClientCommand(edict_t *ent)
         Cmd_Notarget_f(ent);
     else if (Q_stricmp(cmd, "noclip") == 0)
         Cmd_Noclip_f(ent);
+    else if (Q_stricmp(cmd, "krc_view") == 0)
+        Cmd_KrcView_f(ent);
     else if (Q_stricmp(cmd, "inven") == 0)
         Cmd_Inven_f(ent);
     else if (Q_stricmp(cmd, "invnext") == 0)
