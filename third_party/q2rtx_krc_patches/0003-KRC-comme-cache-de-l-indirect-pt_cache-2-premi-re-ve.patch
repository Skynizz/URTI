+		a = min(a, 1.0);
+		cell.mean = mix(cell.mean, fm, a);
+		cell.lmean = mix(cell.lmean, fl, a);
+		cell.var = (cell.n > 0.0) ? mix(cell.var, var_s + square(fl - cell.lmean), a) : var_s;
+		cell.n = min(cell.n + fn, global_ubo.pt_krc_hist);
+		cell.sigma = sqrt(cell.var);
+	}
+	cell.seen = uint(ctr.v[KRC_C_CLOCK]);
