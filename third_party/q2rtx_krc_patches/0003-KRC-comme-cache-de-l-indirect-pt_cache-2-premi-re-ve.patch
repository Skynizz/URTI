+	KrcU64 ctr = krc_ctr();
+	if (id >= uint(ctr.v[KRC_C_NVIS]))
+		return;
+	uint c = krc_vis().v[id];
+	KrcCells cells = krc_cells();
+	KrcCell cell = cells.c[c];
+	KrcU64 acc = krc_acc();
+	uint b = c * KRC_ACC;
+	float fn = float(acc.v[b + KRC_A_FN]);
+	if (fn > 0.0)
+	{
+		vec3 fm = vec3(krc_load(b + KRC_A_SUM), krc_load(b + KRC_A_SUM + 1u), krc_load(b + KRC_A_SUM + 2u)) / fn;
