+}
+
+// passe 4 : la liste libre après les insertions
+void krc_mid()
+{
+	KrcU64 ctr = krc_ctr();
+	uint64_t nf = ctr.v[KRC_C_FREE];
+	ctr.v[KRC_C_FREE] = nf - min(ctr.v[KRC_C_POP], nf);
