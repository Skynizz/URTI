@@ -112,6 +151,11 @@ vkpt_rc_clear_if_needed(VkCommandBuffer cmd_buf)
 	vkCmdFillBuffer(cmd_buf, buf_sharc_hash.buffer, 0, VK_WHOLE_SIZE, 0);
