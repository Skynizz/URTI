diff --git a/src/refresh/vkpt/path_tracer.c b/src/refresh/vkpt/path_tracer.c
index 15c63a3f..f710f0e5 100644
--- a/src/refresh/vkpt/path_tracer.c
+++ b/src/refresh/vkpt/path_tracer.c
@@ -70,8 +70,8 @@ typedef enum {
     PIPELINE_DIRECT_LIGHTING_CAUSTICS,
     PIPELINE_INDIRECT_LIGHTING_FIRST,
     PIPELINE_INDIRECT_LIGHTING_SECOND,
-	PIPELINE_CACHE_UPDATE,      // cache de radiance : chemins de mise à jour
-	PIPELINE_CACHE_RESOLVE,     // cache de radiance : résolution
+	PIPELINE_CACHE_FIRST,       // caches de radiance : une passe par valeur de spec_pass
+	PIPELINE_CACHE_LAST = PIPELINE_CACHE_FIRST + 6,
 
 	PIPELINE_COUNT
 } pipeline_index_t;
@@ -1116,6 +1116,7 @@ vkpt_pt_trace_reflections(VkCommandBuffer cmd_buf, int bounce)
 
 extern cvar_t *cvar_pt_cache;
 extern cvar_t *cvar_pt_sharc_downscale;
+extern cvar_t *cvar_pt_krc_passes;
 
 static void
 cache_barrier(VkCommandBuffer cmd_buf)
@@ -1146,15 +1147,30 @@ trace_radiance_cache(VkCommandBuffer cmd_buf)
 	push.gpu_index = -1;
 	push.bounce = 0;
 
-	uint32_t ds = (uint32_t)max(1, (int)cvar_pt_sharc_downscale->value);
-	uint32_t w = (qvk.extent_render.width + ds - 1) / ds;
-	uint32_t h = (qvk.extent_render.height + ds - 1) / ds;
-	dispatch_rays(cmd_buf, PIPELINE_CACHE_UPDATE, push, w, h, 1);
-	cache_barrier(cmd_buf);
-
-	uint32_t n = vkpt_rc_sharc_capacity();
-	dispatch_rays(cmd_buf, PIPELINE_CACHE_RESOLVE, push, 4096, n / 4096, 1);
-	cache_barrier(cmd_buf);
+	if (mode == 1)
+	{
+		// SHaRC : Update (un pixel par bloc NxN), Resolve (toutes les entrées)
+		uint32_t ds = (uint32_t)max(1, (int)cvar_pt_sharc_downscale->value);
+		uint32_t w = (qvk.extent_render.width + ds - 1) / ds;
+		uint32_t h = (qvk.extent_render.height + ds - 1) / ds;
+		dispatch_rays(cmd_buf, PIPELINE_CACHE_FIRST + 0, push, w, h, 1);
+		cache_barrier(cmd_buf);
+
+		uint32_t n = vkpt_rc_sharc_capacity();
+		dispatch_rays(cmd_buf, PIPELINE_CACHE_FIRST + 1, push, 4096, n / 4096, 1);
+		cache_barrier(cmd_buf);
+	}
+	else if (mode == 2)
+	{
+		// KRC : compteurs, cellules des pixels et chemins (Neyman), liste libre, éviction, résolution
+		uint32_t n = vkpt_rc_krc_cells();
+		int passes = (int)cvar_pt_krc_passes->value; // débogage : passes actives (bits)
+		if (passes & 1) { dispatch_rays(cmd_buf, PIPELINE_CACHE_FIRST + 2, push, 1, 1, 1); cache_barrier(cmd_buf); }
+		if (passes & 2) { dispatch_rays(cmd_buf, PIPELINE_CACHE_FIRST + 3, push, qvk.extent_render.width, qvk.extent_render.height, 1); cache_barrier(cmd_buf); }
+		if (passes & 4) { dispatch_rays(cmd_buf, PIPELINE_CACHE_FIRST + 4, push, 1, 1, 1); cache_barrier(cmd_buf); }
+		if (passes & 8) { dispatch_rays(cmd_buf, PIPELINE_CACHE_FIRST + 5, push, 4096, n / 8 / 4096, 1); cache_barrier(cmd_buf); }
+		if (passes & 16) { dispatch_rays(cmd_buf, PIPELINE_CACHE_FIRST + 6, push, 4096, n / 4096, 1); cache_barrier(cmd_buf); }
+	}
 
 	END_PERF_MARKER(cmd_buf, PROFILER_RADIANCE_CACHE);
 }
@@ -1285,6 +1301,19 @@ vkpt_pt_create_pipelines()
 		}
 	};
 
+	// passes des caches de radiance : spec_pass = 0..6
+	uint32_t cache_numbers[7] = { 0, 1, 2, 3, 4, 5, 6 };
+	VkSpecializationInfo cache_spec_info[7];
+	for (int i = 0; i < 7; i++)
+	{
+		cache_spec_info[i] = (VkSpecializationInfo) {
+			.mapEntryCount = 1,
+			.pMapEntries = &specEntry,
+			.dataSize = sizeof(uint32_t),
+			.pData = &cache_numbers[i],
+		};
+	}
+
 	uint32_t num_shader_groups = SBT_ENTRIES_PER_PIPELINE * PIPELINE_COUNT;
 	char* shader_handles = alloca(num_shader_groups * shaderGroupHandleSize);
 	memset(shader_handles, 0, num_shader_groups * shaderGroupHandleSize);
@@ -1347,15 +1376,13 @@ vkpt_pt_create_pipelines()
 			shader_stages[0].module = qvk.shader_modules[QVK_MOD_INDIRECT_LIGHTING_RGEN];
 			shader_stages[0].pSpecializationInfo = &specInfo[1];
 			break;
-		case PIPELINE_CACHE_UPDATE:
-			shader_stages[0].module = qvk.shader_modules[QVK_MOD_RADIANCE_CACHE_RGEN];
-			shader_stages[0].pSpecializationInfo = &specInfo[0];
-			break;
-		case PIPELINE_CACHE_RESOLVE:
-			shader_stages[0].module = qvk.shader_modules[QVK_MOD_RADIANCE_CACHE_RGEN];
-			shader_stages[0].pSpecializationInfo = &specInfo[1];
-			break;
 		default:
+			if (index >= PIPELINE_CACHE_FIRST && index <= PIPELINE_CACHE_LAST)
+			{
+				shader_stages[0].module = qvk.shader_modules[QVK_MOD_RADIANCE_CACHE_RGEN];
+				shader_stages[0].pSpecializationInfo = &cache_spec_info[index - PIPELINE_CACHE_FIRST];
+				break;
+			}
 			assert(!"invalid pipeline index");
 			break;
 		}
