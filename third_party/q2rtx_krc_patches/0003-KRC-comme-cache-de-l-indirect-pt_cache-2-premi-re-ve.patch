+		float fl2 = krc_load(b + KRC_A_LUM2) / fn;
+		vec3 fd = vec3(krc_load(b + KRC_A_DELTA), krc_load(b + KRC_A_DELTA + 1u), krc_load(b + KRC_A_DELTA + 2u)) / fn;
+		float var_s = max(fl2 - fl * fl, 0.0);
+
+		if (cell.n > 0.0 && global_ubo.pt_krc_delta != 0)
+		{
+			cell.mean = max(cell.mean + fd, vec3(0));
+			cell.lmean = max(cell.lmean + luminance(fd), 0.0);
+		}
