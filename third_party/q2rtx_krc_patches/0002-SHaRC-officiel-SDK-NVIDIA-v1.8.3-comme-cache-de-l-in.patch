 	GLOBAL_UBO_VAR_LIST_DO(vec4,            world_half_size_inv) \
 	\
+	GLOBAL_UBO_VAR_LIST_DO(uvec4,           rc_addr_a) /* cache de radiance : SHaRC clés (xy), accumulation (zw) */ \
+	GLOBAL_UBO_VAR_LIST_DO(uvec4,           rc_addr_b) /* SHaRC résolu (xy), capacité (z), frame (w) */ \
+	GLOBAL_UBO_VAR_LIST_DO(vec4,            rc_cam_pos_prev) \
+	\
 	GLOBAL_UBO_VAR_LIST_DO(DynLightData,    dyn_light_data[MAX_LIGHT_SOURCES]) \
 	GLOBAL_UBO_VAR_LIST_DO(vec4,            cam_pos) \
 	GLOBAL_UBO_VAR_LIST_DO(mat4,            V) \
diff --git a/src/refresh/vkpt/shader/indirect_lighting.rgen b/src/refresh/vkpt/shader/indirect_lighting.rgen
index 917f8ca2..f5b5b857 100644
--- a/src/refresh/vkpt/shader/indirect_lighting.rgen
+++ b/src/refresh/vkpt/shader/indirect_lighting.rgen
@@ -27,10 +27,13 @@ with this program; if not, write to the Free Software Foundation, Inc.,
 
 #version 460
 #extension GL_GOOGLE_include_directive    : enable
+#include "radiance_cache_ext.h"
 #pragma optionNV(unroll all)
 
 #include "path_tracer_rgen.h"
 #include "path_tracer_transparency.glsl"
+#define SHARC_QUERY 1
+#include "radiance_cache.h"
 
 layout(constant_id = 0) const uint spec_bounce_index = 0;
 
@@ -246,6 +249,7 @@ indirect_lighting(
 	Triangle triangle;
 
 	bool bounce_is_sky_light = false;
+	bool cache_hit = false;
 
 	if(!found_intersection(ray_payload_geometry)) 
 	{
@@ -340,6 +344,37 @@ indirect_lighting(
 		bounce_base_color = clamp(bounce_base_color, vec3(0), vec3(1));
 		uint bounce_cluster_idx    = triangle.cluster;
 
+		// Cache de radiance (pt_cache 1, SHaRC) : au premier rebond, si le segment dépasse le
+		// voxel (et, pour un reflet, si le cône du lobe le couvre), le chemin s'arrête sur la
+		// radiance du cache, qui remplace l'éclairage du point touché et le second rebond
+		// (règles du guide d'intégration du SDK).
+		if (cache_mode() == CACHE_SHARC && spec_bounce_index == 0)
+		{
+			SharcParameters sharc_params = sharc_parameters();
+			vec3 cache_normal = dot(bounce_direction, bounce_geo_normal) > 0 ? -bounce_geo_normal : bounce_geo_normal;
+			float voxel_size = HashGridGetVoxelSize(HashGridGetLevel(bounce_position, sharc_params.hashGridParameters), sharc_params.hashGridParameters);
+			float segment = ray_payload_geometry.hit_distance;
+			bool usable = segment > voxel_size * sqrt(3.0);
+			if (is_specular_ray)
+			{
+				float a = square(primary_roughness);
+				usable = usable && 2.0 * segment * sqrt(0.5 * a * a / max(1.0 - a * a, 1e-6)) > voxel_size;
+			}
+			SharcHitData sharc_hit;
+			sharc_hit.positionWorld = bounce_position;
+			sharc_hit.normalWorld = cache_normal;
+			sharc_hit.materialDemodulation = rc_demodulation(bounce_base_color);
+			vec3 cached_radiance;
+			if (usable && SharcGetCachedRadiance(sharc_params, sharc_hit, cached_radiance, false))
+			{
+				bounce_contrib += bounce_throughput * cached_radiance * indirect_specular_weight;
+				cache_hit = true;
+				if(spec_bounce_index < global_ubo.pt_num_bounce_rays - 1)
+					imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(0));
+			}
+		}
+
+		if (!cache_hit) {
 
 		vec3 emissive = sample_emissive_texture(triangle.material_id, bounce_minfo, tex_coord, vec2(0), vec2(0), is_specular_ray ? 2 : 3);
 		emissive *= triangle.emissive_factor;
@@ -446,11 +481,16 @@ indirect_lighting(
 			imageStore(IMG_PT_VIEW_DIRECTION2, ipos, vec4(bounce_direction, 0));
 			imageStore(IMG_PT_BOUNCE_THROUGHPUT, ipos, vec4(bounce_throughput, is_specular_ray ? 1 : 0));
 		}
+		} // !cache_hit
 	}
 
 	if (is_specular_ray)
 		bounce_contrib = demodulate_specular(primary_base_reflectivity, bounce_contrib);
 
+	// pt_cache_debug 1 : vert là où le premier rebond a lu le cache, rouge sinon
+	if (global_ubo.pt_cache_debug == 1 && spec_bounce_index == 0 && !is_specular_ray)
+		bounce_contrib = cache_hit ? vec3(0, 2, 0) : vec3(2, 0, 0);
+
 	if(spec_bounce_index > 0 && first_bounce_is_specular)
 		is_specular_ray = true;
 
diff --git a/src/refresh/vkpt/shader/radiance_cache.h b/src/refresh/vkpt/shader/radiance_cache.h
new file mode 100644
index 00000000..8fb70219
--- /dev/null
+++ b/src/refresh/vkpt/shader/radiance_cache.h
@@ -0,0 +1,66 @@
+/*
+Copyright (C) 2026, Skynizz
+Licence GPL v2 ou ultérieure (voir license.txt).
+*/
+
+// ========================================================================== //
+// Caches de radiance de l'indirect (pt_cache) : partie commune aux passes
+// du cache (radiance_cache.rgen) et à leur lecture (indirect_lighting.rgen).
+//   pt_cache 1 : SHaRC, SDK officiel de NVIDIA v1.8.3 (sharc/), réglages de
+//                l'exemple du SDK ; rien n'est modifié dans le SDK.
+// À inclure après path_tracer_rgen.h (les macros du SDK, lerp, saturate…,
+// ne doivent pas toucher le code du jeu inclus avant).
+// ========================================================================== //
+
+#ifndef RADIANCE_CACHE_H_
+#define RADIANCE_CACHE_H_
+
+#define SHARC_ENABLE_GLSL 1
+#define SHARC_MATERIAL_DEMODULATION 1   // comme l'exemple Pathtracer du SDK
+#ifndef SHARC_UPDATE
+#define SHARC_UPDATE 0
+#endif
+#ifndef SHARC_QUERY
+#define SHARC_QUERY 0
+#endif
+
+#include "sharc/SharcGlslHelpers.h"
+#include "sharc/SharcCommon.h"
+
+#define CACHE_NONE  0
+#define CACHE_SHARC 1
+#define CACHE_KRC   2
+
+int cache_mode()
+{
+	return int(global_ubo.pt_cache);
+}
+
+uint64_t rc_address(uvec2 a)
+{
+	return packUint2x32(a);
+}
+
+SharcParameters sharc_parameters()
+{
+	SharcParameters p;
+	p.hashGridParameters.cameraPosition = global_ubo.cam_pos.xyz;
+	p.hashGridParameters.logarithmBase = SHARC_GRID_LOGARITHM_BASE;
+	p.hashGridParameters.sceneScale = global_ubo.pt_sharc_scene_scale;
+	p.hashGridParameters.levelBias = SHARC_GRID_LEVEL_BIAS;
+	p.hashGridData.capacity = global_ubo.rc_addr_b.z;
+	p.hashGridData.hashEntriesBuffer = RWStructuredBuffer_uint64_t(rc_address(global_ubo.rc_addr_a.xy));
+	p.radianceScale = global_ubo.pt_sharc_radiance_scale;
+	p.accumulationBuffer = RWStructuredBuffer_SharcAccumulationData(rc_address(global_ubo.rc_addr_a.zw));
+	p.resolvedBuffer = RWStructuredBuffer_SharcPackedData(rc_address(global_ubo.rc_addr_b.xy));
+	return p;
+}
+
+// démodulation par l'albédo diffus (le cache stocke la lumière ÷ albédo ; la texture est
+// remise à la lecture)
+vec3 rc_demodulation(vec3 albedo)
+{
+	return max(albedo, vec3(0.05));
+}
+
+#endif // RADIANCE_CACHE_H_
diff --git a/src/refresh/vkpt/shader/radiance_cache.rgen b/src/refresh/vkpt/shader/radiance_cache.rgen
new file mode 100644
index 00000000..f7339164
--- /dev/null
+++ b/src/refresh/vkpt/shader/radiance_cache.rgen
@@ -0,0 +1,273 @@
+/*
+Copyright (C) 2026, Skynizz
+
+This program is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 2 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+
+// ========================================================================== //
+// Passes des caches de radiance (pt_cache), entre l'éclairage direct et les
+// rebonds de l'indirect :
+//   spec_pass 0 : mise à jour. SHaRC : un pixel tiré au hasard par bloc NxN
+//                 (pt_sharc_downscale) trace un chemin diffus depuis sa surface
+//                 primaire et nourrit le cache à chaque sommet (SharcUpdateHit) ;
+//   spec_pass 1 : résolution (SharcResolveEntry) sur toutes les entrées.
+// L'éclairage de chaque sommet est celui du jeu (get_direct_illumination,
+// get_sunlight, émission), en diffus comme les rebonds du jeu.
+// ========================================================================== //
+
+#version 460
+#extension GL_GOOGLE_include_directive    : enable
+#include "radiance_cache_ext.h"
+#pragma optionNV(unroll all)
+
+#define SHARC_UPDATE 1
+#include "path_tracer_rgen.h"
+#include "radiance_cache.h"
+
+layout(constant_id = 0) const uint spec_pass = 0;
+
+// ---------------------------------------------------------------- aléa
+uint rc_state;
+
+uint rc_hash(uint x)
+{
+	x ^= x >> 16; x *= 0x7feb352du;
+	x ^= x >> 15; x *= 0x846ca68bu;
+	x ^= x >> 16;
+	return x;
+}
+
+float rc_rand()
+{
+	rc_state = rc_state * 747796405u + 2891336453u;
+	uint w = ((rc_state >> ((rc_state >> 28u) + 4u)) ^ rc_state) * 277803737u;
+	return float((w >> 22u) ^ w) * (1.0 / 4294967296.0);
+}
+
+// ---------------------------------------------------------------- surfaces
+struct RcSurface
+{
+	vec3 position;
+	vec3 normal;       // normale géométrique, tournée vers le rayon arrivant
+	vec3 albedo;
+	vec3 emissive;
+	uint material_id;
+	uint cluster;
+	bool analytic_light; // lampe échantillonnée par l'éclairage direct : pas d'émission au rebond
+};
+
+int rc_shadow_mask()
+{
+	int mask = SHADOW_RAY_CULL_MASK;
+	if (global_ubo.first_person_model != 0)
+		mask |= AS_FLAG_VIEWER_MODELS;
+	else
+		mask |= AS_FLAG_VIEWER_WEAPON;
+	return mask;
+}
+
+int rc_bounce_mask()
+{
+	int mask = BOUNCE_RAY_CULL_MASK;
+	if (global_ubo.first_person_model != 0)
+		mask |= AS_FLAG_VIEWER_MODELS;
+	else
+		mask |= AS_FLAG_VIEWER_WEAPON;
+	return mask;
+}
+
+// lumière diffuse sortante d'un sommet : (direct + soleil) × albédo, plus son émission
+// (sauf lampe analytique, déjà comptée par l'éclairage direct du sommet précédent)
+vec3 rc_vertex_lighting(RcSurface s, vec3 view_dir, int bounce)
+{
+	rng_seed = rc_hash(rc_state ^ 0x9e3779b9u);
+	rc_rand();
+
+	vec3 diffuse, specular;
+	get_direct_illumination(
+		s.position, s.normal, s.normal, s.cluster, s.material_id, rc_shadow_mask(), view_dir,
+		s.albedo, vec3(0), 0.0, 1.0, MEDIUM_NONE, false, 0.0,
+		bounce == 0 ? global_ubo.pt_direct_polygon_lights > 0 : global_ubo.pt_indirect_polygon_lights > 0,
+		bounce == 0 ? global_ubo.pt_direct_dyn_lights > 0 : global_ubo.pt_indirect_dyn_lights > 0,
+		false, min(bounce, 1), diffuse, specular);
+
+	vec3 sun_diffuse, sun_specular;
+	get_sunlight(
+		s.cluster, s.material_id, s.position, s.normal, s.normal, view_dir,
+		vec3(0), 0.0, 1.0, MEDIUM_NONE, false, sun_diffuse, sun_specular, rc_shadow_mask());
+	float sun_scale = (bounce == 0) ? (global_ubo.pt_direct_sun_light != 0 ? 1.0 : 0.0) : global_ubo.sun_bounce_scale;
+
+	vec3 emissive = s.analytic_light ? vec3(0) : s.emissive;
+	return clamp_output(s.albedo * (diffuse + sun_diffuse * sun_scale) + emissive);
+}
+
+// surface touchée par le dernier rayon géométrique (même lecture que indirect_lighting.rgen) ;
+// renvoie false si c'est le ciel, avec sa radiance
+bool rc_hit_surface(vec3 dir, bool from_primary, out RcSurface s, out vec3 sky_radiance)
+{
+	sky_radiance = vec3(0);
+	Triangle triangle = get_hit_triangle(ray_payload_geometry);
+	bool polygonal = from_primary ? global_ubo.pt_direct_polygon_lights >= 0 : global_ubo.pt_indirect_polygon_lights >= 0;
+	bool analytic = (triangle.material_id & MATERIAL_FLAG_LIGHT) != 0 && polygonal;
+
+	if (is_sky(triangle.material_id))
+	{
+		if (!analytic)
+			sky_radiance = env_map(dir, true) * global_ubo.pt_env_scale;
+		return false;
+	}
+
+	vec3 bary = get_hit_barycentric(ray_payload_geometry);
+	vec2 tex_coord = triangle.tex_coords * bary;
+	if ((triangle.material_id & MATERIAL_FLAG_WARP) != 0)
+		tex_coord = lava_uv_warp(tex_coord, global_ubo.time);
+
+	MaterialInfo minfo = get_material_info(triangle.material_id);
+
+	s.position = triangle.positions * bary;
+	s.normal = normalize(triangle.normals * bary);
+	vec3 flat_normal = normalize(cross(
+		triangle.positions[1] - triangle.positions[0],
+		triangle.positions[2] - triangle.positions[1]));
+	if (dot(flat_normal, dir) > 0)
+		s.normal = -s.normal;
+	if (dot(dir, s.normal) > 0)
+		s.normal = -s.normal;
+
+	vec3 base_color = vec3(minfo.base_factor);
+	if (minfo.base_texture != 0)
+		base_color *= global_textureLod(minfo.base_texture, tex_coord, 2).rgb;
+	s.albedo = clamp(base_color, vec3(0), vec3(1));
+
+	vec3 emissive = sample_emissive_texture(triangle.material_id, minfo, tex_coord, vec2(0), vec2(0), 3);
+	emissive *= triangle.emissive_factor;
+	emissive += get_emissive_shell(triangle.material_id, triangle.shell) * s.albedo;
+	emissive *= sqrt(max(0, -dot(dir, s.normal))); // même profil que l'échantillonnage des lampes
+	s.emissive = emissive;
+
+	s.material_id = triangle.material_id;
+	s.cluster = triangle.cluster;
+	s.analytic_light = analytic;
+	return true;
+}
+
+// surface primaire du pixel (G-buffer) ; false si pas de surface éclairable
+bool rc_primary_surface(ivec2 ipos, out RcSurface s, out vec3 view_dir)
+{
+	vec4 position_material = texelFetch(TEX_PT_SHADING_POSITION, ipos, 0);
+	s.material_id = floatBitsToUint(position_material.w);
+	view_dir = texelFetch(TEX_PT_VIEW_DIRECTION, ipos, 0).xyz;
+	if (s.material_id == 0 || is_lava(s.material_id) || is_sky(s.material_id))
+		return false;
+
+	s.position = position_material.xyz;
+	s.normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).x);
+	if (dot(s.normal, view_dir) > 0)
+		s.normal = -s.normal;
+	vec4 base_color = texelFetch(TEX_PT_BASE_COLOR_A, ipos, 0);
+	float metallic = texelFetch(TEX_PT_METALLIC_A, ipos, 0).x;
+	vec3 base_reflectivity;
+	get_reflectivity(base_color.rgb, metallic, s.albedo, base_reflectivity);
+	s.cluster = texelFetch(TEX_PT_CLUSTER_A, ipos, 0).x;
+	if (s.cluster == 0xffff) s.cluster = ~0u; // l'image est en uint16
+	s.emissive = vec3(0); // l'émission vue par la caméra est déjà dans l'image
+	s.analytic_light = true;
+	return true;
+}
+
+// rebond diffus depuis s : direction tirée selon le cosinus, rayon géométrique
+bool rc_bounce(RcSurface s, vec3 view_dir, out vec3 dir)
+{
+	vec2 u = vec2(rc_rand(), rc_rand());
+	dir = normalize(construct_ONB_frisvad(s.normal) * sample_cos_hemisphere(u));
+
+	Ray ray;
+	ray.origin = s.position - view_dir * 0.01;
+	ray.direction = dir;
+	ray.t_min = 0;
+	ray.t_max = 10000;
+	trace_geometry_ray(ray, true, rc_bounce_mask());
+	return found_intersection(ray_payload_geometry);
+}
+
+// ---------------------------------------------------------------- SHaRC
+void sharc_update(uvec2 block)
+{
+	uint ds = uint(max(1.0, global_ubo.pt_sharc_downscale));
+	rc_state = rc_hash(block.x * 9781u + block.y * 6271u + rc_hash(global_ubo.rc_addr_b.w));
+	ivec2 ipos = ivec2(block * ds) + ivec2(min(uvec2(rc_rand() * ds, rc_rand() * ds), uvec2(ds - 1)));
+	if (ipos.x >= global_ubo.width || ipos.y >= global_ubo.height)
+		return;
+
+	RcSurface s;
+	vec3 view_dir;
+	if (!rc_primary_surface(ipos, s, view_dir))
+		return;
+
+	SharcParameters params = sharc_parameters();
+	SharcState state;
+	SharcInit(state);
+
+	int bounces = int(global_ubo.pt_cache_bounces);
+	for (int b = 0; ; b++)
+	{
+		SharcHitData hit;
+		hit.positionWorld = s.position;
+		hit.normalWorld = s.normal;
+		hit.materialDemodulation = rc_demodulation(s.albedo);
+		vec3 lighting = rc_vertex_lighting(s, view_dir, b);
+		if (!SharcUpdateHit(params, state, hit, lighting, rc_rand()))
+			break;
+		if (b >= bounces)
+			break;
+
+		vec3 dir;
+		bool found = rc_bounce(s, view_dir, dir);
+		// rebond lambertien tiré selon le cosinus : poids = albédo
+		SharcSetThroughput(state, s.albedo);
+		if (!found)
+		{
+			SharcUpdateMiss(params, state, vec3(0));
+			break;
+		}
+		vec3 sky;
+		bool from_primary = (b == 0);
+		if (!rc_hit_surface(dir, from_primary, s, sky))
+		{
+			SharcUpdateMiss(params, state, sky);
+			break;
+		}
+		view_dir = dir;
+	}
+}
+
+void sharc_resolve(uint index)
+{
+	SharcResolveParameters rp;
+	rp.cameraPositionPrev = global_ubo.rc_cam_pos_prev.xyz;
+	rp.accumulationFrameNum = uint(global_ubo.pt_sharc_accum_frames);
+	rp.responsiveFrameNum = 1;
+	rp.staleFrameNumMax = uint(global_ubo.pt_sharc_stale_frames);
+	rp.frameIndex = global_ubo.rc_addr_b.w;
+	SharcResolveEntry(index, sharc_parameters(), rp);
+}
+
+void main()
+{
+	uvec2 id = uvec2(rt_LaunchID.xy);
+	if (cache_mode() == CACHE_SHARC)
+	{
+		if (spec_pass == 0)
+			sharc_update(id);
+		else
+			sharc_resolve(id.y * 4096u + id.x);
+	}
+}
