+	UBO_CVAR_DO(pt_sharc_accum_frames, 20) /* SHaRC : fenêtre d'accumulation (réglage de l'exemple NVIDIA) */ \
+	UBO_CVAR_DO(pt_sharc_stale_frames, 64) /* SHaRC : frames sans échantillon avant éviction */ \
+	UBO_CVAR_DO(pt_sharc_downscale, 5) /* SHaRC : un pixel mis à jour par bloc NxN */ \
+	UBO_CVAR_DO(pt_sharc_radiance_scale, 1000) /* SHaRC : quantification de l'accumulation */ \
+	UBO_CVAR_DO(pt_cache_bounces, 4) /* rebonds des chemins de mise à jour du cache */ \
 	UBO_CVAR_DO(flt_antilag_hf, 1) /* A-SVGF anti-lag filter strength, [0..inf) */ \
 	UBO_CVAR_DO(flt_antilag_lf, 0.2) \
