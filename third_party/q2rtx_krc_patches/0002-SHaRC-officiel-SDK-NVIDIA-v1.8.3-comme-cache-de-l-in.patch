diff --git a/src/refresh/vkpt/radiance_cache.c b/src/refresh/vkpt/radiance_cache.c
new file mode 100644
index 00000000..261ea46b
--- /dev/null
+++ b/src/refresh/vkpt/radiance_cache.c
@@ -0,0 +1,129 @@
+/*
