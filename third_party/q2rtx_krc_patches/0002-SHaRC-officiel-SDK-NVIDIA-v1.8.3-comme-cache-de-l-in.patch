+*/
+
+// ========================================================================== //
+// Caches de radiance pour l'éclairage indirect, à comparer dans le jeu :
+//   pt_cache 0 : jeu d'origine (rebonds tracés, sans cache) ;
+//   pt_cache 1 : SHaRC, SDK officiel de NVIDIA (v1.8.3, shader/sharc/) ;
+//   pt_cache 2 : KRC.
+// Ce fichier crée les buffers des caches et passe leurs adresses au UBO ;
+// les passes (mise à jour, résolution) sont lancées par path_tracer.c.
+// ========================================================================== //
+
+#include "vkpt.h"
+
+#define SHARC_CAPACITY (1u << 22)
+
+static BufferResource_t buf_sharc_hash;     // clés 64 bits
+static BufferResource_t buf_sharc_accum;    // accumulation de la frame, 16 octets
+static BufferResource_t buf_sharc_resolved; // données résolues, 16 octets
+static bool rc_needs_clear = true;
+static float cam_pos_prev[3];
+static int last_cache_mode = -1;
+
+extern cvar_t *cvar_pt_cache;
+
+static VkResult
+create_cache_buffer(BufferResource_t *buf, size_t size, const char *name)
+{
+	VkResult res = buffer_create(buf, size,
+		VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+		VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+	if (res == VK_SUCCESS)
+		buffer_attach_name(buf, name);
+	return res;
+}
+
+VkResult
+vkpt_rc_init(void)
+{
+	_VK(create_cache_buffer(&buf_sharc_hash, (size_t)SHARC_CAPACITY * 8, "sharc hash entries"));
+	_VK(create_cache_buffer(&buf_sharc_accum, (size_t)SHARC_CAPACITY * 16, "sharc accumulation"));
+	_VK(create_cache_buffer(&buf_sharc_resolved, (size_t)SHARC_CAPACITY * 16, "sharc resolved"));
+	rc_needs_clear = true;
+	return VK_SUCCESS;
+}
+
+VkResult
+vkpt_rc_destroy(void)
+{
+	buffer_destroy(&buf_sharc_hash);
+	buffer_destroy(&buf_sharc_accum);
+	buffer_destroy(&buf_sharc_resolved);
+	return VK_SUCCESS;
+}
+
+// à appeler au changement de carte : le cache repart de zéro
+void
+vkpt_rc_reset(void)
+{
+	rc_needs_clear = true;
+}
+
+static void
+split_address(VkDeviceAddress a, uint32_t *lo, uint32_t *hi)
+{
+	*lo = (uint32_t)(a & 0xffffffffu);
+	*hi = (uint32_t)(a >> 32);
+}
+
+void
+vkpt_rc_prepare_ubo(QVKUniformBuffer_t *ubo, uint64_t frame_counter)
+{
+	split_address(buf_sharc_hash.address, &ubo->rc_addr_a[0], &ubo->rc_addr_a[1]);
+	split_address(buf_sharc_accum.address, &ubo->rc_addr_a[2], &ubo->rc_addr_a[3]);
+	split_address(buf_sharc_resolved.address, &ubo->rc_addr_b[0], &ubo->rc_addr_b[1]);
+	ubo->rc_addr_b[2] = SHARC_CAPACITY;
+	ubo->rc_addr_b[3] = (uint32_t)frame_counter;
+	ubo->rc_cam_pos_prev[0] = cam_pos_prev[0];
+	ubo->rc_cam_pos_prev[1] = cam_pos_prev[1];
+	ubo->rc_cam_pos_prev[2] = cam_pos_prev[2];
+	ubo->rc_cam_pos_prev[3] = 0;
+	memcpy(cam_pos_prev, ubo->cam_pos, sizeof(cam_pos_prev));
+
+	// changer de méthode : on repart d'un cache vide, pour une comparaison juste
+	int mode = (int)cvar_pt_cache->value;
+	if (mode != last_cache_mode)
+	{
+		rc_needs_clear = true;
+		last_cache_mode = mode;
+	}
+}
+
+// vidage des buffers (création, changement de carte ou de méthode)
+void
+vkpt_rc_clear_if_needed(VkCommandBuffer cmd_buf)
+{
+	if (!rc_needs_clear)
+		return;
+	rc_needs_clear = false;
+
+	vkCmdFillBuffer(cmd_buf, buf_sharc_hash.buffer, 0, VK_WHOLE_SIZE, 0);
+	vkCmdFillBuffer(cmd_buf, buf_sharc_accum.buffer, 0, VK_WHOLE_SIZE, 0);
+	vkCmdFillBuffer(cmd_buf, buf_sharc_resolved.buffer, 0, VK_WHOLE_SIZE, 0);
+
+	VkMemoryBarrier barrier = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+		.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+		.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+	};
+	vkCmdPipelineBarrier(cmd_buf, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+		0, 1, &barrier, 0, NULL, 0, NULL);
+}
+
+uint32_t
+vkpt_rc_sharc_capacity(void)
+{
+	return SHARC_CAPACITY;
+}
