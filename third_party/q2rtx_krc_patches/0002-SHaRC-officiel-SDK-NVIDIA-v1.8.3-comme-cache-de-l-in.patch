@@ -70,6 +70,8 @@ typedef enum {
     PIPELINE_DIRECT_LIGHTING_CAUSTICS,
     PIPELINE_INDIRECT_LIGHTING_FIRST,
     PIPELINE_INDIRECT_LIGHTING_SECOND,
+	PIPELINE_CACHE_UPDATE,      // cache de radiance : chemins de mise à jour
+	PIPELINE_CACHE_RESOLVE,     // cache de radiance : résolution
 
 	PIPELINE_COUNT
 } pipeline_index_t;
@@ -1112,6 +1114,51 @@ vkpt_pt_trace_reflections(VkCommandBuffer cmd_buf, int bounce)
 	return VK_SUCCESS;
 }
 
+extern cvar_t *cvar_pt_cache;
+extern cvar_t *cvar_pt_sharc_downscale;
+
+static void
+cache_barrier(VkCommandBuffer cmd_buf)
+{
+	VkMemoryBarrier barrier = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+		.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+		.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+	};
+	vkCmdPipelineBarrier(cmd_buf, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+		0, 1, &barrier, 0, NULL, 0, NULL);
+}
+
+// Cache de radiance (pt_cache 1 : SHaRC, 2 : KRC) : mise à jour depuis la surface primaire,
+// puis résolution, avant que les rebonds de l'indirect ne lisent le cache.
+static void
+trace_radiance_cache(VkCommandBuffer cmd_buf)
+{
+	int mode = (int)cvar_pt_cache->value;
+	if (mode <= 0)
+		return;
+
+	vkpt_rc_clear_if_needed(cmd_buf);
+
+	BEGIN_PERF_MARKER(cmd_buf, PROFILER_RADIANCE_CACHE);
+
+	pt_push_constants_t push;
+	push.gpu_index = -1;
+	push.bounce = 0;
+
+	uint32_t ds = (uint32_t)max(1, (int)cvar_pt_sharc_downscale->value);
+	uint32_t w = (qvk.extent_render.width + ds - 1) / ds;
+	uint32_t h = (qvk.extent_render.height + ds - 1) / ds;
+	dispatch_rays(cmd_buf, PIPELINE_CACHE_UPDATE, push, w, h, 1);
+	cache_barrier(cmd_buf);
+
+	uint32_t n = vkpt_rc_sharc_capacity();
+	dispatch_rays(cmd_buf, PIPELINE_CACHE_RESOLVE, push, 4096, n / 4096, 1);
+	cache_barrier(cmd_buf);
+
+	END_PERF_MARKER(cmd_buf, PROFILER_RADIANCE_CACHE);
+}
+
 VkResult
 vkpt_pt_trace_lighting(VkCommandBuffer cmd_buf, float num_bounce_rays)
 {
@@ -1147,6 +1194,8 @@ vkpt_pt_trace_lighting(VkCommandBuffer cmd_buf, float num_bounce_rays)
 		.size = VK_WHOLE_SIZE,
 	);
 
+	trace_radiance_cache(cmd_buf);
+
 	BEGIN_PERF_MARKER(cmd_buf, PROFILER_INDIRECT_LIGHTING);
 
 	assert(num_bounce_rays <= 2);
@@ -1298,6 +1347,14 @@ vkpt_pt_create_pipelines()
 			shader_stages[0].module = qvk.shader_modules[QVK_MOD_INDIRECT_LIGHTING_RGEN];
 			shader_stages[0].pSpecializationInfo = &specInfo[1];
 			break;
+		case PIPELINE_CACHE_UPDATE:
+			shader_stages[0].module = qvk.shader_modules[QVK_MOD_RADIANCE_CACHE_RGEN];
+			shader_stages[0].pSpecializationInfo = &specInfo[0];
+			break;
+		case PIPELINE_CACHE_RESOLVE:
+			shader_stages[0].module = qvk.shader_modules[QVK_MOD_RADIANCE_CACHE_RGEN];
+			shader_stages[0].pSpecializationInfo = &specInfo[1];
+			break;
 		default:
 			assert(!"invalid pipeline index");
 			break;
