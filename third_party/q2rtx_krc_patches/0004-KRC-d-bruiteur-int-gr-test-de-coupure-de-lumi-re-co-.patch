+// clé de la cellule du point p (normale n, à la distance dist de la caméra), décalée de
+// jitter (en fractions de cellule) dans le plan de la face seulement : le long de la normale,
+// la cellule est toujours celle du point, ce qui permet la reconstruction bilinéaire
+uint krc_key(vec3 p, vec3 n, float dist, vec3 jitter, out float size)
+{
+	int level = krc_level(dist, size);
+	uint axis = krc_axis(n);
+	jitter[axis] = 0.0;
+	ivec3 q = ivec3(floor(p / size + jitter));
+	return krc_key_q(q, level, krc_face(n, axis));
