 }
 
+// Débruiteur intégré (pt_krc_denoise) : indirect d'un point reconstruit à partir des 4
+// cellules voisines dans le plan de sa face (interpolation bilinéaire), chacune pondérée par sa
+// confiance (échantillons accumulés). Déterministe : pas de bruit d'un pixel ou d'une frame à
+// l'autre, donc rien à accumuler ni à filtrer ensuite ; la mise à jour dans le temps est celle
+// des cellules (chemins corrélés), sans retard ajouté.
+bool krc_smooth_indirect(vec3 p, vec3 n, out vec3 value)
+{
+	value = vec3(0);
+	float dist = length(p - global_ubo.cam_pos.xyz);
+	float size;
+	int level = krc_level(dist, size);
+	uint axis = krc_axis(n);
+	uint face = krc_face(n, axis);
+	vec3 f = p / size - 0.5;
+	ivec3 base = ivec3(floor(f));
+	vec3 t = f - vec3(base);
+	base[axis] = int(floor(p[axis] / size));
+	uint a1 = (axis + 1u) % 3u;
+	uint a2 = (axis + 2u) % 3u;
+	KrcCells cells = krc_cells();
+	float wsum = 0.0;
+	for (int j = 0; j < 2; j++)
+	{
+		for (int i = 0; i < 2; i++)
+		{
+			ivec3 q = base;
+			q[a1] += i;
+			q[a2] += j;
+			uint c = krc_find(krc_key_q(q, level, face));
+			if (c == KRC_NONE)
+				continue;
+			float cn = cells.c[c].n;
+			if (cn <= 0.0)
+				continue;
+			float w = (i == 1 ? t[a1] : 1.0 - t[a1]) * (j == 1 ? t[a2] : 1.0 - t[a2]);
+			w = max(w, 1e-3) * min(cn / 16.0, 1.0);
+			value += w * cells.c[c].mean;
+			wsum += w;
+		}
+	}
+	if (wsum <= 0.0)
+		return false;
+	value /= wsum;
